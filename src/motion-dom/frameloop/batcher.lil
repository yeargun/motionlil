import { MotionGlobalConfig } from "../../motion-utils/global-config";
import { performanceNow } from "../dom-host";
import { createRenderStep } from "./render-step";
import { stepsOrder } from "./order";
import { Batcher, FrameData, Step, Steps } from "./types";

export class RenderBatcher {
  Batcher schedule;
  func(func(FrameData)->void)->void cancel;
  FrameData state;
  Steps steps;

  init(Batcher schedule, func(func(FrameData)->void)->void cancel, FrameData state, Steps steps) {
    this.schedule = schedule;
    this.cancel = cancel;
    this.state = state;
    this.steps = steps;
  }
}

export func(func(func()->void)->void, bool)->RenderBatcher createRenderBatcher = (
  func(func()->void)->void scheduleNextBatch,
  bool allowKeepAlive
) => {
  bool runNextFrame = false;
  bool useDefaultElapsed = true;
  FrameData state = new FrameData();
  func()->void flagRunNextFrame = () => { runNextFrame = true; };
  Step[] order = [];
  func()->void processBatch = () => {
    bool useManualTiming = MotionGlobalConfig.useManualTiming == true;
    float timestamp = if (useManualTiming) { state.timestamp } else { performanceNow() };
    runNextFrame = false;
    if (!useManualTiming) {
      state.delta = if (useDefaultElapsed) { 1000.0 / 60.0 } else { (timestamp - state.timestamp).min(40.0).max(1.0) };
    }
    state.timestamp = timestamp;
    state.isProcessing = true;
    order.forEach((Step step) => step.process(state));
    state.isProcessing = false;
    if (runNextFrame && allowKeepAlive) {
      useDefaultElapsed = false;
      scheduleNextBatch(processBatch);
    }
  };
  JsValue schedule = JS.object();
  JsValue steps = JS.object();
  stepsOrder.forEach((string key) => {
    Step step = createRenderStep(flagRunNextFrame);
    order.push(step);
    steps[key] = step;
    schedule[key] = (func(FrameData)->void process, bool keepAlive, bool immediate) => {
      if (!runNextFrame) {
        runNextFrame = true;
        useDefaultElapsed = true;
        if (!state.isProcessing) {
          scheduleNextBatch(processBatch);
        }
      }
      return step.schedule(process, keepAlive, immediate);
    };
  });
  func(func(FrameData)->void)->void cancel = (func(FrameData)->void process) => {
    order.forEach((Step step) => step.cancel(process));
  };
  return new RenderBatcher(JS.assume(schedule), cancel, state, JS.assume(steps));
};
