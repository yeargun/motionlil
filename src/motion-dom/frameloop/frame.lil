import { noop } from "../../motion-utils/noop";
import { createRenderBatcher, RenderBatcher } from "./batcher";
import { Batcher, FrameData, Steps } from "./types";

extern JsValue requestAnimationFrame;

// Upstream binds the host scheduler once, at load: requestAnimationFrame when present.
RenderBatcher batcher = createRenderBatcher(
  JS.assume(if (JS.typeOf(requestAnimationFrame) != "undefined") { requestAnimationFrame } else { JS.assume(noop) }),
  true
);

export Batcher frame = batcher.schedule;
export func(func(FrameData)->void)->void cancelFrame = batcher.cancel;
export FrameData frameData = batcher.state;
export Steps frameSteps = batcher.steps;
