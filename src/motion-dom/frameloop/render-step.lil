import { FrameData, Step } from "./types";

export Step createRenderStep(func()->void runNextFrame) {
  Set<func(FrameData)->void> thisFrame = new Set<func(FrameData)->void>();
  Set<func(FrameData)->void> nextFrame = new Set<func(FrameData)->void>();
  Set<func(FrameData)->void> toKeepAlive = new Set<func(FrameData)->void>();
  bool isProcessing = false;
  bool flushNextFrame = false;
  FrameData latestFrameData = new FrameData();
  func(FrameData)->void process = (FrameData frameData) => {
    latestFrameData = frameData;
    if (isProcessing) {
      flushNextFrame = true;
      return;
    }
    isProcessing = true;
    Set<func(FrameData)->void> prevFrame = thisFrame;
    thisFrame = nextFrame;
    nextFrame = prevFrame;
    JS.invoke(thisFrame, "forEach", (func(FrameData)->void callback) => {
      if (toKeepAlive.has(callback)) {
        nextFrame.add(callback);
        runNextFrame();
      }
      callback(latestFrameData);
    });
    thisFrame.clear();
    isProcessing = false;
    if (flushNextFrame) {
      flushNextFrame = false;
      process(frameData);
    }
  };
  return new Step(
    (func(FrameData)->void callback, bool keepAlive, bool immediate) => {
      if (keepAlive) {
        toKeepAlive.add(callback);
      }
      (if (immediate && isProcessing) { thisFrame } else { nextFrame }).add(callback);
      return callback;
    },
    (func(FrameData)->void callback) => {
      nextFrame.delete(callback);
      toKeepAlive.delete(callback);
    },
    process
  );
}
