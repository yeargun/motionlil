import { createRenderBatcher, RenderBatcher } from "./batcher";
import { Batcher, FrameData } from "./types";

extern void queueMicrotask(func()->void callback);

RenderBatcher batcher = createRenderBatcher(queueMicrotask, false);

export Batcher microtask = batcher.schedule;
export func(func(FrameData)->void)->void cancelMicrotask = batcher.cancel;
