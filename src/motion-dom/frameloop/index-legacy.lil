import { cancelFrame, frame } from "./index";
import { stepsOrder } from "./order";
import { Batcher, FrameData } from "./types";

export Batcher sync = frame;

export JsValue cancelSync = JS.object();

stepsOrder.forEach((string key) => {
  cancelSync[key] = (func(FrameData)->void process) => cancelFrame(process);
});
