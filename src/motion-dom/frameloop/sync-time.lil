import { MotionGlobalConfig } from "../../motion-utils/global-config";
import { performanceNow, scheduleMicrotask } from "../dom-host";
import { frameData } from "./frame";

float? current = null;

void clearTime() {
  current = null;
}

export class TimeApi {
  func()->float now;
  func(float)->void set;

  init(func()->float now, func(float)->void set) {
    this.now = now;
    this.set = set;
  }
}

func(float)->void setTime = (float newTime) => {
  current = newTime;
  scheduleMicrotask(clearTime);
};

export TimeApi time = new TimeApi(() => {
  if (current == null) {
    setTime(if (frameData.isProcessing || MotionGlobalConfig.useManualTiming == true) { frameData.timestamp } else { performanceNow() });
  }
  float value = JS.assume(current);
  return value;
}, setTime);
