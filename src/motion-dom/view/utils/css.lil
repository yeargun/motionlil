extern JsValue document;

JsValue pendingRules = object{};
JsValue style = null;

export void cssSet(string selector, JsValue values) {
  pendingRules[selector] = values;
}

export void cssCommit() {
  if (!style.truthy()) {
    style = JS.invoke(document, "createElement", "style");
    style["id"] = "motion-view";
  }
  string cssText = "";
  for (string selector in pendingRules) {
    JsValue rule = pendingRules[selector];
    cssText += `${selector} {\n`;
    for (string property in rule) {
      cssText += `  ${property}: ${rule[property]};\n`;
    }
    cssText += "}\n";
  }
  style["textContent"] = cssText;
  JS.invoke(document["head"], "appendChild", style);
  pendingRules = object{};
}

export void cssRemove() {
  if (style.truthy() && style["parentElement"].truthy()) {
    JS.invoke(style["parentElement"], "removeChild", style);
  }
}
