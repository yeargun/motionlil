// Generated names live in their own namespace so a name we own (and must
// clean up) is told apart from an author-defined one, and a stale generated
// name left by an interrupted transition is re-owned rather than leaked.
float nameCount = 0.0;

export string generatedName() {
  return `motion-view-${nameCount++}`;
}

export void setStyle(JsValue element, string property, JsValue value) {
  JsValue style = element["style"];
  if (style.truthy()) {
    JS.invoke(style, "setProperty", property, value);
  }
}

export void removeStyle(JsValue element, string property) {
  JsValue style = element["style"];
  if (style.truthy()) {
    JS.invoke(style, "removeProperty", property);
  }
}

// Remove the names, classes and groups we set. Author names are never in
// `assigned`, so they are never touched.
export void releaseViewTransitionNames(JsValue[] assigned, JsValue[] classed, JsValue[] grouped) {
  assigned.forEach((JsValue element) => removeStyle(element, "view-transition-name"));
  classed.forEach((JsValue element) => removeStyle(element, "view-transition-class"));
  grouped.forEach((JsValue element) => removeStyle(element, "view-transition-group"));
}
