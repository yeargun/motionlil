extern JsValue document;

// The document's animations that run on a view-transition pseudo-element.
export JsValue getViewAnimations() {
  JsValue animations = JS.invoke(document, "getAnimations");
  return JS.invoke(animations, "filter", (JsValue animation) => {
    JsValue effect = animation["effect"];
    return JS.and(
      JS.and(JS.and(effect, JS.strictEqual(effect["target"], document["documentElement"])), effect["pseudoElement"]),
      JS.invoke(effect["pseudoElement"], "startsWith", "::view-transition")
    );
  });
}
