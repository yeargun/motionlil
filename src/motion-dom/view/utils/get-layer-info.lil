// The layer name and pseudo type of a view-transition pseudo-element
// selector. `group-children` before `group` so it wins.
export extern class ViewAnimationLayerInfo {
  string layer;
  string type;
}

export ViewAnimationLayerInfo? getViewAnimationLayerInfo(string pseudoElement) {
  JsValue found = JS.stringMatch(
    pseudoElement,
    new Regex("::view-transition-(old|new|group-children|group|image-pair)\\((.*?)\\)", "")
  );
  if (found.truthy()) {
    return JS.assume(object{layer: found[2], type: found[1]});
  }
  return null;
}
