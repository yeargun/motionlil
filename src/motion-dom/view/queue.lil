import { microtask } from "../frameloop/microtask";
import { FrameData } from "../frameloop/types";
import { startViewAnimation } from "./start";
import { removeItem } from "../../motion-utils/array";

JsValue[] builders = [];
JsValue current = null;

void next() {
  current = null;
  JsValue nextBuilder = builders[0];
  if (nextBuilder.truthy()) {
    start(nextBuilder);
  }
}

void start(JsValue builder) {
  removeItem(builders, builder);
  current = builder;
  // A failed transition rejects the builder; either way the queue advances.
  JsValue started = JS.invoke(startViewAnimation(builder), "then", (JsValue animation) => {
    JS.invoke(builder, "notifyReady", animation);
    return animation["finished"];
  });
  JsValue settled = JS.invoke(started, "catch", (JsValue error) => JS.invoke(builder, "notifyReject", error));
  JS.invoke(settled, "finally", next);
}

// An interrupting builder takes over every builder queued before it, batching
// their updates into its own.
void processQueue(FrameData _data) {
  for (int i = builders.length - 1; i >= 0; i--) {
    JsValue builder = builders[i];
    if (builder["options"]["interrupt"] == "immediate") {
      JsValue[] batchedUpdates = builders.slice(0, i + 1).map((JsValue b) => b["update"]);
      JsValue[] remaining = builders.slice(i + 1);
      builder["update"] = () => {
        batchedUpdates.forEach((JsValue update) => {
          JS.call(update, JS.undefined());
        });
      };
      builders = [builder, ...remaining];
      break;
    }
  }
  JsValue first = builders[0];
  if (!current.truthy() || (first.truthy() && first["options"]["interrupt"] == "immediate")) {
    next();
  }
}

export void addToQueue(JsValue builder) {
  builders.push(builder);
  microtask.render(processQueue, false, false);
}
