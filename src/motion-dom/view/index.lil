import { addToQueue } from "./queue";
import { noop } from "../../motion-utils/noop";

extern JsValue Object;
extern JsValue Promise;

// The builder `animateView` returns: a plain object whose methods close over
// its own collections.
export extern class ViewTransitionBuilder {
  JsValue currentSubject;
  JsValue targets;
}

export JsValue animateView(JsValue update, JsValue options) {
  JsValue targets = new Map<JsValue, JsValue>();
  // Definitions resolved to elements (and named) rather than pre-named layers.
  JsValue resolveDefs = new Set<JsValue>();
  // Per-subject `.crop()` override.
  JsValue cropOverride = new Map<JsValue, JsValue>();
  // Subjects paired with a different new-snapshot target.
  JsValue pairs = new Map<JsValue, JsValue>();
  JsValue classNames = new Map<JsValue, JsValue>();
  // Subjects opted out of group nesting with `.group(false)`.
  JsValue flatGroups = new Set<JsValue>();
  JsValue notifyReady = null;
  JsValue notifyReject = null;
  JsValue readyPromise = JS.construct(Promise, (JsValue resolve, JsValue reject) => {
    notifyReady = resolve;
    notifyReject = reject;
  });
  // A failed fire-and-forget transition must not surface as unhandled.
  JS.invoke(readyPromise, "catch", noop);

  JsValue builder = null;
  auto updateTarget = (string target, JsValue keyframes, JsValue targetOptions) => {
    JsValue subject = builder["currentSubject"];
    if (!JS.invoke(targets, "has", subject).truthy()) {
      JS.invoke(targets, "set", subject, object{});
    }
    JS.invoke(targets, "get", subject)[target] = object{
      keyframes: keyframes,
      options: if (JS.isUndefined(targetOptions)) { object{} } else { targetOptions }
    };
    return builder;
  };
  builder = object{
    currentSubject: "root",
    targets: targets,
    resolveDefs: resolveDefs,
    cropOverride: cropOverride,
    pairs: pairs,
    classNames: classNames,
    flatGroups: flatGroups,
    notifyReady: notifyReady,
    notifyReject: notifyReject,
    readyPromise: readyPromise,
    update: update,
    options: JS.invoke(Object, "assign", object{interrupt: "wait"}, options),
    add: (JsValue subject, JsValue newSubject) => {
      builder["currentSubject"] = subject;
      JS.invoke(resolveDefs, "add", subject);
      if (!JS.isUndefined(newSubject)) {
        JS.invoke(pairs, "set", subject, newSubject);
      }
      if (!JS.invoke(targets, "has", subject).truthy()) {
        JS.invoke(targets, "set", subject, object{});
      }
      return builder;
    },
    crop: (JsValue enabled) => {
      JS.invoke(cropOverride, "set", builder["currentSubject"], JS.or(JS.isUndefined(enabled), enabled));
      return builder;
    },
    group: (JsValue enabled) => {
      JS.invoke(flatGroups, if (JS.isUndefined(enabled) || enabled.truthy()) { "delete" } else { "add" }, builder["currentSubject"]);
      return builder;
    },
    class: (JsValue name) => {
      JS.invoke(classNames, "set", builder["currentSubject"], name);
      return builder;
    },
    layout: (JsValue layoutOptions) => updateTarget("layout", object{}, layoutOptions),
    enter: (JsValue keyframes, JsValue enterOptions) => updateTarget("enter", keyframes, enterOptions),
    exit: (JsValue keyframes, JsValue exitOptions) => updateTarget("exit", keyframes, exitOptions),
    new: (JsValue keyframes, JsValue newOptions) => updateTarget("new", keyframes, newOptions),
    old: (JsValue keyframes, JsValue oldOptions) => updateTarget("old", keyframes, oldOptions),
    updateTarget: updateTarget,
    then: (JsValue resolve, JsValue reject) => JS.invoke(readyPromise, "then", resolve, reject)
  };
  addToQueue(builder);
  return builder;
}

export { addToQueue };
