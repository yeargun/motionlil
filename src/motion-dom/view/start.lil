import { GroupAnimation } from "../animation/GroupAnimation";
import { NativeAnimation } from "../animation/NativeAnimation";
import { NativeAnimationWrapper } from "../animation/NativeAnimationWrapper";
import { getValueTransition } from "../animation/utils/get-value-transition";
import { mapEasingToNativeEasing } from "../animation/waapi/easing/map-easing";
import { supportsLinearEasing } from "../utils/supports/linear-easing";
import { cornerRadiusProps } from "../utils/border-radius";
import { resolveElements } from "../utils/resolve-elements";
import { secondsToMilliseconds } from "../../motion-utils/time-conversion";
import { warnOnce } from "../../motion-utils/warn-once";
import { generatedName, setStyle, removeStyle, releaseViewTransitionNames } from "./utils/assign-names";
import { chooseLayerType } from "./utils/choose-layer-type";
import { cssSet, cssCommit, cssRemove } from "./utils/css";
import { getViewAnimationLayerInfo, ViewAnimationLayerInfo } from "./utils/get-layer-info";
import { getViewAnimations } from "./utils/get-view-animations";

extern JsValue document;
extern JsValue Object;
extern JsValue Promise;
extern JsValue getComputedStyle(JsValue element);
extern float parseFloat(string value);

string[] definitionNames = ["layout", "enter", "exit", "new", "old"];

// The target buckets that drive each generated layer type, in priority order.
JsValue typeBuckets = object{group: ["layout"], new: ["new", "enter"], old: ["old", "exit"]};

// Default origin for a single-value keyframe, by pseudo type.
JsValue originDefaults = object{
  group: object{},
  new: object{opacity: 0, scale: 0.85},
  old: object{opacity: 1, scale: 1}
};

// Whether a computed border-radius is square (every component zero).
bool isSquareRadius(string radius) {
  return radius.split(" ").every((string value) => parseFloat(value) == 0.0);
}

// A number the transition options hold (read as JavaScript does).
float num(JsValue value) {
  return JS.assume(value);
}

// Merge a base transition with an override. An explicit override `duration`
// drops the inherited generator timing unless the override sets its own.
JsValue mergeTransition(JsValue base, JsValue override) {
  JsValue merged = JS.invoke(Object, "assign", object{}, base, override);
  if (!JS.isUndefined(override["duration"])) {
    if (JS.isUndefined(override["visualDuration"])) {
      JS.delete(merged, "visualDuration");
    }
    if (JS.isUndefined(override["type"])) {
      JS.delete(merged, "type");
    }
  }
  return merged;
}

// `applyGeneratorOptions` over a transition this module owns.
JsValue applyGeneratorOptions(JsValue options) {
  JsValue type = options["type"];
  JS.delete(options, "type");
  if (JS.typeOf(type) == "function" && JS.in("applyToOptions", type) && supportsLinearEasing()) {
    return JS.invoke(type, "applyToOptions", options);
  }
  if (JS.isNullish(options["duration"])) {
    options["duration"] = 300;
  }
  if (JS.isNullish(options["ease"])) {
    options["ease"] = "easeOut";
  }
  return options;
}

// A NativeAnimation for `options`, or (with no options) a wrapper that adopts
// a browser-generated animation and finishes with it.
JsValue nativeAnimation(JsValue options, JsValue generated) {
  if (generated.truthy()) {
    return new NativeAnimationWrapper(generated);
  }
  return new NativeAnimation(options);
}

async JsValue runUpdate(JsValue update) {
  Task<JsValue> done = JS.assume(JS.call(update, JS.undefined()));
  await done;
  return new GroupAnimation([]);
}

export JsValue startViewAnimation(JsValue builder) {
  JsValue update = builder["update"];
  JsValue targets = builder["targets"];
  JsValue resolveDefs = builder["resolveDefs"];
  JsValue cropOverride = builder["cropOverride"];
  JsValue pairs = builder["pairs"];
  JsValue classNames = builder["classNames"];
  JsValue flatGroups = builder["flatGroups"];
  JsValue defaultOptions = builder["options"];

  if (!document["startViewTransition"].truthy()) {
    return runUpdate(update);
  }

  JsValue nameRegistry = new Map<JsValue, JsValue>();
  JsValue[] assigned = [];
  JsValue[] classed = [];
  JsValue[] grouped = [];
  JsValue clipChildren = new Set<JsValue>();
  JsValue layerTargets = new Map<JsValue, JsValue>();
  JsValue croppedNames = new Set<JsValue>();
  JsValue cropForName = new Map<JsValue, JsValue>();
  JsValue layerStagger = new Map<JsValue, JsValue>();
  JsValue pairNames = new Map<JsValue, JsValue>();
  JsValue pairFrom = new Map<JsValue, JsValue>();
  JsValue cropMeasurements = new Map<JsValue, JsValue>();

  // Name one resolved element: tag its class and group, and record the name
  // of a clipping nested parent so its children are clipped too.
  auto nameElement = (JsValue element, JsValue name, JsValue className, JsValue group) => {
    JS.invoke(nameRegistry, "set", element, name);
    if (className.truthy()) {
      setStyle(element, "view-transition-class", className);
      classed.push(element);
    }
    if (group.truthy()) {
      setStyle(element, "view-transition-group", group);
      grouped.push(element);
      if (group != "none") {
        JsValue computed = getComputedStyle(element);
        if (computed["overflowX"] != "visible" || computed["overflowY"] != "visible") {
          JS.invoke(clipChildren, "add", name);
        }
      }
    }
    return name;
  };

  // Resolve a selector/Element to elements and make sure each carries a
  // `view-transition-name`. A paired morph's new end takes the old end's
  // names by index; otherwise author names are kept and the rest generated.
  auto assignNames = (JsValue definition, JsValue forcedNames, JsValue className, JsValue group) => {
    JsValue[] elements = resolveElements(definition);
    // Unless the names are forced, read every current name before assigning
    // any, so the writes do not force a style recalc per element.
    JsValue currentNames = forcedNames;
    if (!forcedNames.truthy()) {
      currentNames = JS.invoke(elements, "map", (JsValue element) => {
        if (JS.invoke(nameRegistry, "has", element).truthy()) {
          return JS.undefined();
        }
        return JS.invoke(getComputedStyle(element), "getPropertyValue", "view-transition-name");
      });
    }
    return JS.invoke(elements, "map", (JsValue element, float i) => {
      JsValue existing = JS.invoke(nameRegistry, "get", element);
      if (existing.truthy()) {
        return existing;
      }
      JsValue name = currentNames[i];
      // A paired morph's new end takes the old end's names by index (a fresh
      // one past its end); otherwise an author name is kept as-is.
      if (forcedNames.truthy() ||
        !name.truthy() ||
        name == "none" ||
        name == "auto" ||
        name == "match-element" ||
        JS.invoke(name, "startsWith", "motion-view-").truthy()) {
        if (!forcedNames.truthy() || JS.isNullish(name)) {
          name = generatedName();
        }
        setStyle(element, "view-transition-name", name);
        assigned.push(element);
      }
      return nameElement(element, name, className, group);
    });
  };

  auto resolveLayers = (string phase) => {
    JS.invoke(targets, "forEach", (JsValue target, JsValue definition) => {
      JsValue className = JS.invoke(classNames, "get", definition);
      JsValue resolved = JS.and(!JS.strictEqual(definition, "root"), JS.invoke(resolveDefs, "has", definition));
      JsValue group = JS.undefined();
      JsValue names = JS.array(definition);
      if (resolved.truthy()) {
        group = "contain";
        if (JS.invoke(flatGroups, "has", definition).truthy()) {
          group = "none";
        }
        if (!JS.invoke(pairs, "has", definition).truthy()) {
          names = assignNames(definition, null, className, group);
        } else if (phase == "old") {
          JS.invoke(pairFrom, "set", definition, resolveElements(definition));
          names = assignNames(definition, null, className, group);
          JS.invoke(pairNames, "set", definition, names);
        } else {
          // Transfer the names off the old end before the new end takes
          // them, so a surviving old element cannot collide.
          JsValue from = JS.invoke(pairFrom, "get", definition);
          if (from.truthy()) {
            JS.invoke(from, "forEach", (JsValue element) => {
              removeStyle(element, "view-transition-name");
              JS.invoke(nameRegistry, "delete", element);
            });
          }
          names = assignNames(
            JS.invoke(pairs, "get", definition),
            JS.invoke(pairNames, "get", definition),
            className,
            group
          );
        }
      }
      JsValue override = JS.invoke(cropOverride, "get", definition);
      JS.invoke(names, "forEach", (JsValue name, JsValue index) => {
        // Two subjects resolving to one element merge their definitions.
        JsValue existing = JS.invoke(layerTargets, "get", name);
        JsValue merged = target;
        if (existing.truthy() && !JS.strictEqual(existing, target)) {
          merged = JS.invoke(Object, "assign", object{}, existing, target);
        }
        JS.invoke(layerTargets, "set", name, merged);
        if (!JS.isUndefined(override)) {
          JS.invoke(cropForName, "set", name, override);
        }
        JsValue stagger = JS.or(JS.invoke(layerStagger, "get", name), object{});
        stagger[phase] = JS.array(index, names.length);
        JS.invoke(layerStagger, "set", name, stagger);
      });
    });
  };

  // A layer's stagger index and total in the snapshot it belongs to; index
  // -1 when the layer is absent from that snapshot.
  auto staggerPosition = (JsValue name, JsValue type) => {
    JsValue stagger = JS.or(JS.invoke(layerStagger, "get", name), object{});
    JsValue? position = stagger["new"];
    if (type == "old") {
      position = stagger["old"];
    } else if (type != "new") {
      position = position ?? stagger["old"];
    }
    return position ?? JS.array(-1, 1);
  };

  auto resolveLayerTransition = (JsValue target, JsValue type, string transitionName, JsValue index, JsValue total) => {
    JsValue layer = JS.or(target, object{});
    JsValue bucketOptions = JS.invoke(JS.or(typeBuckets[type], JS.array()), "map", (JsValue bucket) => JS.or(layer[bucket], object{})["options"]);
    JsValue options = JS.invoke(bucketOptions, "find", (JsValue value) => value);
    JsValue transition = mergeTransition(
      getValueTransition(defaultOptions, transitionName),
      getValueTransition(JS.or(options, object{}), transitionName)
    );
    if (JS.typeOf(transition["delay"]) == "function") {
      transition["delay"] = JS.invoke(transition, "delay", index, total);
    }
    return transition;
  };

  // A layer's group (`layout`) timing as WAAPI values, shared by the group
  // retiming and the crop corner-radius animations.
  auto resolveGroupTiming = (JsValue name) => {
    JsValue position = staggerPosition(name, "group");
    JsValue index = position[0];
    if (index == -1) {
      index = 0;
    }
    JsValue transition = resolveLayerTransition(
      JS.invoke(layerTargets, "get", name),
      "group",
      "layout",
      index,
      position[1]
    );
    if (transition["duration"].truthy()) {
      transition["duration"] = secondsToMilliseconds(num(transition["duration"]));
    }
    JsValue applied = applyGeneratorOptions(transition);
    return object{
      delay: secondsToMilliseconds(num(JS.or(applied["delay"], 0))),
      duration: applied["duration"],
      ease: applied["ease"]
    };
  };

  // Each layer's box and corner radii per snapshot.
  auto measureLayers = (string phase) => {
    JS.invoke(nameRegistry, "forEach", (JsValue name, JsValue element) => {
      JsValue rect = JS.and(element["getBoundingClientRect"], JS.invoke(element, "getBoundingClientRect"));
      if (rect.truthy() && rect["height"].truthy()) {
        JsValue computed = getComputedStyle(element);
        JsValue radii = object{};
        cornerRadiusProps.forEach((string corner) => {
          radii[corner] = computed[corner];
        });
        JsValue entry = JS.or(JS.invoke(cropMeasurements, "get", name), object{});
        entry[phase] = object{width: rect["width"], height: rect["height"], radii: radii};
        JS.invoke(cropMeasurements, "set", name, entry);
      }
    });
  };

  // Whether a layer morphs between boxes of a different aspect ratio.
  auto aspectChanged = (JsValue name) => {
    JsValue box = JS.invoke(cropMeasurements, "get", name);
    if (!box.truthy()) {
      return false;
    }
    JsValue oldBox = box["old"];
    JsValue newBox = box["new"];
    if (!oldBox.truthy() || !newBox.truthy() || !oldBox["height"].truthy() || !newBox["height"].truthy()) {
      return false;
    }
    float oldAspect = num(oldBox["width"]) / num(oldBox["height"]);
    float newAspect = num(newBox["width"]) / num(newBox["height"]);
    return (oldAspect - newAspect).abs() > 0.2;
  };

  auto commitViewCSS = () => {
    if (!JS.invoke(Object, "keys", JS.or(JS.invoke(targets, "get", "root"), object{}))["length"].truthy()) {
      cssSet(":root", object{"view-transition-name": "none"});
    }
    cssSet(
      "::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*)",
      object{"animation-timing-function": "linear !important"}
    );
    JS.invoke(croppedNames, "forEach", (JsValue name) => {
      cssSet(`::view-transition-group(${name})`, object{overflow: "clip"});
      cssSet(
        `::view-transition-old(${name}), ::view-transition-new(${name})`,
        object{width: "100%", height: "100%", "object-fit": "cover"}
      );
    });
    JS.invoke(clipChildren, "forEach", (JsValue name) => {
      cssSet(`::view-transition-group-children(${name})`, object{overflow: "clip"});
    });
    cssCommit();
  };

  auto cleanup = () => {
    releaseViewTransitionNames(assigned, classed, grouped);
    cssRemove();
  };

  JsValue transition = null;
  try {
    resolveLayers("old");
    measureLayers("old");
    commitViewCSS();
    transition = JS.invoke(document, "startViewTransition", () => {
      JsValue updated = JS.invoke(Promise, "resolve", JS.call(update, JS.undefined()));
      return JS.invoke(updated, "then", () => {
        resolveLayers("new");
        measureLayers("new");
        // With both snapshots measured, settle which layers crop: an
        // explicit `.crop()` wins, else a morph whose aspect changed.
        JS.invoke(croppedNames, "clear");
        JS.invoke(layerStagger, "forEach", (JsValue _stagger, JsValue name) => {
          JsValue? forced = JS.invoke(cropForName, "get", name);
          JsValue crop = forced ?? aspectChanged(name);
          if (!JS.strictEqual(name, "root") && crop.truthy()) {
            JS.invoke(croppedNames, "add", name);
          }
        });
        commitViewCSS();
      });
    });
  } catch (JsValue error) {
    cleanup();
    return JS.invoke(Promise, "reject", error);
  }
  JS.invoke(transition["finished"], "finally", cleanup);

  return JS.construct(Promise, (JsValue resolve, JsValue reject) => {
    JsValue ready = JS.invoke(transition["ready"], "then", () => {
      JsValue generatedViewAnimations = getViewAnimations();
      JsValue[] animations = [];
      JsValue explicitlyAnimated = new Set<JsValue>();
      JsValue opacityAnimated = new Set<JsValue>();

      JS.invoke(layerTargets, "forEach", (JsValue target, JsValue name) => {
        JsValue stagger = JS.invoke(layerStagger, "get", name);
        // `enter` only fires for a pure newcomer, `exit` for a pure leaver.
        bool enterApplies = stagger["new"].truthy() && !stagger["old"].truthy();
        bool exitApplies = stagger["old"].truthy() && !stagger["new"].truthy();
        JsValue enterKeyframes = JS.or(JS.or(target["enter"], object{})["keyframes"], object{});
        JsValue exitKeyframes = JS.or(JS.or(target["exit"], object{})["keyframes"], object{});
        definitionNames.forEach((string key) => {
          JsValue definition = target[key];
          if (!definition.truthy() || (key == "enter" && !enterApplies) || (key == "exit" && !exitApplies)) {
            return;
          }
          string type = chooseLayerType(key);
          JsValue position = staggerPosition(name, type);
          if (position[0] == -1) {
            return;
          }
          JsValue keyframes = definition["keyframes"];
          JsValue options = definition["options"];
          for (string valueName in keyframes) {
            JsValue valueKeyframes = keyframes[valueName];
            if (JS.isNullish(valueKeyframes)) {
              continue;
            }
            if (valueName == "x" || valueName == "y") {
              warnOnce(
                false,
                `animateView() animates view-transition layers with CSS properties; the "${valueName}" shorthand has no effect - use transform, e.g. { transform: "translateX(40px)" }.`
              );
              continue;
            }
            // enter/exit win over new/old on a shared property.
            if ((key == "new" && enterApplies && !JS.isNullish(enterKeyframes[valueName])) ||
              (key == "old" && exitApplies && !JS.isNullish(exitKeyframes[valueName]))) {
              continue;
            }
            JsValue valueOptions = mergeTransition(
              getValueTransition(defaultOptions, valueName),
              getValueTransition(options, valueName)
            );
            // Infer an origin for a single-value keyframe: an `enter` mirrors
            // the matching `exit` value, else the per-type default.
            if (!valueKeyframes.isArray()) {
              JsValue exitValue = if (key == "enter") { exitKeyframes[valueName] } else { JS.undefined() };
              JsValue from = JS.undefined();
              if (!JS.isNullish(exitValue)) {
                from = if (exitValue.isArray()) { exitValue[exitValue.length - 1.0] } else { exitValue };
              } else if (valueName == "opacity" || (if (type == "new") { enterApplies } else { exitApplies })) {
                from = originDefaults[type][valueName];
              }
              if (!JS.isUndefined(from)) {
                valueKeyframes = JS.array(from, valueKeyframes);
              }
            }
            if (JS.typeOf(valueOptions["delay"]) == "function") {
              valueOptions["delay"] = JS.invoke(valueOptions, "delay", position[0], position[1]);
            }
            if (valueOptions["duration"].truthy()) {
              valueOptions["duration"] = secondsToMilliseconds(num(valueOptions["duration"]));
            }
            if (valueOptions["delay"].truthy()) {
              valueOptions["delay"] = secondsToMilliseconds(num(valueOptions["delay"]));
            }
            animations.push(nativeAnimation(JS.invoke(Object, "assign", valueOptions, object{
              element: document["documentElement"],
              name: valueName,
              pseudoElement: `::view-transition-${type}(${name})`,
              keyframes: valueKeyframes
            }), null));
            JS.invoke(explicitlyAnimated, "add", `${name}:${type}`);
            if (valueName == "opacity") {
              JS.invoke(opacityAnimated, "add", `${name}:${type}`);
            }
          }
        });
      });

      // Retime (or drop) the browser-generated animations.
      JS.invoke(generatedViewAnimations, "forEach", (JsValue animation) => {
        if (animation["playState"] == "finished") {
          return;
        }
        JsValue effect = animation["effect"];
        ViewAnimationLayerInfo? info = getViewAnimationLayerInfo(JS.assume(effect["pseudoElement"]));
        if (info == null) {
          return;
        }
        string layer = info.layer;
        string type = info.type;
        // We built our own animation for this layer, so drop the generated
        // fade. Keep the `plus-lighter` blend only for a true crossfade.
        if (JS.invoke(explicitlyAnimated, "has", `${layer}:${type}`).truthy()) {
          JsValue keyframes = JS.and(
            JS.and(JS.invoke(opacityAnimated, "has", `${layer}:new`), JS.invoke(opacityAnimated, "has", `${layer}:old`)),
            JS.invoke(effect, "getKeyframes")
          );
          if (keyframes.truthy()) {
            keyframes = JS.invoke(keyframes, "some", (JsValue keyframe) => keyframe["mixBlendMode"]);
          }
          if (keyframes.truthy()) {
            animations.push(nativeAnimation(null, animation));
          } else {
            JS.invoke(animation, "cancel");
          }
          return;
        }
        // Drop the orphaned half of the default crossfade when its opposite
        // was overridden with something other than an opacity fade.
        string opposite = if (type == "old") { "new" } else { if (type == "new") { "old" } else { "" } };
        if (opposite != "" &&
          JS.invoke(explicitlyAnimated, "has", `${layer}:${opposite}`).truthy() &&
          !JS.invoke(opacityAnimated, "has", `${layer}:${opposite}`).truthy()) {
          JS.invoke(animation, "cancel");
          return;
        }
        JsValue stagger = JS.invoke(layerStagger, "get", layer);
        bool isMorphCrossfade = (type == "old" || type == "new") &&
          stagger.truthy() &&
          stagger["old"].truthy() &&
          stagger["new"].truthy();
        JsValue timing = null;
        if (type.startsWith("group")) {
          JsValue groupTiming = resolveGroupTiming(layer);
          timing = object{
            delay: groupTiming["delay"],
            duration: groupTiming["duration"],
            easing: mapEasingToNativeEasing(JS.assume(groupTiming["ease"]), JS.assume(groupTiming["duration"]))
          };
        } else {
          string timingType = if (isMorphCrossfade) { "group" } else { type };
          JsValue position = staggerPosition(layer, timingType);
          JsValue index = position[0];
          if (index == -1) {
            index = 0;
          }
          JsValue animationTransition = resolveLayerTransition(
            JS.invoke(layerTargets, "get", layer),
            timingType,
            if (timingType == "group") { "layout" } else { "" },
            index,
            position[1]
          );
          // The crossfade resolves at the spring's visual duration.
          JsValue visualDuration = animationTransition["visualDuration"];
          if (animationTransition["duration"].truthy()) {
            animationTransition["duration"] = secondsToMilliseconds(num(animationTransition["duration"]));
          }
          animationTransition = applyGeneratorOptions(animationTransition);
          timing = object{
            delay: secondsToMilliseconds(num(JS.or(animationTransition["delay"], 0))),
            duration: if (isMorphCrossfade && !JS.isUndefined(visualDuration)) {
              secondsToMilliseconds(num(visualDuration))
            } else {
              animationTransition["duration"]
            },
            easing: if (isMorphCrossfade) {
              "linear"
            } else {
              mapEasingToNativeEasing(JS.assume(animationTransition["ease"]), JS.assume(animationTransition["duration"]))
            }
          };
        }
        JS.invoke(effect, "updateTiming", timing);
        animations.push(nativeAnimation(null, animation));
      });

      // Round each cropped layer's clip: animate every corner from the old
      // element's radius to the new one's, timed as the group.
      JS.invoke(cropMeasurements, "forEach", (JsValue entry, JsValue name) => {
        if (!JS.invoke(croppedNames, "has", name).truthy()) {
          return;
        }
        JsValue groupTiming = resolveGroupTiming(name);
        JsValue oldRadii = JS.or(JS.or(entry["old"], object{})["radii"], object{});
        JsValue newRadii = JS.or(JS.or(entry["new"], object{})["radii"], object{});
        cornerRadiusProps.forEach((string corner) => {
          JsValue from = JS.or(JS.or(oldRadii[corner], newRadii[corner]), "0px");
          JsValue to = JS.or(JS.or(newRadii[corner], oldRadii[corner]), "0px");
          if (isSquareRadius(JS.assume(from)) && isSquareRadius(JS.assume(to))) {
            return;
          }
          animations.push(nativeAnimation(object{
            element: document["documentElement"],
            name: corner,
            pseudoElement: `::view-transition-group(${name})`,
            keyframes: JS.array(from, to),
            delay: groupTiming["delay"],
            duration: groupTiming["duration"],
            ease: groupTiming["ease"]
          }, null));
        });
      });

      JS.call(resolve, JS.undefined(), new GroupAnimation(animations));
    });
    JS.invoke(ready, "catch", () => JS.invoke(
      // `ready` rejects when the transition is skipped: settle with no
      // animations, unless the update itself failed.
      transition["updateCallbackDone"],
      "then",
      () => JS.call(resolve, JS.undefined(), new GroupAnimation([])),
      reject
    ));
  });
}
