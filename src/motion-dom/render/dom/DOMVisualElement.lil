import { VisualElement, VisualElementRenderer } from "../VisualElement";

export class DOMVisualElement extends VisualElement {
  init(string type, VisualElementRenderer renderer, JsValue visualOptions, JsValue options) {
    super(type, renderer, visualOptions, options);
  }
}

export void removeDOMValue(JsValue renderState, string key) {
  JS.delete(renderState["vars"], key);
  JS.delete(renderState["style"], key);
}
