import { window } from "../host-views";

export extern class MathHost {
  float atan2(float y, float x);
  float atan(float x);
  float PI;
}

export extern MathHost Math;
extern float parseFloat(JsValue value);

float radToDeg(float rad) {
  return (rad * 180.0) / Math.PI;
}

float rebaseAngle(float angle) {
  float rebased = JS.assume(JS.mod(angle, 360.0));
  return if (rebased < 0.0) { rebased + 360.0 } else { rebased };
}

float rotate(float[] v) {
  return rebaseAngle(radToDeg(Math.atan2(v[1], v[0])));
}

float scaleX(float[] v) {
  return (v[0] * v[0] + v[1] * v[1]).sqrt();
}

float scaleY(float[] v) {
  return (v[4] * v[4] + v[5] * v[5]).sqrt();
}

JsValue matrix2dParsers = object{
  x: 4.0,
  y: 5.0,
  translateX: 4.0,
  translateY: 5.0,
  scaleX: 0.0,
  scaleY: 3.0,
  scale: (float[] v) => (v[0].abs() + v[3].abs()) / 2.0,
  rotate: rotate,
  rotateZ: rotate,
  skewX: (float[] v) => radToDeg(Math.atan(v[1])),
  skewY: (float[] v) => radToDeg(Math.atan(v[2])),
  skew: (float[] v) => (v[1].abs() + v[2].abs()) / 2.0
};

JsValue matrix3dParsers = object{
  x: 12.0,
  y: 13.0,
  z: 14.0,
  translateX: 12.0,
  translateY: 13.0,
  translateZ: 14.0,
  scaleX: scaleX,
  scaleY: scaleY,
  scale: (float[] v) => (scaleX(v) + scaleY(v)) / 2.0,
  rotateX: (float[] v) => rebaseAngle(radToDeg(Math.atan2(v[6], v[5]))),
  rotateY: (float[] v) => rebaseAngle(radToDeg(Math.atan2(-v[2], v[0]))),
  rotateZ: rotate,
  rotate: rotate,
  skewX: (float[] v) => radToDeg(Math.atan(v[4])),
  skewY: (float[] v) => radToDeg(Math.atan(v[1])),
  skew: (float[] v) => (v[1].abs() + v[4].abs()) / 2.0
};

export float defaultTransformValue(string name) {
  return if (name.includes("scale")) { 1.0 } else { 0.0 };
}

export float parseValueFromTransform(string? transform, string name) {
  if (transform == null || transform == "" || transform == "none") {
    return defaultTransformValue(name);
  }
  string text = transform;
  JsValue found = JS.stringMatch(text, new Regex("^matrix3d\\(([-\\d.e\\s,]+)\\)$", "u"));
  JsValue parsers = matrix3dParsers;
  if (!found.truthy()) {
    found = JS.stringMatch(text, new Regex("^matrix\\(([-\\d.e\\s,]+)\\)$", "u"));
    parsers = matrix2dParsers;
  }
  if (!found.truthy()) {
    return defaultTransformValue(name);
  }
  JsValue valueParser = parsers[name];
  string inner = JS.assume(found[1]);
  float[] values = inner.split(",").map((string value) => parseFloat(value.trim()));
  if (JS.typeOf(valueParser) == "function") {
    func(float[])->float parse = JS.assume(valueParser);
    return parse(values);
  }
  return JS.assume(JS.get(values, JS.assume(valueParser)));
}

export float readTransformValue(JsValue instance, string name) {
  JsValue transform = JS.invoke(window, "getComputedStyle", instance)["transform"];
  return parseValueFromTransform(JS.assume(if (JS.isUndefined(transform)) { "none" } else { transform }), name);
}
