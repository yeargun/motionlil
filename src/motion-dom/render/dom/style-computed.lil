import { isCSSVar } from "./is-css-var";
import { window } from "../host-views";

export string getComputedStyle(JsValue element, string name) {
  JsValue computedStyle = JS.invoke(window, "getComputedStyle", element);
  return JS.assume(if (isCSSVar(name)) { JS.invoke(computedStyle, "getPropertyValue", name) } else { computedStyle[name] });
}
