import { DOMVisualElement, removeDOMValue } from "../dom/DOMVisualElement";
import { VisualElement, VisualElementRenderer } from "../VisualElement";
import { transformProps } from "../utils/keys-transform";
import { defaultTransformValue, readTransformValue } from "../dom/parse-transform";
import { isCSSVariableName } from "../../animation/utils/is-css-variable";
import { buildHTMLStyles } from "./utils/build-styles";
import { renderHTML } from "./utils/render";
import { scrapeMotionValuesFromProps } from "./utils/scrape-motion-values";
import { window } from "../host-views";

export JsValue getComputedStyle(JsValue element) {
  return JS.invoke(window, "getComputedStyle", element);
}

VisualElementRenderer htmlRenderer = new VisualElementRenderer(
  (VisualElement element) => {
    buildHTMLStyles(JS.get(element, "renderState"), element.latestValues, element.props["transformTemplate"]);
  },
  renderHTML,
  scrapeMotionValuesFromProps,
  (VisualElement element, JsValue instance, string key) => {
    if (transformProps.has(key)) {
      JsValue projection = JS.get(element, "projection");
      return if (JS.and(projection, projection["isProjecting"]).truthy()) {
        defaultTransformValue(key)
      } else {
        readTransformValue(instance, key)
      };
    }
    JsValue computedStyle = getComputedStyle(instance);
    JsValue value = JS.or(
      if (isCSSVariableName(key)) { JS.invoke(computedStyle, "getPropertyValue", key) } else { computedStyle[key] },
      0.0
    );
    return if (value is string) { value.trim() } else { value };
  },
  (JsValue props, string key) => {
    JsValue style = props["style"];
    return if (style.truthy()) { style[key] } else { JS.undefined() };
  },
  removeDOMValue
);

export class HTMLVisualElement extends DOMVisualElement {
  init(JsValue visualOptions, JsValue options = JS.undefined()) {
    super("html", htmlRenderer, visualOptions, options);
  }
}
