import { isMotionValue } from "../../../value/utils/is-motion-value";
import { isForcedMotionValue } from "../../utils/is-forced-motion-value";
import { VisualElement } from "../../VisualElement";

export JsValue scrapeMotionValuesFromProps(
  JsValue props,
  JsValue prevProps = JS.undefined(),
  JsValue visualElement = JS.undefined()
) {
  JsValue style = props["style"];
  JsValue prevStyle = JS.and(prevProps, prevProps["style"]);
  JsValue newValues = JS.object();
  if (!style.truthy()) {
    return newValues;
  }
  for (string key in style) {
    bool include = isMotionValue(style[key]) ||
      (prevStyle.truthy() && isMotionValue(prevStyle[key])) ||
      isForcedMotionValue(key, props);
    if (!include && visualElement.truthy()) {
      VisualElement element = JS.assume(visualElement);
      JsValue? value = element.getValue(key);
      include = value != null && !JS.isNullish(value["liveStyle"]);
    }
    if (include) {
      newValues[key] = style[key];
    }
  }
  return newValues;
}
