import { transformProps } from "../../utils/keys-transform";
import { isCSSVariableName } from "../../../animation/utils/is-css-variable";
import { buildTransform, valueAsType } from "./build-transform";

JsValue orDefault(JsValue value, JsValue fallback) {
  return if (JS.isUndefined(value)) { fallback } else { value };
}

export void buildHTMLStyles(
  JsValue state,
  JsValue latestValues,
  JsValue transformTemplate = JS.undefined()
) {
  JsValue style = state["style"];
  JsValue transformOrigin = state["transformOrigin"];
  bool hasTransform = false;
  bool hasTransformOrigin = false;
  for (string key in latestValues) {
    JsValue value = latestValues[key];
    if (transformProps.has(key)) {
      hasTransform = true;
    } else if (isCSSVariableName(key)) {
      state["vars"][key] = value;
    } else if (key.startsWith("origin")) {
      hasTransformOrigin = true;
      transformOrigin[key] = valueAsType(value, key);
    } else {
      style[key] = valueAsType(value, key);
    }
  }
  if (!latestValues["transform"].truthy()) {
    if (hasTransform || transformTemplate.truthy()) {
      style["transform"] = buildTransform(latestValues, state["transform"], transformTemplate);
    } else if (style["transform"].truthy()) {
      style["transform"] = "none";
    }
  }
  if (hasTransformOrigin) {
    style["transformOrigin"] = `${orDefault(transformOrigin["originX"], "50%")} ${orDefault(transformOrigin["originY"], "50%")} ${orDefault(transformOrigin["originZ"], 0.0)}`;
  }
}
