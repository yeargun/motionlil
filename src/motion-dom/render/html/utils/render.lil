export void renderHTML(
  JsValue element,
  JsValue renderState,
  JsValue styleProp = JS.undefined(),
  JsValue projection = JS.undefined()
) {
  JsValue elementStyle = element["style"];
  JsValue style = renderState["style"];
  for (string key in style) {
    elementStyle[key] = style[key];
  }
  if (!JS.isNullish(projection)) {
    JS.invoke(projection, "applyProjectionStyles", elementStyle, styleProp);
  }
  JsValue vars = renderState["vars"];
  for (string key in vars) {
    JS.invoke(elementStyle, "setProperty", key, vars[key]);
  }
}
