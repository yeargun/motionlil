import { getAsType } from "../../../value/types/utils/get-as-type";
import { numberValueType } from "../../../value/types/maps/number";
import { transformPropOrder } from "../../utils/keys-transform";

extern float parseFloat(JsValue v);

JsValue translateAlias = object{
  x: "translateX",
  y: "translateY",
  z: "translateZ",
  transformPerspective: "perspective"
};

// Upstream's getValueAsType: only numbers are converted to their unit type.
export JsValue valueAsType(JsValue value, string key) {
  return if (value is float) { getAsType(value, numberValueType(key)) } else { value };
}

export string buildTransform(
  JsValue latestValues,
  JsValue transform,
  JsValue transformTemplate = JS.undefined()
) {
  string transformString = "";
  bool transformIsDefault = true;
  for (string key of transformPropOrder) {
    JsValue value = latestValues[key];
    if (JS.isUndefined(value)) {
      continue;
    }
    float parsed = if (value is float) { value } else { parseFloat(JS.assume(value)) };
    bool valueIsDefault = parsed == (if (key.startsWith("scale")) { 1.0 } else { 0.0 });
    if (!valueIsDefault || transformTemplate.truthy()) {
      JsValue typed = valueAsType(value, key);
      if (!valueIsDefault) {
        transformIsDefault = false;
        transformString += `${JS.or(translateAlias[key], key)}(${typed}) `;
      }
      if (transformTemplate.truthy()) {
        transform[key] = typed;
      }
    }
  }
  JsValue pathRotation = latestValues["pathRotation"];
  if (pathRotation.truthy()) {
    transformIsDefault = false;
    transformString += `rotate(${valueAsType(pathRotation, "pathRotation")}) `;
  }
  transformString = transformString.trim();
  if (transformTemplate.truthy()) {
    func(JsValue, string)->string template = JS.assume(transformTemplate);
    return template(transform, if (transformIsDefault) { "" } else { transformString });
  }
  return if (transformIsDefault) { "none" } else { transformString };
}
