import { VisualElement, VisualElementRenderer } from "../VisualElement";

VisualElementRenderer objectRenderer = new VisualElementRenderer(
  (VisualElement element) => {
    JsValue output = JS.get(element, "renderState")["output"];
    JsValue latestValues = element.latestValues;
    for (string key in latestValues) {
      output[key] = latestValues[key];
    }
  },
  (JsValue instance, JsValue renderState, JsValue _styleProp, JsValue _projection) => {
    JsValue output = renderState["output"];
    for (string key in output) {
      instance[key] = output[key];
    }
  },
  (JsValue _props, JsValue _prevProps, JsValue _element) => JS.object(),
  (VisualElement _element, JsValue instance, string key) => {
    if (JS.in(key, instance)) {
      JsValue value = instance[key];
      if ((value is string) || (value is float)) {
        return value;
      }
    }
    return JS.undefined();
  },
  (JsValue _props, string _key) => JS.undefined(),
  (JsValue renderState, string key) => {
    JS.delete(renderState["output"], key);
  }
);

export class ObjectVisualElement extends VisualElement {
  init(JsValue visualOptions, JsValue options = JS.undefined()) {
    super("object", objectRenderer, visualOptions, options);
  }
}
