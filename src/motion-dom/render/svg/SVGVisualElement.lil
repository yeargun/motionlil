import { DOMVisualElement, removeDOMValue } from "../dom/DOMVisualElement";
import { VisualElement, VisualElementRenderer } from "../VisualElement";
import { transformProps } from "../utils/keys-transform";
import { camelToDash } from "../dom/utils/camel-to-dash";
import { getComputedStyle } from "../html/HTMLVisualElement";
import { getDefaultValueType } from "../../value/types/maps/defaults";
import { ValueType } from "../../value/types/types";
import { buildSVGAttrs, cssStyleProperties } from "./utils/build-attrs";
import { camelCaseAttributes } from "./utils/camel-case-attrs";
import { renderSVG } from "./utils/render";
import { scrapeMotionValuesFromProps } from "./utils/scrape-motion-values";
import { RHElement } from "../host-views";

VisualElementRenderer svgRenderer = new VisualElementRenderer(
  (VisualElement element) => {
    buildSVGAttrs(JS.get(element, "renderState"), element.latestValues, JS.get(element, "isSVGTag").truthy(), element.props["transformTemplate"], element.props["style"]);
  },
  renderSVG,
  scrapeMotionValuesFromProps,
  (VisualElement _element, JsValue instance, string key) => {
    if (transformProps.has(key)) {
      JsValue defaultType = JS.assume(getDefaultValueType(key));
      return if (defaultType.truthy()) { JS.or(defaultType["default"], 0.0) } else { 0.0 };
    }
    if (cssStyleProperties.includes(key)) {
      JsValue value = getComputedStyle(instance)[key];
      if (value is string) {
        if (value != "") {
          return value.trim();
        }
      }
    }
    RHElement element = JS.assume(instance);
    return element.getAttribute(if (camelCaseAttributes.has(key)) { key } else { camelToDash(key) });
  },
  (JsValue props, string key) => props[key],
  removeDOMValue
);

export class SVGVisualElement extends DOMVisualElement {
  init(JsValue visualOptions, JsValue options = JS.undefined()) {
    super("svg", svgRenderer, visualOptions, options);
  }
}
