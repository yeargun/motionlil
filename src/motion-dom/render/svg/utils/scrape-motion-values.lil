import { isMotionValue } from "../../../value/utils/is-motion-value";
import { transformPropOrder } from "../../utils/keys-transform";
import { scrapeMotionValuesFromProps as scrapeHTMLMotionValuesFromProps } from "../../html/utils/scrape-motion-values";

export JsValue scrapeMotionValuesFromProps(
  JsValue props,
  JsValue prevProps,
  JsValue visualElement = JS.undefined()
) {
  JsValue newValues = scrapeHTMLMotionValuesFromProps(props, prevProps, visualElement);
  for (string key in props) {
    if (isMotionValue(props[key]) || isMotionValue(prevProps[key])) {
      string targetKey = if (transformPropOrder.indexOf(key) != -1) {
        "attr" + key.charAt(0).toUpperCase() + key.slice(1)
      } else {
        key
      };
      newValues[targetKey] = props[key];
    }
  }
  return newValues;
}
