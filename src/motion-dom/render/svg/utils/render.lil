import { camelToDash } from "../../dom/utils/camel-to-dash";
import { renderHTML } from "../../html/utils/render";
import { camelCaseAttributes } from "./camel-case-attrs";

export void renderSVG(
  JsValue element,
  JsValue renderState,
  JsValue styleProp = JS.undefined(),
  JsValue projection = JS.undefined()
) {
  renderHTML(element, renderState, JS.undefined(), projection);
  JsValue attrs = renderState["attrs"];
  for (string key in attrs) {
    JS.invoke(element, "setAttribute", if (camelCaseAttributes.has(key)) { key } else { camelToDash(key) }, attrs[key]);
  }
}
