export void buildSVGPath(
  JsValue attrs,
  float length,
  float spacing = 1.0,
  float offset = 0.0,
  bool useDashCase = true
) {
  attrs["pathLength"] = 1.0;
  attrs[if (useDashCase) { "stroke-dashoffset" } else { "strokeDashoffset" }] = `${-offset}`;
  attrs[if (useDashCase) { "stroke-dasharray" } else { "strokeDasharray" }] = `${length} ${spacing}`;
}
