import { buildHTMLStyles } from "../../html/utils/build-styles";
import { buildSVGPath } from "./path";

export string[] cssStyleProperties = [
  "transform",
  "opacity",
  "offsetDistance",
  "offsetPath",
  "offsetRotate",
  "offsetAnchor"
];

JsValue orDefault(JsValue value, JsValue fallback) {
  return if (JS.isUndefined(value)) { fallback } else { value };
}

export void buildSVGAttrs(
  JsValue state,
  JsValue values,
  bool isSVGTag,
  JsValue transformTemplate = JS.undefined(),
  JsValue styleProp = JS.undefined()
) {
  JsValue latest = JS.object();
  for (string key in values) {
    if (key != "attrX" && key != "attrY" && key != "attrScale" && key != "pathLength" && key != "pathSpacing" && key != "pathOffset") {
      latest[key] = values[key];
    }
  }
  buildHTMLStyles(state, latest, transformTemplate);
  if (isSVGTag) {
    if (state["style"]["viewBox"].truthy()) {
      state["attrs"]["viewBox"] = state["style"]["viewBox"];
    }
    return;
  }
  JsValue attrs = state["style"];
  JsValue style = JS.object();
  state["attrs"] = attrs;
  state["style"] = style;
  for (string key of cssStyleProperties) {
    if (!JS.isUndefined(attrs[key])) {
      style[key] = attrs[key];
      JS.delete(attrs, key);
    }
  }
  if (JS.or(style["transform"], attrs["transformOrigin"]).truthy()) {
    JsValue origin = attrs["transformOrigin"];
    style["transformOrigin"] = if (JS.isNullish(origin)) { "50% 50%" } else { origin };
    JS.delete(attrs, "transformOrigin");
  }
  if (style["transform"].truthy()) {
    JsValue box = JS.and(styleProp, styleProp["transformBox"]);
    style["transformBox"] = if (JS.isNullish(box)) { "fill-box" } else { box };
    JS.delete(attrs, "transformBox");
  }
  JsValue attrX = values["attrX"];
  JsValue attrY = values["attrY"];
  JsValue attrScale = values["attrScale"];
  JsValue pathLength = values["pathLength"];
  if (!JS.isUndefined(attrX)) {
    attrs["x"] = attrX;
  }
  if (!JS.isUndefined(attrY)) {
    attrs["y"] = attrY;
  }
  if (!JS.isUndefined(attrScale)) {
    attrs["scale"] = attrScale;
  }
  if (!JS.isUndefined(pathLength)) {
    buildSVGPath(attrs, JS.assume(pathLength), JS.assume(orDefault(values["pathSpacing"], 1.0)), JS.assume(orDefault(values["pathOffset"], 0.0)), false);
  }
}
