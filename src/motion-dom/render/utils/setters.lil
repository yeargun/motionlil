import { motionValue, MotionValue } from "../../value/index";
import { VisualElement } from "../VisualElement";
import { resolveVariant } from "./resolve-dynamic-variants";
import { isKeyframesTarget } from "./is-keyframes-target";

export void setTarget(JsValue visualElement, JsValue definition) {
  VisualElement element = JS.assume(visualElement);
  JsValue resolved = JS.or(resolveVariant(visualElement, definition), JS.object());
  JsValue transitionEnd = resolved["transitionEnd"];
  JsValue target = JS.object();
  for (string key in resolved) {
    if (key != "transitionEnd" && key != "transition") {
      target[key] = resolved[key];
    }
  }
  for (string key in transitionEnd) {
    target[key] = transitionEnd[key];
  }
  for (string key in target) {
    JsValue value = target[key];
    if (isKeyframesTarget(value)) {
      int length = JS.assume(value["length"]);
      value = JS.or(value[length - 1], 0.0);
    }
    if (element.hasValue(key)) {
      MotionValue motion = JS.assume(element.getValue(key));
      motion.set(value);
    } else {
      element.addValue(key, motionValue(value));
    }
  }
}
