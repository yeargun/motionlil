import { resolveVariantFromProps } from "./resolve-variants";
import { VisualElement } from "../VisualElement";

export JsValue? resolveVariant(
  JsValue visualElement,
  JsValue? definition = null,
  JsValue? custom = null
) {
  VisualElement element = JS.assume(visualElement);
  JsValue props = element.props;
  return resolveVariantFromProps(props, definition, if (custom == null) { props["custom"] } else { custom }, visualElement);
}
