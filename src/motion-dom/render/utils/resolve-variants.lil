import { VisualElement } from "../VisualElement";
import { RHMap } from "../host-views";

JsValue callVariant(JsValue definition, JsValue props, JsValue custom, JsValue visualElement) {
  JsValue current = JS.object();
  JsValue velocity = JS.object();
  if (visualElement.truthy()) {
    RHMap values = JS.assume(visualElement["values"]);
    values.forEach((JsValue value, string key) => {
      current[key] = JS.invoke(value, "get");
      velocity[key] = JS.invoke(value, "getVelocity");
    });
  }
  func(JsValue, JsValue, JsValue)->JsValue resolve = JS.assume(definition);
  return resolve(if (JS.isUndefined(custom)) { props["custom"] } else { custom }, current, velocity);
}

export JsValue? resolveVariantFromProps(
  JsValue props,
  JsValue definition = JS.undefined(),
  JsValue custom = JS.undefined(),
  JsValue visualElement = JS.undefined()
) {
  if (JS.typeOf(definition) == "function") {
    definition = callVariant(definition, props, custom, visualElement);
  }
  if (definition is string) {
    JsValue variants = props["variants"];
    definition = JS.and(variants, variants[definition]);
  }
  if (JS.typeOf(definition) == "function") {
    definition = callVariant(definition, props, custom, visualElement);
  }
  return definition;
}
