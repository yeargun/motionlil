import { Set as SetConstructor } from "../host-views";

export string[] transformPropOrder = [
  "transformPerspective",
  "x",
  "y",
  "z",
  "translateX",
  "translateY",
  "translateZ",
  "scale",
  "scaleX",
  "scaleY",
  "rotate",
  "rotateX",
  "rotateY",
  "rotateZ",
  "skew",
  "skewX",
  "skewY"
];

export Set<string> transformProps = JS.assume(JS.construct(SetConstructor, JS.invoke(transformPropOrder, "concat", "pathRotation")));
