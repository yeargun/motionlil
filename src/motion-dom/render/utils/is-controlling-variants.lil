import { isAnimationControls } from "./is-animation-controls";
import { isVariantLabel } from "./is-variant-label";
import { variantProps } from "./variant-props";

export bool isControllingVariants(JsValue props) {
  return isAnimationControls(props["animate"]) || variantProps.some((string name) => isVariantLabel(props[name]));
}

export bool isVariantNode(JsValue props) {
  return isControllingVariants(props) || props["variants"].truthy();
}
