import { isVariantLabel } from "./is-variant-label";
import { variantProps } from "./variant-props";

// Type-only view kept for callers that build a variant tree by hand.
export class VariantVisualElement {
  bool isControllingVariants;
  VariantVisualElement? parent;
  Record<JsValue> props;

  init() {
    this.isControllingVariants = false;
    this.parent = null;
    this.props = record{};
  }
}

export JsValue getVariantContext(JsValue visualElement) {
  if (!visualElement.truthy()) {
    return JS.undefined();
  }
  JsValue props = visualElement["props"];
  if (!visualElement["isControllingVariants"].truthy()) {
    JsValue parent = visualElement["parent"];
    JsValue context = if (parent.truthy()) { JS.or(getVariantContext(parent), JS.object()) } else { JS.object() };
    if (!JS.isUndefined(props["initial"])) {
      context["initial"] = props["initial"];
    }
    return context;
  }
  JsValue context = JS.object();
  for (string name of variantProps) {
    JsValue prop = props[name];
    if (isVariantLabel(prop) || JS.strictEqual(prop, false)) {
      context[name] = prop;
    }
  }
  return context;
}
