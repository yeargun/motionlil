export bool shallowCompare(JsValue next, JsValue prev) {
  if (!prev.isArray()) {
    return false;
  }
  int prevLength = JS.assume(prev["length"]);
  if (!JS.strictEqual(next["length"], prevLength)) {
    return false;
  }
  for (int i = 0; i < prevLength; i++) {
    if (!JS.strictEqual(prev[i], next[i])) {
      return false;
    }
  }
  return true;
}
