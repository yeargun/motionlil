import { transformProps } from "./keys-transform";
import { scaleCorrectors } from "../../projection/styles/scale-correction";

export bool isForcedMotionValue(string key, JsValue options) {
  return transformProps.has(key) ||
    key.startsWith("origin") ||
    ((options["layout"].truthy() || !JS.isUndefined(options["layoutId"])) &&
      (scaleCorrectors[key].truthy() || key == "opacity"));
}
