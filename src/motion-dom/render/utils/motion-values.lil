import { motionValue, MotionValue } from "../../value/index";
import { isMotionValue } from "../../value/utils/is-motion-value";
import { VisualElement } from "../VisualElement";

export JsValue updateMotionValuesFromProps(
  JsValue visualElement,
  JsValue next,
  JsValue prev
) {
  VisualElement element = JS.assume(visualElement);
  for (string key in next) {
    JsValue nextValue = next[key];
    JsValue prevValue = prev[key];
    if (isMotionValue(nextValue)) {
      element.addValue(key, nextValue);
    } else if (isMotionValue(prevValue)) {
      element.addValue(key, motionValue(nextValue, object{owner: element}));
    } else if (!JS.strictEqual(prevValue, nextValue)) {
      if (element.hasValue(key)) {
        JsValue existing = element.getValue(key);
        MotionValue existingValue = JS.assume(existing);
        if (JS.strictEqual(existing["liveStyle"], true)) {
          existingValue.jump(nextValue);
        } else if (!existingValue.hasAnimated) {
          existingValue.set(nextValue);
        }
      } else {
        JsValue latestValue = element.getStaticValue(key);
        element.addValue(key, motionValue(if (JS.isNullish(latestValue)) { nextValue } else { latestValue }, object{owner: element}));
      }
    }
  }
  for (string key in prev) {
    if (JS.isUndefined(next[key])) {
      element.removeValue(key);
    }
  }
  return next;
}
