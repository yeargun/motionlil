import { SubscriptionManager } from "../../motion-utils/subscription-manager";
import { isNumericalString } from "../../motion-utils/is-numerical-string";
import { isZeroValueString } from "../../motion-utils/is-zero-value-string";
import { cancelFrame, frame } from "../frameloop/frame";
import { microtask } from "../frameloop/microtask";
import { time } from "../frameloop/sync-time";
import { FrameData } from "../frameloop/types";
import { createBox } from "../projection/geometry/models";
import { measureViewportBox } from "../projection/utils/measure";
import { motionValue, MotionValue } from "../value/index";
import { complex } from "../value/types/complex/index";
import { getAnimatableNone } from "../value/types/utils/animatable-none";
import { findValueType } from "../value/types/utils/find";
import { isMotionValue } from "../value/utils/is-motion-value";
import { visualElementStore } from "./store";
import { isControllingVariants, isVariantNode } from "./utils/is-controlling-variants";
import { transformProps } from "./utils/keys-transform";
import { updateMotionValuesFromProps } from "./utils/motion-values";
import {
  hasReducedMotionListener,
  initPrefersReducedMotion,
  prefersReducedMotion
} from "./utils/reduced-motion/index";
import { resolveVariantFromProps } from "./utils/resolve-variants";
import { isSVGTag } from "./svg/utils/is-svg-tag";
import { RHMap, window, Set as SetConstructor } from "./host-views";

extern float parseFloat(string v);

string[] propEventHandlers = [
  "AnimationStart",
  "AnimationComplete",
  "Update",
  "BeforeLayoutMeasure",
  "LayoutMeasure",
  "LayoutAnimationStart",
  "LayoutAnimationComplete"
];

JsValue featureDefinitions = JS.object();

export void setFeatureDefinitions(JsValue definitions) {
  featureDefinitions = definitions;
}

export JsValue getFeatureDefinitions() {
  return featureDefinitions;
}

// What upstream overrides per subclass. Each renderer is one shared object, so a build that
// never constructs an SVG or object element carries none of that renderer's code.
export class VisualElementRenderer {
  func(VisualElement)->void build;
  func(JsValue, JsValue, JsValue, JsValue)->void render;
  func(JsValue, JsValue, JsValue)->JsValue scrape;
  func(VisualElement, JsValue, string)->JsValue read;
  func(JsValue, string)->JsValue baseTarget;
  func(JsValue, string)->void removeValue;

  init(
    func(VisualElement)->void build,
    func(JsValue, JsValue, JsValue, JsValue)->void render,
    func(JsValue, JsValue, JsValue)->JsValue scrape,
    func(VisualElement, JsValue, string)->JsValue read,
    func(JsValue, string)->JsValue baseTarget,
    func(JsValue, string)->void removeValue
  ) {
    this.build = build;
    this.render = render;
    this.scrape = scrape;
    this.read = read;
    this.baseTarget = baseTarget;
    this.removeValue = removeValue;
  }
}

// One record shape for every renderer: `type` names it ("html", "svg", "object") and
// `renderer` carries its overrides. Only the members other modules read with static types are
// declared fields; the rest are set on the object as upstream's constructor sets them, so every
// construction site's literal stays small.
export class VisualElement {
  JsValue current;
  JsValue latestValues;
  JsValue props;
  JsValue options;
  JsValue? animationState;
  bool? shouldReduceMotion;

  init(string type, VisualElementRenderer renderer, JsValue visualOptions, JsValue options) {
    JsValue self = this;
    JsValue visualState = visualOptions["visualState"];
    JsValue latestValues = visualState["latestValues"];
    JsValue props = visualOptions["props"];
    JsValue parent = visualOptions["parent"];
    self["type"] = type;
    self["renderer"] = renderer;
    self["children"] = JS.construct(SetConstructor);
    self["isVariantNode"] = false;
    self["shouldSkipAnimations"] = false;
    self["values"] = new Map<string, JsValue>();
    self["features"] = JS.object();
    self["valueSubscriptions"] = new Map<string, func()->void>();
    self["prevMotionValues"] = JS.object();
    self["hasBeenMounted"] = false;
    self["events"] = JS.object();
    self["propEventSubscriptions"] = JS.object();
    self["renderScheduledAt"] = 0.0;
    // Upstream's bound `notifyUpdate` and `render`: one function each, so a
    // frame queue deduplicates them and `unmount` can cancel them.
    self["notifyUpdate"] = (FrameData _data) => {
      this.notifyUpdate();
    };
    self["render"] = (FrameData _data) => {
      this.render();
    };
    this.latestValues = latestValues;
    JsValue baseTarget = JS.object();
    JsValue initialValues = JS.object();
    for (string key in latestValues) {
      baseTarget[key] = latestValues[key];
      if (props["initial"].truthy()) {
        initialValues[key] = latestValues[key];
      }
    }
    self["baseTarget"] = baseTarget;
    self["initialValues"] = initialValues;
    self["renderState"] = visualState["renderState"];
    self["parent"] = parent;
    this.props = props;
    self["presenceContext"] = visualOptions["presenceContext"];
    self["depth"] = if (parent.truthy()) { JS.add(parent["depth"], 1.0) } else { 0.0 };
    self["reducedMotionConfig"] = visualOptions["reducedMotionConfig"];
    self["skipAnimationsConfig"] = visualOptions["skipAnimations"];
    this.options = JS.or(options, JS.object());
    self["blockInitialAnimation"] = visualOptions["blockInitialAnimation"].truthy();
    self["isControllingVariants"] = isControllingVariants(props);
    bool variantNode = isVariantNode(props);
    self["isVariantNode"] = variantNode;
    if (variantNode) {
      self["variantChildren"] = JS.construct(SetConstructor);
    }
    self["manuallyAnimateOnMount"] = JS.and(parent, parent["current"]).truthy();
    if (type == "svg") {
      self["isSVGTag"] = false;
    }
    JsValue initialMotionValues = this.scrapeMotionValuesFromProps(props, JS.object(), this);
    for (string key in initialMotionValues) {
      JsValue value = initialMotionValues[key];
      if (key != "willChange" && !JS.isUndefined(latestValues[key]) && isMotionValue(value)) {
        MotionValue motion = JS.assume(value);
        motion.set(latestValues[key]);
      }
    }
  }

  VisualElementRenderer renderer() {
    return JS.assume(JS.get(this, "renderer"));
  }

  Map<string, JsValue> values() {
    return JS.assume(JS.get(this, "values"));
  }

  Map<string, func()->void> valueSubscriptions() {
    return JS.assume(JS.get(this, "valueSubscriptions"));
  }

  JsValue scrapeMotionValuesFromProps(JsValue props, JsValue prevProps, VisualElement visualElement) {
    return this.renderer().scrape(props, prevProps, visualElement);
  }

  void mount(JsValue instance) {
    JsValue self = this;
    if (JS.strictEqual(self["type"], "svg")) {
      self["isSVGTag"] = isSVGTag(instance["tagName"]);
    }
    if (self["hasBeenMounted"].truthy()) {
      JsValue initialValues = self["initialValues"];
      for (string key in initialValues) {
        JsValue? value = this.values().get(key);
        if (value != null) {
          MotionValue motion = JS.assume(value);
          motion.jump(initialValues[key]);
        }
        this.latestValues[key] = initialValues[key];
      }
    }
    this.current = instance;
    visualElementStore.set(instance, this);
    JsValue projection = self["projection"];
    if (projection.truthy() && !projection["instance"].truthy()) {
      JS.invoke(projection, "mount", instance);
    }
    JsValue parentValue = self["parent"];
    if (parentValue.truthy() && self["isVariantNode"].truthy() && !self["isControllingVariants"].truthy()) {
      VisualElement parent = JS.assume(parentValue);
      self["removeFromVariantTree"] = parent.addVariantChild(this);
    }
    RHMap values = JS.assume(self["values"]);
    values.forEach((JsValue value, string key) => {
      this.bindToMotionValue(key, value);
    });
    JsValue reducedMotionConfig = self["reducedMotionConfig"];
    if (JS.strictEqual(reducedMotionConfig, "never")) {
      this.shouldReduceMotion = false;
    } else if (JS.strictEqual(reducedMotionConfig, "always")) {
      this.shouldReduceMotion = true;
    } else {
      if (!hasReducedMotionListener.current) {
        initPrefersReducedMotion();
      }
      this.shouldReduceMotion = prefersReducedMotion.current;
    }
    JsValue skipAnimations = self["skipAnimationsConfig"];
    self["shouldSkipAnimations"] = if (JS.isNullish(skipAnimations)) { false } else { skipAnimations };
    if (parentValue.truthy()) {
      VisualElement parent = JS.assume(parentValue);
      parent.addChild(this);
    }
    this.update(this.props, self["presenceContext"]);
    self["hasBeenMounted"] = true;
  }

  void unmount() {
    JsValue self = this;
    JsValue projection = self["projection"];
    if (projection.truthy()) {
      JS.invoke(projection, "unmount");
    }
    cancelFrame(JS.assume(self["notifyUpdate"]));
    cancelFrame(JS.assume(self["render"]));
    RHMap subscriptions = JS.assume(self["valueSubscriptions"]);
    subscriptions.forEach((func()->void remove) => {
      remove();
    });
    this.valueSubscriptions().clear();
    JsValue removeFromVariantTree = self["removeFromVariantTree"];
    if (removeFromVariantTree.truthy()) {
      func()->void remove = JS.assume(removeFromVariantTree);
      remove();
    }
    JsValue parentValue = self["parent"];
    if (parentValue.truthy()) {
      VisualElement parent = JS.assume(parentValue);
      parent.removeChild(this);
    }
    JsValue events = self["events"];
    for (string key in events) {
      SubscriptionManager manager = JS.assume(events[key]);
      manager.clear();
    }
    JsValue features = self["features"];
    for (string key in features) {
      JsValue feature = features[key];
      if (feature.truthy()) {
        JS.invoke(feature, "unmount");
        feature["isMounted"] = false;
      }
    }
    this.current = null;
  }

  void addChild(VisualElement child) {
    JsValue self = this;
    JS.invoke(self["children"], "add", child);
    if (!self["enteringChildren"].truthy()) {
      self["enteringChildren"] = JS.construct(SetConstructor);
    }
    JS.invoke(self["enteringChildren"], "add", child);
  }

  void removeChild(VisualElement child) {
    JsValue self = this;
    JS.invoke(self["children"], "delete", child);
    JsValue entering = self["enteringChildren"];
    if (entering.truthy()) {
      JS.invoke(entering, "delete", child);
    }
  }

  void bindToMotionValue(string key, JsValue value) {
    JsValue self = this;
    Map<string, func()->void> valueSubscriptions = this.valueSubscriptions();
    (func()->void)? previous = valueSubscriptions.get(key);
    if (previous != null) {
      previous();
    }
    bool valueIsTransform = transformProps.has(key);
    MotionValue motion = JS.assume(value);
    func()->void removeOnChange = motion.on("change", (JsValue? latestValue, JsValue? _b, JsValue? _c) => {
      this.latestValues[key] = latestValue;
      if (this.props["onUpdate"].truthy()) {
        frame.preRender(JS.assume(self["notifyUpdate"]), false, false);
      }
      JsValue projection = self["projection"];
      if (valueIsTransform && projection.truthy()) {
        projection["isTransformDirty"] = true;
      }
      this.scheduleRender();
    });
    JsValue removeSyncCheck = JS.undefined();
    if (JS.typeOf(window) != "undefined") {
      JsValue checkAppearSync = window["MotionCheckAppearSync"];
      if (checkAppearSync.truthy()) {
        func(VisualElement, string, JsValue)->JsValue check = JS.assume(checkAppearSync);
        removeSyncCheck = check(this, key, value);
      }
    }
    valueSubscriptions.set(key, () => {
      removeOnChange();
      if (removeSyncCheck.truthy()) {
        func()->void remove = JS.assume(removeSyncCheck);
        remove();
      }
    });
  }

  float sortNodePosition(VisualElement other) {
    JsValue self = this;
    JsValue type = self["type"];
    if (!this.current.truthy() || JS.strictEqual(type, "object") || !JS.strictEqual(type, JS.get(other, "type"))) {
      return 0.0;
    }
    int position = JS.assume(JS.invoke(this.current, "compareDocumentPosition", other.current));
    return if ((position & 2) != 0) { 1.0 } else { -1.0 };
  }

  void updateFeatures() {
    JsValue features = JS.get(this, "features");
    for (string key in featureDefinitions) {
      JsValue featureDefinition = featureDefinitions[key];
      if (!featureDefinition.truthy()) {
        continue;
      }
      JsValue FeatureConstructor = featureDefinition["Feature"];
      if (!features[key].truthy() && FeatureConstructor.truthy() && JS.invoke(featureDefinition, "isEnabled", this.props).truthy()) {
        features[key] = JS.construct(FeatureConstructor, this);
      }
      JsValue feature = features[key];
      if (feature.truthy()) {
        if (feature["isMounted"].truthy()) {
          JS.invoke(feature, "update");
        } else {
          JS.invoke(feature, "mount");
          feature["isMounted"] = true;
        }
      }
    }
  }

  void notifyUpdate() {
    this.notify("Update", this.latestValues);
  }

  void render() {
    JsValue current = this.current;
    if (!current.truthy()) {
      return;
    }
    this.triggerBuild();
    JsValue self = this;
    this.renderInstance(current, self["renderState"], this.props["style"], self["projection"]);
  }

  void renderInstance(JsValue instance, JsValue renderState, JsValue styleProp = JS.undefined(), JsValue projection = JS.undefined()) {
    this.renderer().render(instance, renderState, styleProp, projection);
  }

  void scheduleRender() {
    JsValue self = this;
    float now = time.now();
    float scheduledAt = JS.assume(self["renderScheduledAt"]);
    if (scheduledAt < now) {
      self["renderScheduledAt"] = now;
      // Immediate, as upstream: a render requested during the render step
      // runs in that step.
      frame.render(JS.assume(self["render"]), false, true);
    }
  }

  void triggerBuild() {
    this.build();
  }

  void build() {
    this.renderer().build(this);
  }

  JsValue measureViewportBox() {
    JsValue current = this.current;
    if (current.truthy() && JS.strictEqual(JS.get(this, "type"), "html")) {
      return measureViewportBox(current, this.props["transformPagePoint"]);
    }
    return createBox();
  }

  JsValue getStaticValue(string key) {
    return this.latestValues[key];
  }

  void setStaticValue(string key, JsValue value) {
    this.latestValues[key] = value;
  }

  void update(JsValue props, JsValue presenceContext = JS.undefined()) {
    JsValue self = this;
    if (JS.or(props["transformTemplate"], this.props["transformTemplate"]).truthy()) {
      this.scheduleRender();
    }
    self["prevProps"] = this.props;
    this.props = props;
    self["prevPresenceContext"] = self["presenceContext"];
    self["presenceContext"] = presenceContext;
    JsValue propEventSubscriptions = self["propEventSubscriptions"];
    for (string key of propEventHandlers) {
      JsValue existing = propEventSubscriptions[key];
      if (existing.truthy()) {
        func()->void unsubscribe = JS.assume(existing);
        unsubscribe();
        JS.delete(propEventSubscriptions, key);
      }
      JsValue listener = props["on" + key];
      if (listener.truthy()) {
        propEventSubscriptions[key] = this.on(key, JS.assume(listener));
      }
    }
    self["prevMotionValues"] = updateMotionValuesFromProps(
      this,
      this.scrapeMotionValuesFromProps(props, JS.or(self["prevProps"], JS.object()), this),
      self["prevMotionValues"]
    );
    if (!JS.strictEqual(self["type"], "object")) {
      this.handleChildMotionValue();
    }
  }

  void handleChildMotionValue() {
    JsValue self = this;
    JsValue childSubscription = self["childSubscription"];
    if (childSubscription.truthy()) {
      func()->void unsubscribe = JS.assume(childSubscription);
      unsubscribe();
      JS.delete(self, "childSubscription");
    }
    JsValue children = this.props["children"];
    if (isMotionValue(children)) {
      MotionValue motion = JS.assume(children);
      self["childSubscription"] = motion.on("change", (JsValue? latest, JsValue? _b, JsValue? _c) => {
        if (this.current.truthy()) {
          this.current["textContent"] = JS.string(latest);
        }
      });
    }
  }

  JsValue getProps() {
    return this.props;
  }

  JsValue getVariant(string name) {
    JsValue variants = this.props["variants"];
    return if (variants.truthy()) { variants[name] } else { JS.undefined() };
  }

  JsValue getDefaultTransition() {
    return this.props["transition"];
  }

  JsValue getTransformPagePoint() {
    return this.props["transformPagePoint"];
  }

  JsValue getClosestVariantNode() {
    JsValue self = this;
    if (self["isVariantNode"].truthy()) {
      return self;
    }
    JsValue parentValue = self["parent"];
    if (!parentValue.truthy()) {
      return JS.undefined();
    }
    VisualElement parent = JS.assume(parentValue);
    return parent.getClosestVariantNode();
  }

  (func()->void)? addVariantChild(VisualElement child) {
    JsValue closestVariantNode = this.getClosestVariantNode();
    if (closestVariantNode.truthy()) {
      JsValue variantChildren = closestVariantNode["variantChildren"];
      if (variantChildren.truthy()) {
        JS.invoke(variantChildren, "add", child);
      }
      return () => {
        JS.invoke(closestVariantNode["variantChildren"], "delete", child);
      };
    }
    return null;
  }

  void addValue(string key, JsValue value) {
    Map<string, JsValue> values = this.values();
    JsValue? existingValue = values.get(key);
    if (!JS.strictEqual(value, existingValue)) {
      if (existingValue != null) {
        this.removeValue(key);
      }
      this.bindToMotionValue(key, value);
      values.set(key, value);
      MotionValue motion = JS.assume(value);
      this.latestValues[key] = motion.get();
    }
  }

  void removeValue(string key) {
    this.values().delete(key);
    Map<string, func()->void> valueSubscriptions = this.valueSubscriptions();
    (func()->void)? unsubscribe = valueSubscriptions.get(key);
    if (unsubscribe != null) {
      unsubscribe();
      valueSubscriptions.delete(key);
    }
    JS.delete(this.latestValues, key);
    this.renderer().removeValue(JS.get(this, "renderState"), key);
  }

  bool hasValue(string key) {
    return this.values().has(key);
  }

  JsValue? getValue(string key, JsValue? defaultValue = null, bool hasDefault = false) {
    JsValue propValues = this.props["values"];
    if (propValues.truthy() && propValues[key].truthy()) {
      return propValues[key];
    }
    JsValue? value = this.values().get(key);
    if (value == null && hasDefault) {
      value = motionValue(defaultValue, object{owner: this});
      this.addValue(key, value);
    }
    return value;
  }

  JsValue getBaseTargetFromProps(JsValue props, string key) {
    return this.renderer().baseTarget(props, key);
  }

  JsValue readValueFromInstance(JsValue instance, string key) {
    return this.renderer().read(this, instance, key);
  }

  JsValue? readValue(string key, JsValue? target = null) {
    JsValue value = this.latestValues[key];
    JsValue current = this.current;
    if (JS.isNullish(value) && current.truthy()) {
      value = this.getBaseTargetFromProps(this.props, key);
      if (JS.isNullish(value)) {
        value = this.readValueFromInstance(current, key);
      }
    }
    if (!JS.isNullish(value)) {
      bool numerical = false;
      if (value is string) {
        numerical = isNumericalString(value) || isZeroValueString(value);
      }
      if (numerical) {
        value = parseFloat(JS.assume(value));
      } else if (findValueType(value) == null && complex.test(target)) {
        value = getAnimatableNone(key, target);
      }
      this.setBaseTarget(key, if (isMotionValue(value)) { JS.invoke(value, "get") } else { value });
    }
    return if (isMotionValue(value)) { JS.invoke(value, "get") } else { value };
  }

  void setBaseTarget(string key, JsValue value) {
    JS.get(this, "baseTarget")[key] = value;
  }

  JsValue getBaseTarget(string key) {
    JsValue self = this;
    JsValue initial = this.props["initial"];
    JsValue valueFromInitial = JS.undefined();
    if ((initial is string) || JS.typeOf(initial) == "object") {
      JsValue presence = self["presenceContext"];
      JsValue? variant = resolveVariantFromProps(this.props, initial, JS.and(presence, presence["custom"]));
      if (variant != null && variant.truthy()) {
        valueFromInitial = variant[key];
      }
    }
    if (initial.truthy() && !JS.isNullish(valueFromInitial)) {
      return valueFromInitial;
    }
    JsValue target = this.getBaseTargetFromProps(this.props, key);
    if (!JS.isNullish(target) && !isMotionValue(target)) {
      return target;
    }
    return if (!JS.isNullish(self["initialValues"][key]) && JS.isNullish(valueFromInitial)) {
      JS.undefined()
    } else {
      self["baseTarget"][key]
    };
  }

  func()->void on(string eventName, func(JsValue?, JsValue?, JsValue?)->void callback) {
    JsValue events = JS.get(this, "events");
    if (!events[eventName].truthy()) {
      events[eventName] = new SubscriptionManager();
    }
    SubscriptionManager manager = JS.assume(events[eventName]);
    return manager.add(callback);
  }

  void notify(string eventName, JsValue? arg = null) {
    JsValue manager = JS.get(this, "events")[eventName];
    if (manager.truthy()) {
      SubscriptionManager subscriptions = JS.assume(manager);
      subscriptions.notify(arg);
    }
  }

  void scheduleRenderMicrotask() {
    microtask.render((FrameData _data) => {
      this.render();
    }, false, false);
  }
}
