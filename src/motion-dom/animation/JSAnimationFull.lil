import { clamp } from "../../motion-utils/clamp";
import { millisecondsToSeconds, secondsToMilliseconds } from "../../motion-utils/time-conversion";
import { time } from "../frameloop/sync-time";
import { frameloopDriver } from "./drivers/frame";
import { DriverControls } from "./drivers/types";
import { keyframes as keyframesGenerator } from "./generators/keyframes";
import { spring } from "./generators/spring";
import { ValueGenerator as SpringGenerator, ValueAnimationState as AnimationState, valueKeyframes, numericValueGenerator, valueGeneratorDuration } from "./generators/value";
import { inertia, InertiaInput } from "./generators/inertia";
import { getMixer } from "../utils/mix/complex";
import { getFinalKeyframe } from "./keyframes/get-final";
import { motionValueOf } from "../cast";
import { KeyframesInput } from "./generators/keyframes";
import { calcGeneratorDuration } from "./generators/utils/calc-duration";
import { getGeneratorVelocity } from "./generators/utils/velocity";
import { AnimationTiming, RepeatMode, finalNumericKeyframe, readNumberUpdate } from "./timing";
import { replaceTransitionType } from "./utils/replace-transition-type-spring";
import { WithPromise } from "./utils/WithPromise";

import { isGenerator } from "./generators/utils/is-generator";
import {
  callMethod0,
  callMethod2,
  callMethod1,
  isFunction,
  invoke1,
  callFn0,
  callFn1,
  parseFloatValue,
  setProp,
  windowGet
} from "../dom-host";


JsValue springFactory = spring;
JsValue inertiaFactory = inertia;
JsValue keyframesFactory = keyframesGenerator;

float percentToProgress(float percent) {
  return percent / 100.0;
}

export class JSAnimationOptions {
  float[] keyframes;
  float velocity;
  string? type;
  float? restDelta;
  float? restSpeed;
  (func(float)->void)? onUpdate;
  JsValue? extra;

  init(
    float[] keyframes,
    float velocity = 0.0,
    string? type = null,
    float? restDelta = null,
    float? restSpeed = null,
    (func(float)->void)? onUpdate = null
  ) {
    this.keyframes = keyframes;
    this.velocity = velocity;
    this.type = type;
    this.restDelta = restDelta;
    this.restSpeed = restSpeed;
    this.onUpdate = onUpdate;
    this.extra = null;
  }
}

export class SampleResult {
  float value;
  bool done;
  init(float value, bool done = false) {
    this.value = value;
    this.done = done;
  }
}

export class JSAnimation extends WithPromise {
  JSAnimationOptions options;
  JsValue[] resolvedKeyframes;
  (func(float)->JsValue)? mixKeyframes;
  AnimationTiming timing;
  bool stopped;
  string state;
  float? startTime;
  float currentTime;
  float? holdTime;
  float playbackSpeed;
  float calculatedDuration;
  float resolvedDuration;
  float totalDuration;
  SpringGenerator? springGen;
  SpringGenerator? mirroredGen;
  DriverControls? driver;
  AnimationState delayState;

  init(JSAnimationOptions options) {
    super();
    this.options = options;
    this.resolvedKeyframes = [];
    this.mixKeyframes = null;
    this.timing = new AnimationTiming(options.extra);
    JsValue boundaryOptions = options.extra;
    if (options.onUpdate == null && boundaryOptions.truthy()) {
      JsValue callback = boundaryOptions["onUpdate"];
      options.onUpdate = readNumberUpdate(callback);
    }
    this.stopped = false;
    this.state = "idle";
    this.startTime = null;
    this.currentTime = 0.0;
    this.holdTime = null;
    this.playbackSpeed = 1.0;
    this.calculatedDuration = 0.0;
    this.resolvedDuration = 0.0;
    this.totalDuration = 0.0;
    this.springGen = null;
    this.mirroredGen = null;
    this.driver = null;
    this.delayState = new AnimationState(0.0);
    this.initAnimation();
    this.play();
    JsValue extra = options.extra;
    if (extra.truthy()) {
      JsValue autoplay = extra["autoplay"];
      if (autoplay is bool) {
        bool autoplayFlag = autoplay;
        if (autoplayFlag == false) {
          this.pause();
        }
      }
    }
    JSAnimation self = this;
    setProp(this, "attachTimeline", (JsValue timeline) => {
      return self.attachTimeline(timeline);
    });
    setProp(this, "pause", () => {
      self.pause();
    });
    setProp(this, "play", () => {
      self.play();
    });
    setProp(this, "stop", () => {
      self.stop();
    });
    setProp(this, "getPlaybackTime", () => {
      return self.getPlaybackTime();
    });
    setProp(this, "setPlaybackTime", (JsValue value) => {
      if (value is float) {
        self.setPlaybackTime(value);
      }
    });
    setProp(this, "getFinished", () => { return self.finished(); });
    setProp(this, "getState", () => { return self.state; });
    setProp(this, "getStartTime", () => { return self.startTime; });
    setProp(this, "getIterationDuration", () => { return self.getDuration() + millisecondsToSeconds(self.timing.delay); });
    setProp(this, "getDuration", () => {
      return self.getDuration();
    });
    setProp(this, "getPlaybackSpeed", () => { return self.getPlaybackSpeed(); });
    setProp(this, "setPlaybackSpeed", (JsValue value) => { if (value is float) { self.setPlaybackSpeed(value); } });
    setProp(this, "cancel", () => { self.cancel(); });
    setProp(this, "complete", () => { self.complete(); });
    self.refreshIterationDuration();
  }

  void refreshIterationDuration() {
    float delaySec = 0.0;
    JsValue extraOpts = this.options.extra;
    if (extraOpts.truthy() && extraOpts.isObject()) {
      JsValue delay = extraOpts["delay"];
      if (delay is float) {
        delaySec = millisecondsToSeconds(delay);
      }
    }
    setProp(this, "iterationDuration", this.getDuration() + delaySec);
  }

  SpringGenerator buildGenerator(JsValue[] keys, bool mirrored = false) {
    JsValue extra = this.options.extra;
    if (extra == null) { extra = record{}; this.options.extra = extra; }
    JsValue type = extra["type"];
    if (type == null) { type = this.options.type; }
    JsValue generatorOptions = record{};
    for (string key in extra) { generatorOptions[key] = extra[key]; }
    generatorOptions["keyframes"] = keys;
    if (mirrored) { generatorOptions["velocity"] = -this.options.velocity; }
    if ((type is string && type == "spring") || type == springFactory) {
      return numericValueGenerator(spring(generatorOptions));
    }
    if ((type is string && (type == "inertia" || type == "decay")) || type == inertiaFactory) {
      float[] numbers = [];
      for (int i = 0; i < keys.length; i++) {
        JsValue value = keys[i];
        if (value is float) { numbers.push(value); }
      }
      InertiaInput input = new InertiaInput(numbers);
      JsValue velocity = generatorOptions["velocity"];
      JsValue power = extra["power"];
      JsValue timeConstant = extra["timeConstant"];
      JsValue damping = extra["bounceDamping"];
      JsValue stiffness = extra["bounceStiffness"];
      JsValue min = extra["min"];
      JsValue max = extra["max"];
      JsValue restDelta = extra["restDelta"];
      JsValue restSpeed = extra["restSpeed"];
      if (velocity is float) { input.velocity = velocity; }
      if (power is float) { input.power = power; }
      if (timeConstant is float) { input.timeConstant = timeConstant; }
      if (damping is float) { input.bounceDamping = damping; }
      if (stiffness is float) { input.bounceStiffness = stiffness; }
      if (min is float) { input.min = min; }
      if (max is float) { input.max = max; }
      if (restDelta is float) { input.restDelta = restDelta; }
      if (restSpeed is float) { input.restSpeed = restSpeed; }
      JsValue modify = extra["modifyTarget"];
      if (isFunction(modify)) {
        input.modifyTarget = (float value) => {
          JsValue result = callFn1(modify, value);
          if (result is float) { return result; }
          return value;
        };
      }
      SpringGenerator gen = numericValueGenerator(inertia(input));
      gen.velocity = null;
      return gen;
    }
    if (isFunction(type) && type != keyframesFactory) {
      JsValue external = callFn1(type, generatorOptions);
      float? duration = null;
      JsValue known = external["calculatedDuration"];
      if (known is float) { duration = known; }
      AnimationState state = new AnimationState(keys[0]);
      return new SpringGenerator(duration, (float t) => {
        JsValue result = callMethod1(external, "next", t);
        state.value = result["value"];
        state.done = result["done"].truthy();
        return state;
      });
    }
    return valueKeyframes(keys, generatorOptions);
  }

  void initAnimation() {
    JsValue[] keys = [];
    JsValue extra = this.options.extra;
    if (extra == null) { extra = record{}; this.options.extra = extra; }
    JsValue suppliedKeys = extra["keyframes"];
    if (suppliedKeys.isArray()) {
      for (int i = 0; i < suppliedKeys.length.toInt(); i++) { keys.push(suppliedKeys[i]); }
    } else {
      for (int i = 0; i < this.options.keyframes.length; i++) { keys.push(this.options.keyframes[i]); }
    }
    if (keys.length == 0) { keys.push(0.0); }
    this.resolvedKeyframes = keys;
    this.mixKeyframes = null;
    JsValue type = extra["type"];
    if (type == null) { type = this.options.type; }
    bool isPhysics = (type is string && (type == "spring" || type == "inertia" || type == "decay")) || (isFunction(type) && type != keyframesFactory);
    if (isPhysics && !(keys[0] is float)) {
      auto mixerFactory = getMixer(keys[0]);
      auto mixer = mixerFactory(keys[0], keys[1]);
      this.mixKeyframes = (float percent) => mixer(percent / 100.0);
      keys = [0.0, 100.0];
    }
    this.springGen = this.buildGenerator(keys);
    this.mirroredGen = null;

    RepeatMode repeatType = this.timing.mode;
    float repeat = this.timing.repeat;
    float repeatDelay = this.timing.repeatDelay;
    if (repeatType == RepeatMode.Mirror) {
      JsValue[] mirroredKeys = [];
      for (int i = keys.length - 1; i >= 0; i--) {
        mirroredKeys.push(keys[i]);
      }
      this.mirroredGen = this.buildGenerator(mirroredKeys, true);
    }

    SpringGenerator? gen = this.springGen;
    if (gen != null) {
      float? knownDuration = gen.calculatedDuration;
      if (knownDuration != null) {
        this.calculatedDuration = knownDuration;
      } else {
        this.calculatedDuration = valueGeneratorDuration(gen);
        gen.calculatedDuration = this.calculatedDuration;
      }
      this.resolvedDuration = this.calculatedDuration + repeatDelay;
      this.totalDuration = this.resolvedDuration * (repeat + 1.0) - repeatDelay;
    }
  }

  AnimationState sample(float sampleTime) {
    this.startTime = 0.0;
    return this.tick(sampleTime, true);
  }

  void updateTime(float timestamp) {
    float start = 0.0;
    float? startOpt = this.startTime;
    if (startOpt != null) { start = startOpt; }
    float animationTime = (timestamp - start).round() * this.playbackSpeed;
    float? held = this.holdTime;
    if (held != null) { this.currentTime = held; }
    else { this.currentTime = animationTime; }
  }

  AnimationState tick(float timestamp, bool sample = false) {
    float? startOpt = this.startTime;
    if (startOpt == null) {
      SpringGenerator? gen = this.springGen;
      if (gen != null) { return gen.next(0.0); }
      return this.delayState;
    }
    float start = startOpt;
    if (this.playbackSpeed > 0.0) { this.startTime = start; if (timestamp < start) { this.startTime = timestamp; } }
    else if (this.playbackSpeed < 0.0) {
      float latestStart = timestamp - this.totalDuration / this.playbackSpeed;
      this.startTime = start; if (latestStart < start) { this.startTime = latestStart; }
    }
    if (sample) { this.currentTime = timestamp; }
    else { this.updateTime(timestamp); }
    float direction = 1.0; if (this.playbackSpeed < 0.0) { direction = -1.0; }
    float timeWithoutDelay = this.currentTime - this.timing.delay * direction;
    bool isInDelayPhase = timeWithoutDelay < 0.0; if (this.playbackSpeed < 0.0) { isInDelayPhase = timeWithoutDelay > this.totalDuration; }
    this.currentTime = 0.0; if (timeWithoutDelay > 0.0) { this.currentTime = timeWithoutDelay; }
    bool forcedComplete = this.state == "finished" && this.holdTime == null;
    if (forcedComplete) { this.currentTime = this.totalDuration; }

    float repeat = this.timing.repeat;
    float repeatDelay = this.timing.repeatDelay;
    RepeatMode repeatType = this.timing.mode;

    float elapsed = this.currentTime;
    SpringGenerator? activeGenerator = this.springGen;
    if (repeat > 0.0 && this.resolvedDuration > 0.0) {
      float repeatTime = this.currentTime;
      if (repeatTime > this.totalDuration) {
        repeatTime = this.totalDuration;
      }
      float overallProgress = repeatTime / this.resolvedDuration;
      int currentIteration = overallProgress.toInt();
      float iterationProgress = overallProgress - currentIteration;
      if (iterationProgress == 0.0 && overallProgress >= 1.0) {
        iterationProgress = 1.0;
        currentIteration = currentIteration - 1;
      }
      if (currentIteration % 2 == 1) {
        if (repeatType == RepeatMode.Reverse) {
          iterationProgress = 1.0 - iterationProgress;
          if (repeatDelay > 0.0) {
            iterationProgress = iterationProgress - repeatDelay / this.resolvedDuration;
          }
        } else if (repeatType == RepeatMode.Mirror) {
          SpringGenerator? mirrored = this.mirroredGen;
          if (mirrored != null) {
            activeGenerator = mirrored;
          }
        }
      }
      elapsed = clamp(0.0, 1.0, iterationProgress) * this.resolvedDuration;
    }

    AnimationState result = this.delayState;
    if (isInDelayPhase) {
      result.value = this.resolvedKeyframes[0];
      result.done = false;
    } else if (activeGenerator != null) {
      result = activeGenerator.next(elapsed);
      (func(float)->JsValue)? mix = this.mixKeyframes;
      JsValue value = result.value;
      if (mix != null && value is float) { result.value = mix(value); }
    }
    bool done = result.done;
    if (!isInDelayPhase) {
      done = this.currentTime >= this.totalDuration; if (this.playbackSpeed < 0.0) { done = this.currentTime <= 0.0; }
    }
    bool finished = this.holdTime == null && (forcedComplete || (this.state == "running" && done));
    JsValue extra = this.options.extra;
    JsValue type = extra["type"];
    if (finished && type != inertiaFactory && !(type is string && (type == "inertia" || type == "decay"))) {
      result.value = getFinalKeyframe(this.resolvedKeyframes, extra, extra["finalKeyframe"], this.playbackSpeed);
    }
    JsValue onUpdate = extra["onUpdate"];
    if (isFunction(onUpdate)) { callFn1(onUpdate, result.value); }
    else {
      (func(float)->void)? numericUpdate = this.options.onUpdate;
      JsValue value = result.value;
      if (numericUpdate != null && value is float) { numericUpdate(value); }
    }
    if (finished) { this.finish(); }
    return result;
  }

  void play() {
    if (this.stopped) { return; }
    JSAnimation self = this;
    if (this.driver == null) {
      this.driver = frameloopDriver((float timestamp) => { self.tick(timestamp); });
    }
    JsValue extra = this.options.extra;
    JsValue onPlay = extra["onPlay"];
    if (isFunction(onPlay)) { callFn0(onPlay); }
    DriverControls? driver = this.driver;
    if (driver == null) { return; }
    float now = driver.now();
    bool wasFinished = this.state == "finished";
    float? held = this.holdTime;
    if (wasFinished) {
      this.updateFinished();
      this.startTime = now;
    } else if (held != null) { this.startTime = now - held; }
    else if (this.startTime == null || this.startTime == 0.0) {
      JsValue start = extra["startTime"];
      if (start is float) { this.startTime = start; }
      else { this.startTime = now; }
    }
    if (wasFinished && this.playbackSpeed < 0.0) {
      float? start = this.startTime;
      if (start != null) { this.startTime = start + this.calculatedDuration; }
    }
    this.holdTime = null;
    this.state = "running";
    driver.start(true);
  }

  void pause() {
    this.state = "paused";
    this.updateTime(time.now());
    this.holdTime = this.currentTime;
  }

  void stop() {
    JsValue stopOptions = this.options.extra;
    JsValue motionValue = stopOptions["motionValue"];
    if (motionValue.truthy() && motionValueOf(motionValue).updatedAt != time.now()) { this.tick(time.now()); }
    if (this.state == "idle") {
      this.stopped = true;
      return;
    }
    this.stopped = true;
    this.teardown();
    JsValue extra = this.options.extra;
    if (extra.truthy()) {
      JsValue os = extra["onStop"];
      if (isFunction(os)) {
        callFn0(os);
      }
    }
  }

  void complete() {
    if (this.state != "running") {
      this.play();
    }
    this.state = "finished";
    this.holdTime = null;
  }

  void finish() {
    this.notifyFinished();
    this.teardown();
    this.state = "finished";
    JsValue extra = this.options.extra;
    if (extra.truthy()) {
      JsValue oc = extra["onComplete"];
      if (isFunction(oc)) {
        callFn0(oc);
      }
    }
  }

  void cancel() {
    this.holdTime = null;
    this.startTime = 0.0;
    this.tick(0.0);
    this.teardown();
    JsValue extra = this.options.extra;
    if (extra.truthy()) {
      JsValue oc = extra["onCancel"];
      if (isFunction(oc)) {
        callFn0(oc);
      }
    }
  }

  void teardown() {
    this.state = "idle";
    this.stopDriver();
    this.startTime = null;
    this.holdTime = null;
  }

  void stopDriver() {
    DriverControls? driver = this.driver;
    if (driver != null) {
      driver.stop();
      this.driver = null;
    }
  }

  float getDuration() {
    return millisecondsToSeconds(this.calculatedDuration);
  }

  float getPlaybackTime() {
    return millisecondsToSeconds(this.currentTime);
  }

  void setPlaybackTime(float newTimeSeconds) {
    float newTime = secondsToMilliseconds(newTimeSeconds);
    this.currentTime = newTime;
    if (this.startTime == null || this.holdTime != null || this.playbackSpeed == 0.0) {
      this.holdTime = newTime;
    } else {
      DriverControls? driver = this.driver;
      if (driver != null) {
        float now = driver.now();
        this.startTime = now - newTime / this.playbackSpeed;
      }
    }
    DriverControls? driverOpt = this.driver;
    if (driverOpt != null) {
      driverOpt.start(false);
    } else {
      this.startTime = 0.0;
      this.state = "paused";
      this.holdTime = newTime;
      this.tick(newTime);
    }
  }

  float getPlaybackSpeed() {
    return this.playbackSpeed;
  }

  void setPlaybackSpeed(float newSpeed) {
    bool hasChanged = this.playbackSpeed != newSpeed;
    if (hasChanged && this.driver != null) { this.updateTime(time.now()); }
    this.playbackSpeed = newSpeed;
    if (hasChanged) {
      DriverControls? driverOpt = this.driver;
      if (driverOpt != null) {
        this.setPlaybackTime(millisecondsToSeconds(this.currentTime));
      }
    }
  }

  float getGeneratorVelocity() {
    if (this.currentTime <= 0.0) { return this.options.velocity; }
    SpringGenerator? gen = this.springGen;
    if (gen != null) {
      (func(float)->float)? velocity = gen.velocity;
      if (velocity != null) { return velocity(this.currentTime); }
      JsValue current = gen.next(this.currentTime).value;
      if (current is float) {
        return getGeneratorVelocity((float t) => {
          JsValue value = gen.next(t).value;
          if (value is float) { return value; }
          return 0.0;
        }, this.currentTime, current);
      }
    }
    return this.options.velocity;
  }

  func()->void attachTimeline(JsValue timeline) {
    JsValue extra = this.options.extra;
    if (extra.truthy()) {
      JsValue allowFlatten = extra["allowFlatten"];
      if (allowFlatten is bool) {
        bool flatten = allowFlatten;
        if (flatten) {
          extra["type"] = "keyframes";
          extra["ease"] = "linear";
          this.options.extra = extra;
          this.initAnimation();
          this.refreshIterationDuration();
        }
      }
    }
    this.stopDriver();
    this.refreshIterationDuration();
    if (timeline.isObject()) {
      JsValue observe = timeline["observe"];
      if (isFunction(observe)) {
        JsValue cancel = callFn1(observe, this);
        return () => {
          if (isFunction(cancel)) {
            callFn0(cancel);
          }
        };
      }
    }
    if (isFunction(timeline)) {
      JsValue cancel = callFn1(timeline, this);
      return () => {
        if (isFunction(cancel)) {
          callFn0(cancel);
        }
      };
    }
    return () => {};
  }

}
