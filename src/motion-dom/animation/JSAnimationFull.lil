import { JSAnimation, createJSAnimation, jsAnimationVelocity, stopJSAnimation } from "./JSAnimation";

// Typed options for callers that build a JSAnimation field by field.
export class JSAnimationOptionsFull {
  float[] keyframes;
  float velocity;
  string? type;
  float? restDelta;
  float? restSpeed;
  (func(float)->void)? onUpdate;

  init(
    float[] keyframes,
    float velocity = 0.0,
    string? type = null,
    float? restDelta = null,
    float? restSpeed = null,
    (func(float)->void)? onUpdate = null
  ) {
    this.keyframes = keyframes;
    this.velocity = velocity;
    this.type = type;
    this.restDelta = restDelta;
    this.restSpeed = restSpeed;
    this.onUpdate = onUpdate;
  }
}

// A typed handle on a JSAnimation built from typed options.
export class JSAnimationFull {
  JSAnimation animation;

  init(JSAnimationOptionsFull options) {
    this.animation = createJSAnimation(options);
  }

  void stop() {
    stopJSAnimation(this.animation);
  }

  float getGeneratorVelocity() {
    return jsAnimationVelocity(this.animation);
  }

  Task<bool> then(func()->void onResolve, (func()->void)? onReject = null) {
    return this.animation.then(onResolve, onReject);
  }
}
