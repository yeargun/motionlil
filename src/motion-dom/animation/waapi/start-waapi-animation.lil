import { mapEasingToNativeEasing } from "./easing/map-easing";

extern class AnimWaapiTransition {
  JsValue? delay;
  JsValue? duration;
  JsValue? repeat;
  JsValue repeatType;
  JsValue? ease;
  JsValue times;
}

export JsValue startWaapiAnimation(
  JsValue element,
  string valueName,
  JsValue keyframes,
  JsValue transitionValue,
  JsValue pseudoElement
) {
  AnimWaapiTransition transition = JS.assume(JS.or(transitionValue, JS.object()));
  float duration = JS.assume(transition.duration ?? 300.0);
  float repeat = JS.assume(transition.repeat ?? 0.0);
  JsValue keyframeOptions = JS.object();
  keyframeOptions[valueName] = keyframes;
  if (transition.times.truthy()) {
    keyframeOptions["offset"] = transition.times;
  }
  JsValue easing = mapEasingToNativeEasing(transition.ease ?? "easeOut", duration);
  if (easing.isArray()) {
    keyframeOptions["easing"] = easing;
  }
  JsValue options = JS.object(
    "delay", transition.delay ?? 0.0,
    "duration", duration,
    "easing", if (easing.isArray()) { "linear" } else { easing },
    "fill", "both",
    "iterations", repeat + 1.0,
    "direction", if (JS.strictEqual(transition.repeatType, "reverse")) { "alternate" } else { "normal" }
  );
  if (pseudoElement.truthy()) {
    options["pseudoElement"] = pseudoElement;
  }
  return JS.invoke(element, "animate", keyframeOptions, options);
}
