import { isBezierDefinition } from "../../../../motion-utils/easing/utils/is-bezier-definition";
import { supportsLinearEasing } from "../../../utils/supports/linear-easing";
import { generateLinearEasing } from "../utils/linear";
import { cubicBezierAsString } from "./cubic-bezier";
import { supportedWaapiEasing } from "./supported";

export string mapEasingFunctionToNativeEasing(func(float)->float easing, float duration) {
  return if (supportsLinearEasing()) { generateLinearEasing(easing, duration, 10.0) } else { "ease-out" };
}

// Returns the native easing: a string, or an array of strings for an easing array.
export string? mapEasingToNativeEasing(JsValue easing, float duration) {
  if (!easing.truthy()) {
    return JS.assume(JS.undefined());
  }
  if (JS.typeOf(easing) == "function") {
    return mapEasingFunctionToNativeEasing(JS.assume(easing), duration);
  }
  if (isBezierDefinition(easing)) {
    return cubicBezierAsString(easing);
  }
  if (easing.isArray()) {
    return JS.assume(JS.invoke(easing, "map", (JsValue segment) =>
      JS.or(mapEasingToNativeEasing(segment, duration), supportedWaapiEasing.easeOut)
    ));
  }
  return JS.assume(JS.get(supportedWaapiEasing, JS.assume(easing)));
}

export { mapEasingToNativeEasing as mapEasingArrayToNativeEasing };
