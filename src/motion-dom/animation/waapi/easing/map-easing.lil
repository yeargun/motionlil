import { isBezierDefinition } from "../../../../motion-utils/easing/utils/is-bezier-definition";
import { supportsLinearEasing } from "../../../utils/supports/linear-easing";
import { generateLinearEasing } from "../utils/linear";
import { cubicBezierAsString } from "./cubic-bezier";
import { supportedWaapiEasing } from "./supported";
import { isFunction } from "../../../dom-host";
import extern { identity as easingFunction } from "../../../cast-host.ts";

extern func(float)->float easingFunction(JsValue value);

// Read the public easing union without discarding function or segment entries.
export JsValue mapPublicEasingToNative(JsValue easing, float duration) {
  if (!easing.truthy()) { return null; }
  if (isFunction(easing)) {
    return mapEasingFunctionToNativeEasing(easingFunction(easing), duration);
  }
  if (easing.isArray()) {
    if (easing[0] is float) {
      float[] points = [];
      for (int i = 0; i < easing.length.toInt(); i++) {
        JsValue point = easing[i];
        if (point is float) { points.push(point); }
      }
      return cubicBezierAsString(points);
    }
    JsValue[] segments = [];
    for (int i = 0; i < easing.length.toInt(); i++) {
      JsValue native = mapPublicEasingToNative(easing[i], duration);
      if (!native.truthy()) { native = supportedWaapiEasing.easeOut; }
      segments.push(native);
    }
    return segments;
  }
  if (easing is string) { return supportedWaapiEasing.get(easing); }
  return null;
}

export string mapEasingFunctionToNativeEasing(
  func(float)->float easing,
  float duration
) {
  if (supportsLinearEasing()) {
    return generateLinearEasing(easing, duration);
  }
  return "ease-out";
}

export string? mapEasingToNativeEasing(
  (string | float[] | func(float)->float)? easing,
  float duration
) {
  if (easing == null) {
    return null;
  }
  if (easing is (func(float)->float)) {
    return mapEasingFunctionToNativeEasing(easing, duration);
  }
  if (easing is float[]) {
    return cubicBezierAsString(easing);
  }
  if (easing is string) {
    return supportedWaapiEasing.get(easing);
  }
  return null;
}

export string[] mapEasingArrayToNativeEasing(
  (string | float[] | func(float)->float)[] easing,
  float duration
) {
  string[] mapped = [];
  for (int i = 0; i < easing.length; i++) {
    string | float[] | func(float)->float segment = easing[i];
    string? native = mapEasingToNativeEasing(segment, duration);
    if (native != null) {
      mapped.push(native);
    } else {
      mapped.push(supportedWaapiEasing.easeOut);
    }
  }
  return mapped;
}
