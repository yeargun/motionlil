import { isBezierDefinition } from "../../../../motion-utils/easing/utils/is-bezier-definition";
import { supportsLinearEasing } from "../../../utils/supports/linear-easing";
import { supportedWaapiEasing } from "./supported";

export bool isWaapiSupportedEasing(JsValue easing) {
  return (JS.typeOf(easing) == "function" && supportsLinearEasing()) ||
    !easing.truthy() ||
    (easing is string && (JS.in(easing, supportedWaapiEasing) || supportsLinearEasing())) ||
    isBezierDefinition(easing) ||
    (easing.isArray() && JS.invoke(easing, "every", isWaapiSupportedEasing).truthy());
}
