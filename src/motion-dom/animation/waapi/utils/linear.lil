export string generateLinearEasing(
  func(float)->float easing,
  float duration,
  float resolution = 10.0
) {
  string points = "";
  float numPoints = (duration / resolution).round().max(2.0);
  for (float i = 0.0; i < numPoints; i++) {
    points += (easing(i / (numPoints - 1.0)) * 10000.0).round() / 10000.0 + ", ";
  }
  return `linear(${points.slice(0, points.length - 2)})`;
}
