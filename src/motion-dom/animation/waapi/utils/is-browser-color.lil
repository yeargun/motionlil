Regex browserColorFunctions = new Regex(
  "^(?:oklch|oklab|lab|lch|color|color-mix|light-dark)\\(",
  ""
);

export bool hasBrowserOnlyColors(JsValue keyframes) {
  for (float i = 0.0; i < keyframes.length; i++) {
    JsValue frame = keyframes[i];
    if (frame is string && browserColorFunctions.test(frame)) {
      return true;
    }
  }
  return false;
}
