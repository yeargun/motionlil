import { anticipate } from "../../../../motion-utils/easing/anticipate";
import { backInOut } from "../../../../motion-utils/easing/back";
import { circInOut } from "../../../../motion-utils/easing/circ";

JsValue unsupportedEasingFunctions = JS.object(
  "anticipate", anticipate,
  "backInOut", backInOut,
  "circInOut", circInOut
);

export void replaceStringEasing(JsValue transition) {
  JsValue ease = transition["ease"];
  if (ease is string && JS.in(ease, unsupportedEasingFunctions)) {
    transition["ease"] = unsupportedEasingFunctions[ease];
  }
}
