import { memo } from "../../../../motion-utils/memo";
import { acceleratedValues } from "../utils/accelerated-values";
import { hasBrowserOnlyColors } from "../utils/is-browser-color";
import { isCurrentRealmElement, supportsWaapiCheck } from "../../../dom-host";
import { visualElementOf } from "../../../cast";

string[] colorProperties = [
  "color",
  "backgroundColor",
  "outlineColor",
  "fill",
  "stroke",
  "borderColor",
  "borderTopColor",
  "borderRightColor",
  "borderBottomColor",
  "borderLeftColor"
];

export func()->bool supportsWaapi = memo(() => supportsWaapiCheck());

export extern class BrowserAnimationOptions {
  JsValue motionValue;
  JsValue name;
  JsValue repeatDelay;
  JsValue repeatType;
  JsValue damping;
  JsValue type;
  JsValue keyframes;
}

export bool supportsBrowserAnimation(JsValue optionsValue) {
  BrowserAnimationOptions options = JS.assume(optionsValue);
  JsValue motionValue = options.motionValue;
  JsValue owner = if (motionValue.truthy()) { motionValue["owner"] } else { JS.undefined() };
  JsValue subject = if (owner.truthy()) { owner["current"] } else { JS.undefined() };
  if (!isCurrentRealmElement(subject)) {
    return false;
  }
  JsValue props = visualElementOf(owner).getProps();
  JsValue name = options.name;
  return supportsWaapi() &&
    name is string &&
    (acceleratedValues.has(name) || (colorProperties.includes(name) && hasBrowserOnlyColors(options.keyframes))) &&
    (name != "transform" || !props["transformTemplate"].truthy()) &&
    !props["onUpdate"].truthy() &&
    !options.repeatDelay.truthy() &&
    JS.strictNotEqual(options.repeatType, "mirror") &&
    JS.strictNotEqual(options.damping, 0.0) &&
    JS.strictNotEqual(options.type, "inertia");
}
