import { isMotionValue } from "../../value/utils/is-motion-value";
import { motionValue as createMotionValue } from "../../value/index";
import { animateMotionValue } from "../interfaces/motion-value";

export JsValue animateSingleValue(JsValue value, JsValue keyframes, JsValue? options = null) {
  JsValue motionValue = if (isMotionValue(value)) { value } else { createMotionValue(value) };
  JS.invoke(motionValue, "start", animateMotionValue("", motionValue, keyframes, options, JS.undefined(), false));
  return motionValue["animation"];
}
