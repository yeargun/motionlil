import { NativeAnimation, nativeStateOf, nativeTime, AnimNativeState } from "./NativeAnimation";

export class NativeAnimationWrapper extends NativeAnimation {
  init(JsValue animation) {
    super(null);
    AnimNativeState state = nativeStateOf(this);
    state.animation = JS.assume(animation);
    NativeAnimationWrapper self = this;
    animation["onfinish"] = () => {
      state.finishedTime = nativeTime(state);
      self.notifyFinished();
    };
  }
}
