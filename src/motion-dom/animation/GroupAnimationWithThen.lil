import { GroupAnimation } from "./GroupAnimation";
import { thenGroup } from "./utils/control-abi";
export class GroupAnimationWithThen extends GroupAnimation {
  init(JsValue[] input) { super(input); }
  Task<JsValue> then(JsValue onResolve, JsValue? onReject = null) {
    return thenGroup(this.getFinished(), onResolve);
  }
}
export constructor GroupAnimationWithThen as GroupAnimationWithThenConstructor;
