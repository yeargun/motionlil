import { GroupAnimation, groupAnimationPrototype } from "./GroupAnimation";
import { animClass, animCreate } from "./anim-host";

// Upstream's GroupAnimationWithThen.prototype, which inherits GroupAnimation's.
JsValue groupWithThenPrototype = animCreate(groupAnimationPrototype);

JsValue thenSurface = JS.object(
  "then", JS.object("value", JS.method1((JsValue self, JsValue onResolve) =>
    JS.invoke(JS.invoke(self["finished"], "finally", onResolve), "then", () => {})))
);

export class GroupAnimationWithThen extends GroupAnimation {
  init(JsValue[] animations) {
    super(animations, groupWithThenPrototype);
  }
}

// Upstream's public `GroupAnimationWithThen` class.
export JsValue groupAnimationWithThenConstructor = animClass(
  (JsValue animations, JsValue _unused) => new GroupAnimationWithThen(JS.assume(animations)),
  groupWithThenPrototype,
  thenSurface
);
