import { GroupAnimation } from "./GroupAnimation";
import { animDefineProperties as defineProperties } from "./anim-host";

JsValue thenSurface = JS.object(
  "then", JS.object("value", JS.method1((JsValue self, JsValue onResolve) =>
    JS.invoke(JS.invoke(self["finished"], "finally", onResolve), "then", () => {})))
);

export class GroupAnimationWithThen extends GroupAnimation {
  init(JsValue[] animations) {
    super(animations);
    defineProperties(this, thenSurface);
  }
}
