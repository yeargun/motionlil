import { clamp } from "../../motion-utils/clamp";
import { time } from "../frameloop/sync-time";
import { setStyle } from "../render/dom/style-set";
import { NativeAnimation, AnimNativeOptions, AnimNativeState, nativeAnimationPrototype, nativeStateOf, nativeStartTime, setNativeStartTime } from "./NativeAnimation";
import { JSAnimation, createJSAnimation, sampleJSAnimation, stopJSAnimation } from "./JSAnimation";
import { replaceTransitionType } from "./utils/replace-transition-type-spring";
import { replaceStringEasing } from "./waapi/utils/unsupported-easing";
import { animAssign3 as assign3, animClass, animCreate } from "./anim-host";

// Upstream's NativeAnimationExtended.prototype: NativeAnimation's, plus
// `updateMotionValue`.
JsValue nativeExtendedPrototype = animCreate(nativeAnimationPrototype);

JsValue prepareExtendedOptions(JsValue options) {
  replaceStringEasing(options);
  replaceTransitionType(options);
  return options;
}

// Keeps the motion value in step with the browser animation: the final value
// when it ends, or a velocity-carrying sample when it is stopped midway.
void updateMotionValue(AnimNativeState animation, JsValue value) {
  AnimNativeOptions options = animation.options;
  JsValue motionValue = options.motionValue;
  if (!motionValue.truthy()) {
    return;
  }
  if (!JS.isUndefined(value)) {
    JS.invoke(motionValue, "set", value);
    return;
  }
  JSAnimation sampleAnimation = createJSAnimation(assign3(JS.object(), options, JS.object(
    "motionValue", JS.undefined(),
    "onUpdate", JS.undefined(),
    "onComplete", JS.undefined(),
    "autoplay", false
  )));
  float startTime = JS.assume(nativeStartTime(animation));
  float sampleTime = (10.0).max(time.now() - startTime);
  float delta = clamp(0.0, 10.0, sampleTime - 10.0);
  JsValue current = sampleJSAnimation(sampleAnimation, sampleTime).value;
  JsValue element = options.element;
  JsValue name = options.name;
  if (element.truthy() && name.truthy()) {
    setStyle(element, JS.assume(name), current);
  }
  JS.invoke(motionValue, "setWithVelocity", sampleJSAnimation(sampleAnimation, (sampleTime - delta).max(0.0)).value, current, delta);
  stopJSAnimation(sampleAnimation);
}

export class NativeAnimationExtended extends NativeAnimation {
  init(JsValue options) {
    super(prepareExtendedOptions(options), nativeExtendedPrototype);
    AnimNativeState state = nativeStateOf(this);
    JsValue startTime = options["startTime"];
    if (!JS.isUndefined(startTime) && JS.strictNotEqual(options["autoplay"], false)) {
      setNativeStartTime(state, startTime);
    }
  }
}

// Upstream's public `NativeAnimationExtended` class.
export JsValue nativeAnimationExtendedConstructor = animClass(
  (JsValue options, JsValue _unused) => new NativeAnimationExtended(options),
  nativeExtendedPrototype,
  JS.object("updateMotionValue", JS.object("value", JS.method1((JsValue self, JsValue value) => {
    updateMotionValue(nativeStateOf(self), value);
    return JS.undefined();
  })))
);
