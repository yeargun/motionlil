import { resolveVariant } from "../../render/utils/resolve-dynamic-variants";
import { visualElementOf } from "../../cast";
import { calcChildStagger } from "../utils/calc-child-stagger";
import { animateTarget } from "./visual-element-target";
import { animAssign3 as assign3, animPromiseAll as promiseAll } from "../anim-host";

extern class AnimVariantOptions {
  JsValue type;
  JsValue transitionOverride;
  JsValue delay;
}

Task<bool> resolvedTask() {
  return Task.resolve(true);
}

export Task<bool> animateVariant(JsValue visualElement, JsValue variant, JsValue optionsValue) {
  AnimVariantOptions options = JS.assume(JS.or(optionsValue, JS.object()));
  JsValue presenceContext = visualElement["presenceContext"];
  JsValue resolved = resolveVariant(
    visualElement,
    variant,
    if (JS.strictEqual(options.type, "exit") && presenceContext.truthy()) { presenceContext["custom"] } else { JS.undefined() }
  );
  JsValue? resolvedTransition = if (resolved.truthy()) { resolved["transition"] } else { JS.undefined() };
  JsValue transition = resolvedTransition ?? JS.or(visualElementOf(visualElement).getDefaultTransition(), JS.object());
  if (options.transitionOverride.truthy()) {
    transition = options.transitionOverride;
  }
  func()->Task<bool> getAnimation = () => if (resolved.truthy()) {
    promiseAll(animateTarget(visualElement, resolved, options))
  } else {
    resolvedTask()
  };
  JsValue variantChildren = visualElement["variantChildren"];
  func(JsValue)->Task<bool> getChildAnimations = (JsValue forwardDelay) => {
    if (!(variantChildren.truthy() && variantChildren["size"].truthy())) {
      return resolvedTask();
    }
    JsValue? delayChildrenOption = transition["delayChildren"];
    JsValue delayChildren = delayChildrenOption ?? 0.0;
    JsValue? staggerChildren = transition["staggerChildren"];
    JsValue? staggerDirection = transition["staggerDirection"];
    Task<bool>[] animations = [];
    JS.invoke(variantChildren, "forEach", (JsValue child) => {
      visualElementOf(child).notify("AnimationStart", variant);
      float delay = JS.assume(JS.or(forwardDelay, 0.0));
      float delayChildrenValue = if (JS.typeOf(delayChildren) == "function") { 0.0 } else { JS.assume(delayChildren) };
      animations.push(animateVariant(child, variant, assign3(JS.object(), options, JS.object(
        "delay", delay + delayChildrenValue + calcChildStagger(variantChildren, child, delayChildren, JS.assume(staggerChildren ?? 0.0), JS.assume(staggerDirection ?? 1.0))
      ))).then((bool _v) => {
        visualElementOf(child).notify("AnimationComplete", variant);
        return true;
      }));
    });
    return promiseAll(animations);
  };
  JsValue when = transition["when"];
  if (when.truthy()) {
    if (JS.strictEqual(when, "beforeChildren")) {
      return getAnimation().then((bool _v) => getChildAnimations(JS.undefined()));
    }
    return getChildAnimations(JS.undefined()).then((bool _v) => getAnimation());
  }
  return promiseAll(JS.array(getAnimation(), getChildAnimations(options.delay)));
}
