import { frame } from "../../frameloop/frame";
import { FrameData } from "../../frameloop/types";
import { positionalKeys } from "../../render/utils/keys-position";
import { setTarget } from "../../render/utils/setters";
import { addValueToWillChange } from "../../value/will-change/add-will-change";
import { visualElementOf } from "../../cast";
import { windowGet } from "../../dom-host";
import { getOptimisedAppearId } from "../optimized-appear/get-appear-id";
import { getValueTransition } from "../utils/get-value-transition";
import { resolveTransition } from "../utils/resolve-transition";
import { animateMotionValue } from "./motion-value";
import { animAssign2 as assign2, animPromiseAll as promiseAll } from "../anim-host";

extern class AnimTargetOptions {
  JsValue? delay;
  JsValue transitionOverride;
  JsValue type;
}

export JsValue[] animateTarget(
  JsValue visualElement,
  JsValue targetAndTransition,
  JsValue optionsValue
) {
  AnimTargetOptions options = JS.assume(JS.or(optionsValue, JS.object()));
  JsValue delay = options.delay ?? 0.0;
  JsValue transition = targetAndTransition["transition"];
  JsValue transitionEnd = targetAndTransition["transitionEnd"];
  JsValue defaultTransition = visualElementOf(visualElement).getDefaultTransition();
  transition = if (transition.truthy()) { resolveTransition(transition, defaultTransition) } else { defaultTransition };
  JsValue reduceMotion = if (transition.truthy()) { transition["reduceMotion"] } else { JS.undefined() };
  bool skipAnimations = transition.truthy() && transition["skipAnimations"].truthy();
  if (options.transitionOverride.truthy()) {
    transition = options.transitionOverride;
  }
  JsValue[] animations = [];
  JsValue animationState = visualElement["animationState"];
  JsValue animationTypeState = if (options.type.truthy() && animationState.truthy()) {
    JS.invoke(animationState, "getState")[options.type]
  } else {
    JS.undefined()
  };
  JsValue target = JS.object();
  for (string key in targetAndTransition) {
    if (key != "transition" && key != "transitionEnd") {
      target[key] = targetAndTransition[key];
    }
  }
  JsValue path = if (transition.truthy()) { transition["path"] } else { JS.undefined() };
  if (path.truthy()) {
    JS.invoke(path, "animateVisualElement", visualElement, target, transition, delay, animations);
  }
  for (string key in target) {
    JsValue value = visualElementOf(visualElement).getValue(key, visualElement["latestValues"][key], true);
    JsValue valueTarget = target[key];
    if (JS.isUndefined(valueTarget)) {
      continue;
    }
    if (animationTypeState.truthy()) {
      JsValue needsAnimating = animationTypeState["needsAnimating"];
      bool shouldBlock = JS.in(key, animationTypeState["protectedKeys"]) && JS.strictNotEqual(needsAnimating[key], true);
      needsAnimating[key] = false;
      if (shouldBlock) {
        continue;
      }
    }
    JsValue valueTransition = assign2(JS.object("delay", delay), getValueTransition(JS.or(transition, JS.object()), key));
    if (skipAnimations) {
      valueTransition["skipAnimations"] = true;
    }
    JsValue currentValue = JS.invoke(value, "get");
    if (
      !JS.isNullish(currentValue) &&
      !JS.invoke(value, "isAnimating").truthy() &&
      !valueTarget.isArray() &&
      JS.strictEqual(valueTarget, currentValue) &&
      !valueTransition["velocity"].truthy()
    ) {
      frame.update((FrameData _data) => {
        JS.invoke(value, "set", valueTarget);
      }, false, false);
      continue;
    }
    bool isHandoff = false;
    JsValue handoff = windowGet("MotionHandoffAnimation");
    if (handoff.truthy()) {
      JsValue appearId = getOptimisedAppearId(visualElement);
      if (appearId.truthy()) {
        JsValue startTime = JS.call(handoff, JS.undefined(), appearId, key, frame);
        if (JS.strictNotEqual(startTime, null)) {
          valueTransition["startTime"] = startTime;
          isHandoff = true;
        }
      }
    }
    addValueToWillChange(visualElement, key);
    JsValue? explicitReduce = reduceMotion;
    JsValue shouldReduceMotion = explicitReduce ?? visualElement["shouldReduceMotion"];
    JS.invoke(value, "start", animateMotionValue(
      key,
      value,
      valueTarget,
      if (shouldReduceMotion.truthy() && positionalKeys.has(key)) { JS.object("type", false) } else { valueTransition },
      visualElement,
      isHandoff
    ));
    JsValue animation = value["animation"];
    if (animation.truthy()) {
      animations.push(animation);
    }
  }
  if (transitionEnd.truthy()) {
    func()->void applyTransitionEnd = () => {
      frame.update((FrameData _data) => {
        setTarget(visualElement, transitionEnd);
      }, false, false);
    };
    if (animations.length > 0) {
      promiseAll(animations).then((bool _v) => {
        applyTransitionEnd();
        return true;
      });
    } else {
      applyTransitionEnd();
    }
  }
  return animations;
}
