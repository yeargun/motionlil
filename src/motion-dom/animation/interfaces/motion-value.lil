import { MotionGlobalConfig } from "../../../motion-utils/global-config";
import { secondsToMilliseconds } from "../../../motion-utils/time-conversion";
import { frame } from "../../frameloop/frame";
import { FrameData } from "../../frameloop/types";
import { createAsyncMotionValueAnimation } from "../AsyncMotionValueAnimation";
import { createJSAnimation } from "../JSAnimation";
import { getFinalKeyframe } from "../keyframes/get-final";
import { getDefaultTransition } from "../utils/default-transitions";
import { getValueTransition } from "../utils/get-value-transition";
import { isTransitionDefined } from "../utils/is-transition-defined";
import { makeAnimationInstant } from "../utils/make-animation-instant";
import { animAssign2 as assign2, animAssign3 as assign3 } from "../anim-host";

extern class AnimValueTransition {
  JsValue delay;
  JsValue? elapsed;
  JsValue onUpdate;
  JsValue onComplete;
  JsValue skipAnimations;
  JsValue type;
  JsValue ease;
  JsValue isSync;
}

extern class AnimMotionValueOptions {
  JsValue keyframes;
  JsValue duration;
  JsValue repeatDelay;
  JsValue from;
  JsValue type;
  JsValue delay;
  JsValue allowFlatten;
}

export func(func()->void)->JsValue? animateMotionValue(
  string name,
  JsValue value,
  JsValue target,
  JsValue transitionValue,
  JsValue element,
  bool isHandoff
) {
  AnimValueTransition transition = JS.assume(JS.or(transitionValue, JS.object()));
  return (func()->void onComplete) => {
    AnimValueTransition valueTransition = JS.assume(JS.or(getValueTransition(transition, name), JS.object()));
    JsValue delay = JS.or(valueTransition.delay, JS.or(transition.delay, 0.0));
    float elapsed = JS.assume(transition.elapsed ?? 0.0);
    float delayValue = JS.assume(delay);
    elapsed -= secondsToMilliseconds(delayValue);
    AnimMotionValueOptions options = JS.assume(assign3(
      JS.object(
        "keyframes", if (target.isArray()) { target } else { JS.array(null, target) },
        "ease", "easeOut",
        "velocity", JS.invoke(value, "getVelocity")
      ),
      valueTransition,
      JS.object(
        "delay", -elapsed,
        "onUpdate", (JsValue v) => {
          JS.invoke(value, "set", v);
          if (valueTransition.onUpdate.truthy()) {
            JS.invoke(valueTransition, "onUpdate", v);
          }
        },
        "onComplete", () => {
          onComplete();
          if (valueTransition.onComplete.truthy()) {
            JS.invoke(valueTransition, "onComplete");
          }
        },
        "name", name,
        "motionValue", value,
        "element", if (isHandoff) { JS.undefined() } else { element }
      )
    ));
    if (!isTransitionDefined(valueTransition)) {
      assign2(options, getDefaultTransition(name, options));
    }
    if (options.duration.truthy()) {
      options.duration = secondsToMilliseconds(JS.assume(options.duration));
    }
    if (options.repeatDelay.truthy()) {
      options.repeatDelay = secondsToMilliseconds(JS.assume(options.repeatDelay));
    }
    if (!JS.isUndefined(options.from)) {
      options.keyframes[0] = options.from;
    }
    bool shouldSkip = false;
    if (JS.strictEqual(options.type, false) || (JS.strictEqual(options.duration, 0.0) && !options.repeatDelay.truthy())) {
      makeAnimationInstant(options);
      shouldSkip = JS.strictEqual(options.delay, 0.0);
    }
    if (
      MotionGlobalConfig.instantAnimations == true ||
      MotionGlobalConfig.skipAnimations == true ||
      (element.truthy() && element["shouldSkipAnimations"].truthy()) ||
      valueTransition.skipAnimations.truthy()
    ) {
      shouldSkip = true;
      makeAnimationInstant(options);
      options.delay = 0.0;
    }
    options.allowFlatten = !valueTransition.type.truthy() && !valueTransition.ease.truthy();
    if (shouldSkip && !isHandoff && !JS.isNullish(JS.invoke(value, "get"))) {
      JsValue finalKeyframe = getFinalKeyframe(options.keyframes, valueTransition, JS.undefined(), 1.0);
      if (!JS.isUndefined(finalKeyframe)) {
        frame.update((FrameData _data) => {
          JS.invoke(options, "onUpdate", finalKeyframe);
          JS.invoke(options, "onComplete");
        }, false, false);
        return JS.undefined();
      }
    }
    return if (valueTransition.isSync.truthy()) { createJSAnimation(options) } else { createAsyncMotionValueAnimation(options) };
  };
}
