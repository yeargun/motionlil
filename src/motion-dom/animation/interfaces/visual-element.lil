import { resolveVariant } from "../../render/utils/resolve-dynamic-variants";
import { animateTarget } from "./visual-element-target";
import { animateVariant } from "./visual-element-variant";
import { animPromiseAll as promiseAll } from "../anim-host";
import { visualElementOf } from "../../cast";

export Task<bool> animateVisualElement(
  JsValue visualElement,
  JsValue definition,
  JsValue optionsValue
) {
  JsValue options = JS.or(optionsValue, JS.object());
  visualElementOf(visualElement).notify("AnimationStart", definition);
  Task<bool> animation = if (definition.isArray()) {
    promiseAll(JS.invoke(definition, "map", (JsValue variant) => animateVariant(visualElement, variant, options)))
  } else {
    if (definition is string) {
      animateVariant(visualElement, definition, options)
    } else {
      promiseAll(animateTarget(
        visualElement,
        if (JS.typeOf(definition) == "function") { resolveVariant(visualElement, definition, options["custom"]) } else { definition },
        options
      ))
    }
  };
  return animation.then((bool _v) => {
    visualElementOf(visualElement).notify("AnimationComplete", definition);
    return true;
  });
}
