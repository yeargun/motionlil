import { setProp } from "../../dom-host";
import { keyframes } from "../generators/keyframes";

Record<JsValue> transitionTypeMap = record{tween: keyframes, keyframes: keyframes};

export void replaceTransitionType(JsValue transition) {
  if (!transition.isObject()) {
    return;
  }
  JsValue typeValue = transition["type"];
  if (typeValue is string) {
    JsValue? mapped = transitionTypeMap[typeValue];
    if (mapped != null) {
      setProp(transition, "type", mapped);
    }
  }
}
