Regex singleCssVariableRegex = new Regex(
  "var\\(--(?:[\\w-]+\\s*|[\\w-]+\\s*,(?:\\s*[^)(\\s]|\\s*\\((?:[^)(]|\\([^)(]*\\))*\\))+\\s*)\\)$",
  "iu"
);

export bool isCSSVariableName(JsValue key) {
  return key is string && key.startsWith("--");
}

export bool isCSSVariableToken(JsValue value) {
  return value is string && value.startsWith("var(--") && singleCssVariableRegex.test(value.split("/*")[0].trim());
}

export bool containsCSSVariable(JsValue value) {
  return value is string && value.split("/*")[0].includes("var(--");
}
