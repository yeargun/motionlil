import { animArrayFrom as arrayFrom } from "../anim-host";

export float calcChildStagger(
  JsValue children,
  JsValue child,
  JsValue delayChildren,
  float staggerChildren = 0.0,
  float staggerDirection = 1.0
) {
  JsValue sorted = JS.invoke(arrayFrom(children), "sort", (JsValue a, JsValue b) => JS.invoke(a, "sortNodePosition", b));
  float index = JS.assume(JS.invoke(sorted, "indexOf", child));
  float numChildren = JS.assume(children["size"]);
  if (JS.typeOf(delayChildren) == "function") {
    return JS.assume(JS.call(delayChildren, JS.undefined(), index, numChildren));
  }
  return if (staggerDirection == 1.0) {
    index * staggerChildren
  } else {
    (numChildren - 1.0) * staggerChildren - index * staggerChildren
  };
}
