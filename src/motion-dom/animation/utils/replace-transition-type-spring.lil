import { inertia } from "../generators/inertia";
import { keyframes } from "../generators/keyframes";
import { spring } from "../generators/spring";

JsValue transitionTypeMap = JS.object(
  "decay", inertia,
  "inertia", inertia,
  "tween", keyframes,
  "keyframes", keyframes,
  "spring", spring
);

export void replaceTransitionType(JsValue transition) {
  JsValue type = transition["type"];
  if (type is string) {
    transition["type"] = transitionTypeMap[type];
  }
}
