string[] orchestrationKeys = [
  "when",
  "delay",
  "delayChildren",
  "staggerChildren",
  "staggerDirection",
  "repeat",
  "repeatType",
  "repeatDelay",
  "from",
  "elapsed"
];

export bool isTransitionDefined(JsValue transition) {
  for (string key in transition) {
    if (!orchestrationKeys.includes(key)) {
      return true;
    }
  }
  return false;
}
