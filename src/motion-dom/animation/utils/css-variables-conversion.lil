import { isNumericalString } from "../../../motion-utils/is-numerical-string";
import { isCSSVariableToken } from "./is-css-variable";
import { getComputedStyleProperty } from "../../dom-host";

extern float parseFloat(JsValue v);

Regex splitCSSVariableRegex = new Regex(
  "^var\\(--(?:([\\w-]+)|([\\w-]+), ?([a-zA-Z\\d ()%#.,-]+))\\)",
  "u"
);

export JsValue parseCSSVariable(string current) {
  JsValue found = JS.regexExec(splitCSSVariableRegex, current);
  if (!found.truthy()) {
    return JS.array(JS.undefined());
  }
  JsValue? token1 = found[1];
  return JS.array(JS.add("--", token1 ?? found[2]), found[3]);
}

export JsValue getVariableValue(string current, JsValue element) {
  JsValue parsed = parseCSSVariable(current);
  JsValue token = parsed[0];
  if (!token.truthy()) {
    return JS.undefined();
  }
  string resolved = getComputedStyleProperty(element, JS.assume(token));
  if (resolved != "") {
    string trimmed = resolved.trim();
    return if (isNumericalString(trimmed)) { parseFloat(trimmed) } else { trimmed };
  }
  JsValue fallback = parsed[1];
  return if (isCSSVariableToken(fallback)) { getVariableValue(JS.assume(fallback), element) } else { fallback };
}
