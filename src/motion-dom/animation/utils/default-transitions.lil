import { transformProps } from "../../render/utils/keys-transform";

JsValue underDampedSpring = JS.object(
  "type", "spring",
  "stiffness", 500.0,
  "damping", 25.0,
  "restSpeed", 10.0
);

JsValue keyframesTransition = JS.object("type", "keyframes", "duration", 0.8);

JsValue easeTransition = JS.object(
  "type", "keyframes",
  "ease", JS.array(0.25, 0.1, 0.35, 1.0),
  "duration", 0.3
);

export JsValue getDefaultTransition(string valueKey, JsValue options) {
  JsValue keyframes = options["keyframes"];
  if (keyframes.length > 2.0) {
    return keyframesTransition;
  }
  if (transformProps.has(valueKey)) {
    if (valueKey.startsWith("scale")) {
      return JS.object(
        "type", "spring",
        "stiffness", 550.0,
        "damping", if (JS.strictEqual(keyframes[1], 0.0)) { 2.0 * (550.0).sqrt() } else { 30.0 },
        "restSpeed", 10.0
      );
    }
    return underDampedSpring;
  }
  return easeTransition;
}
