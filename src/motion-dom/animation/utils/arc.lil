import { Math } from "../../render/dom/parse-transform";
import { wrap } from "../../../motion-utils/wrap";
import { motionValue } from "../../value/index";
import { visualElementOf } from "../../cast";
import { animateMotionValue } from "../interfaces/motion-value";
import { getValueTransition } from "./get-value-transition";
import { animAssign2 as assign2 } from "../anim-host";

extern class AnimArcPoint {
  float x;
  float y;
}

extern class AnimArcOptions {
  JsValue? strength;
  JsValue? peak;
  JsValue direction;
  JsValue rotate;
}

float bezierPoint(float t, float origin, float control, float target) {
  float inv = 1.0 - t;
  return inv * inv * origin + 2.0 * inv * t * control + t * t * target;
}

float bezierTangentAngle(float t, AnimArcPoint from, AnimArcPoint control, AnimArcPoint to) {
  float dx = 2.0 * (1.0 - t) * (control.x - from.x) + 2.0 * t * (to.x - control.x);
  float dy = 2.0 * (1.0 - t) * (control.y - from.y) + 2.0 * t * (to.y - control.y);
  return Math.atan2(dy, dx) * (180.0 / Math.PI);
}

AnimArcPoint computeArcControlPoint(AnimArcPoint from, AnimArcPoint to, float strength, float peak) {
  float deltaX = to.x - from.x;
  float deltaY = to.y - from.y;
  float distance = (deltaX * deltaX + deltaY * deltaY).sqrt();
  if (distance > 0.0) {
    float desiredHeight = strength * distance;
    return JS.assume(JS.object(
      "x", from.x + deltaX * peak + -deltaY / distance * desiredHeight,
      "y", from.y + deltaY * peak + deltaX / distance * desiredHeight
    ));
  }
  return JS.assume(JS.object("x", from.x, "y", from.y));
}

float sign(float v) {
  return if (v > 0.0) { 1.0 } else { if (v < 0.0) { -1.0 } else { 0.0 } };
}

func(AnimArcPoint, AnimArcPoint)->func(float)->JsValue createArcPath(JsValue optionsValue) {
  AnimArcOptions options = JS.assume(JS.or(optionsValue, JS.object()));
  float strength = JS.assume(options.strength ?? 0.5);
  float peak = JS.assume(options.peak ?? 0.5);
  JsValue direction = options.direction;
  JsValue rotate = options.rotate;
  float rotationScale = if (JS.strictEqual(rotate, true)) { 1.0 } else { if (rotate is float) { rotate } else { 0.0 } };
  float? prevBulgeSign = null;
  return (AnimArcPoint from, AnimArcPoint to) => {
    float dx = to.x - from.x;
    float dy = to.y - from.y;
    float dom = if (dx.abs() >= dy.abs()) { dx } else { dy };
    float signed = if (JS.strictEqual(direction, "cw") || (!JS.strictEqual(direction, "ccw") && dom < 0.0)) { -strength } else { strength };
    AnimArcPoint control = computeArcControlPoint(from, to, signed, peak);
    if (JS.isUndefined(direction)) {
      float bulgeSign = if (dx.abs() < dy.abs()) { sign(control.x - (from.x + dx * peak)) } else { sign(control.y - (from.y + dy * peak)) };
      float? prev = prevBulgeSign;
      if (prev != null && bulgeSign != 0.0 && bulgeSign != prev) {
        control = computeArcControlPoint(from, to, -signed, peak);
      } else if (bulgeSign != 0.0) {
        prevBulgeSign = bulgeSign;
      }
    }
    float tangent0 = if (rotationScale != 0.0) { bezierTangentAngle(0.0, from, control, to) } else { 0.0 };
    float tangentDelta = if (rotationScale != 0.0) { wrap(-180.0, 180.0, bezierTangentAngle(1.0, from, control, to) - tangent0) } else { 0.0 };
    return (float t) => {
      JsValue out = JS.object(
        "x", bezierPoint(t, from.x, control.x, to.x),
        "y", bezierPoint(t, from.y, control.y, to.y)
      );
      if (rotationScale != 0.0) {
        out["rotate"] = wrap(-180.0, 180.0, bezierTangentAngle(t, from, control, to) - (tangent0 + tangentDelta * t)) * rotationScale;
      }
      return out;
    };
  };
}

JsValue fromOf(JsValue raw, JsValue value) {
  JsValue? first = if (raw.isArray() && JS.strictNotEqual(raw[0], null) && !JS.isUndefined(raw[0])) {
    raw[0]
  } else {
    if (value.truthy()) { JS.invoke(value, "get") } else { JS.undefined() }
  };
  return first ?? 0.0;
}

JsValue toOf(JsValue raw, JsValue from) {
  JsValue? last = if (raw.isArray()) { raw[raw.length - 1.0] } else { raw };
  return if (raw.isArray()) { last } else { last ?? from };
}

export JsValue arc(JsValue options) {
  func(AnimArcPoint, AnimArcPoint)->func(float)->JsValue sample = createArcPath(options);
  return JS.object(
    "interpolateProjection", (JsValue delta) => {
      float tx = JS.assume(delta["x"]["translate"]);
      float ty = JS.assume(delta["y"]["translate"]);
      if ((tx * tx + ty * ty).sqrt() < 20.0) {
        return JS.undefined();
      }
      return sample(JS.assume(JS.object("x", tx, "y", ty)), JS.assume(JS.object("x", 0.0, "y", 0.0)));
    },
    "animateVisualElement", (JsValue visualElement, JsValue target, JsValue transition, JsValue delay, JsValue animations) => {
      if (!(JS.in("x", target) || JS.in("y", target))) {
        return;
      }
      JsValue latestValues = visualElement["latestValues"];
      JsValue? latestX = latestValues["x"];
      JsValue? latestY = latestValues["y"];
      JsValue xValue = visualElementOf(visualElement).getValue("x", latestX ?? 0.0, true);
      JsValue yValue = visualElementOf(visualElement).getValue("y", latestY ?? 0.0, true);
      JsValue xRaw = target["x"];
      JsValue yRaw = target["y"];
      JsValue xFrom = fromOf(xRaw, xValue);
      JsValue yFrom = fromOf(yRaw, yValue);
      JsValue xTo = toOf(xRaw, xFrom);
      JsValue yTo = toOf(yRaw, yFrom);
      func(float)->JsValue interpolate = sample(JS.assume(JS.object("x", xFrom, "y", yFrom)), JS.assume(JS.object("x", xTo, "y", yTo)));
      JsValue pathRotationValue = if (JS.isUndefined(interpolate(0.0)["rotate"])) {
        JS.undefined()
      } else {
        visualElementOf(visualElement).getValue("pathRotation", 0.0, true)
      };
      JsValue pathTransition = assign2(JS.object("delay", delay), getValueTransition(JS.or(transition, JS.object()), "x"));
      JS.delete(pathTransition, "path");
      JsValue progress = motionValue(0.0);
      func()->void resetRotation = () => {
        if (pathRotationValue.truthy()) {
          JS.invoke(pathRotationValue, "set", 0.0);
        }
      };
      JS.invoke(progress, "start", animateMotionValue("", progress, JS.array(0.0, 1000.0), assign2(pathTransition, JS.object(
        "isSync", true,
        "velocity", 0.0,
        "onUpdate", (float latest) => {
          JsValue point = interpolate(latest / 1000.0);
          if (xValue.truthy()) {
            JS.invoke(xValue, "set", point["x"]);
          }
          if (yValue.truthy()) {
            JS.invoke(yValue, "set", point["y"]);
          }
          if (pathRotationValue.truthy() && !JS.isUndefined(point["rotate"])) {
            JS.invoke(pathRotationValue, "set", point["rotate"]);
          }
        },
        "onComplete", () => {
          if (xValue.truthy()) {
            JS.invoke(xValue, "set", xTo);
          }
          if (yValue.truthy()) {
            JS.invoke(yValue, "set", yTo);
          }
          resetRotation();
        },
        "onStop", resetRotation,
        "onCancel", resetRotation
      )), JS.undefined(), false));
      JsValue animation = progress["animation"];
      if (animation.truthy()) {
        JS.invoke(animations, "push", animation);
      }
      JS.delete(target, "x");
      JS.delete(target, "y");
    }
  );
}
