import { resolveTransition } from "./resolve-transition";

export JsValue getValueTransition(JsValue transition, string key) {
  if (!transition.truthy()) {
    return transition;
  }
  JsValue? keyed = transition[key];
  JsValue? fallback = transition["default"];
  JsValue valueTransition = keyed ?? fallback ?? transition;
  return if (JS.strictNotEqual(valueTransition, transition)) {
    resolveTransition(valueTransition, transition)
  } else {
    valueTransition
  };
}
