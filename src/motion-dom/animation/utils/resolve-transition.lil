export JsValue resolveTransition(JsValue transition, JsValue parentTransition) {
  if (transition.truthy() && transition["inherit"].truthy() && parentTransition.truthy()) {
    JsValue merged = JS.object();
    for (string key in parentTransition) {
      merged[key] = parentTransition[key];
    }
    for (string key in transition) {
      if (key != "inherit") {
        merged[key] = transition[key];
      }
    }
    return merged;
  }
  return transition;
}
