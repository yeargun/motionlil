import { complex } from "../../value/types/complex/index";

export bool isAnimatable(JsValue value, JsValue name) {
  if (JS.strictEqual(name, "zIndex")) {
    return false;
  }
  return value is float || value.isArray() || (value is string && (complex.test(value) || value == "0") && !value.startsWith("url("));
}
