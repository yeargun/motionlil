import { isGenerator } from "../generators/utils/is-generator";
import { isAnimatable } from "./is-animatable";

export bool canAnimate(JsValue keyframes, JsValue name, JsValue type, JsValue velocity) {
  JsValue originKeyframe = keyframes[0];
  if (JS.strictEqual(originKeyframe, null)) {
    return false;
  }
  if (JS.strictEqual(name, "display") || JS.strictEqual(name, "visibility")) {
    return true;
  }
  if (!isAnimatable(originKeyframe, name) || !isAnimatable(keyframes[keyframes.length - 1.0], name)) {
    return false;
  }
  if (keyframes.length == 1.0) {
    return true;
  }
  for (float i = 0.0; i < keyframes.length; i++) {
    if (JS.strictNotEqual(keyframes[i], originKeyframe)) {
      return true;
    }
  }
  return (JS.strictEqual(type, "spring") || isGenerator(type)) && velocity.truthy();
}
