import { animNewPromise as newPromise } from "../anim-host";

// The promise state lives on the object itself, as upstream's `_finished`
// and `resolve`; the class declares no fields, so constructing a subclass
// anywhere does not spell out a field literal.
export extern class AnimPromiseState {
  Task<bool> _finished;
  func()->void _resolve;
}

export AnimPromiseState promiseStateOf(JsValue value) {
  return JS.assume(value);
}

export void updateFinished(JsValue value) {
  AnimPromiseState state = promiseStateOf(value);
  state._finished = newPromise((func()->void resolve) => {
    state._resolve = resolve;
  });
}

export class WithPromise {
  init() {
    updateFinished(this);
  }

  Task<bool> finished() {
    return promiseStateOf(this)._finished;
  }

  void updateFinished() {
    updateFinished(this);
  }

  void notifyFinished() {
    promiseStateOf(this)._resolve();
  }

  Task<bool> then(func()->void onResolve, (func()->void)? onReject = null) {
    return promiseStateOf(this)._finished.then((bool _v) => {
      onResolve();
      return true;
    });
  }
}

// Upstream's `get finished()` and `then()`, shared by the animation surfaces.
export JsValue finishedDescriptor = JS.object("get", JS.method0((JsValue self) => promiseStateOf(self)._finished));
export JsValue thenDescriptor = JS.object("value", JS.method2((JsValue self, JsValue onResolve, JsValue onReject) =>
  JS.invoke(promiseStateOf(self)._finished, "then", onResolve, onReject)));
