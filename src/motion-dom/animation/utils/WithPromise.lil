import { installControlProperties, finishedTask, thenFinished } from "./control-abi";

export class WithPromise {
  Task<JsValue>? finishedTask;
  (func()->void)? resolveFn;
  (func()->Task<JsValue>)? finishedHook;

  init() {
    this.finishedTask = null;
    this.resolveFn = null;
    this.finishedHook = null;
    this.updateFinished();
    installControlProperties(this);
  }

  Task<JsValue> getFinished() {
    (func()->Task<JsValue>)? hook = this.finishedHook;
    if (hook != null) { return hook(); }
    return this.baseFinished();
  }

  Task<JsValue> baseFinished() {
    Task<JsValue>? task = this.finishedTask;
    if (task != null) { return task; }
    return Task.resolve(null);
  }

  void updateFinished() {
    WithPromise self = this;
    this.finishedTask = finishedTask((func()->void resolve) => { self.resolveFn = resolve; });
  }

  void notifyFinished() {
    (func()->void)? resolve = this.resolveFn;
    if (resolve != null) { resolve(); }
  }

  Task<JsValue> then(JsValue onResolve, JsValue? onReject = null) {
    return thenFinished(this.getFinished(), onResolve, onReject);
  }
}
