import { taskFromCallback } from "../../dom-host";

export class WithPromise {
  Task<bool>? finishedTask;
  (func()->void)? resolveFn;
  bool resolved;
  (func()->Task<bool>)? finishedHook;

  init() {
    this.finishedTask = null;
    this.resolveFn = null;
    this.resolved = false;
    this.finishedHook = null;
  }

  Task<bool> finished() {
    (func()->Task<bool>)? hook = this.finishedHook;
    if (hook != null) { return hook(); }
    return this.baseFinished();
  }

  Task<bool> baseFinished() {
    if (this.resolved) {
      return Task.resolve(true);
    }
    Task<bool>? task = this.finishedTask;
    if (task == null) {
      this.createFinishedTask();
      task = this.finishedTask;
    }
    if (task != null) {
      return task;
    }
    return Task.resolve(this.resolved);
  }

  void updateFinished() {
    this.finishedTask = null;
    this.resolveFn = null;
    this.resolved = false;
  }

  void createFinishedTask() {
    WithPromise self = this;
    this.finishedTask = taskFromCallback((func()->void resolve) => {
      self.resolveFn = resolve;
    });
  }

  void notifyFinished() {
    this.resolved = true;
    (func()->void)? resolve = this.resolveFn;
    if (resolve != null) {
      resolve();
      this.resolveFn = null;
    }
  }

  Task<bool> then(func()->void onResolve, (func()->void)? onReject = null) {
    return this.finished().then((bool _v) => {
      onResolve();
      return true;
    });
  }
}
