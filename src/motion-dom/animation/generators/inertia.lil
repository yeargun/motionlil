import { spring } from "./spring";
import { SpringGenerator, AnimGeneratorState } from "./generator";
import { getGeneratorVelocity } from "./utils/velocity";

export extern class InertiaInput {
  JsValue keyframes;
  JsValue? velocity;
  JsValue? power;
  JsValue? timeConstant;
  JsValue? bounceDamping;
  JsValue? bounceStiffness;
  JsValue modifyTarget;
  JsValue min;
  JsValue max;
  JsValue? restDelta;
  JsValue restSpeed;
}

export SpringGenerator inertia(JsValue optionsValue) {
  InertiaInput options = JS.assume(optionsValue);
  float origin = JS.assume(options.keyframes[0]);
  float velocity = JS.assume(options.velocity ?? 0.0);
  float power = JS.assume(options.power ?? 0.8);
  float timeConstant = JS.assume(options.timeConstant ?? 325.0);
  float restDelta = JS.assume(options.restDelta ?? 0.5);
  float? min = JS.assume(options.min);
  float? max = JS.assume(options.max);
  AnimGeneratorState state = JS.assume(JS.object("done", false, "value", origin));
  float amplitude = power * velocity;
  float ideal = origin + amplitude;
  float target = if (JS.isUndefined(options.modifyTarget)) { ideal } else { JS.assume(JS.call(options.modifyTarget, JS.undefined(), ideal)) };
  if (target != ideal) {
    amplitude = target - origin;
  }
  func(float)->float calcDelta = (float t) => -amplitude * (-t / timeConstant).exp();
  func(float)->float calcLatest = (float t) => target + calcDelta(t);
  func(float)->void applyFriction = (float t) => {
    float delta = calcDelta(t);
    float latest = calcLatest(t);
    state.done = delta.abs() <= restDelta;
    state.value = if (state.done) { target } else { latest };
  };
  float? timeReachedBoundary = null;
  SpringGenerator? boundarySpring = null;
  func(float)->void checkCatchBoundary = (float t) => {
    float value = JS.assume(state.value);
    if ((min != null && value < min) || (max != null && value > max)) {
      timeReachedBoundary = t;
      JsValue boundary = if (min == null) {
        max
      } else {
        if (max == null || (min - value).abs() < (max - value).abs()) { min } else { max }
      };
      boundarySpring = spring(JS.object(
        "keyframes", JS.array(value, boundary),
        "velocity", getGeneratorVelocity(calcLatest, t, value),
        "damping", options.bounceDamping ?? 10.0,
        "stiffness", options.bounceStiffness ?? 500.0,
        "restDelta", restDelta,
        "restSpeed", options.restSpeed
      ), JS.undefined());
    }
  };
  checkCatchBoundary(0.0);
  return JS.assume(JS.object(
    "calculatedDuration", null,
    "next", (float t) => {
      bool hasUpdatedFrame = false;
      if (boundarySpring == null && timeReachedBoundary == null) {
        hasUpdatedFrame = true;
        applyFriction(t);
        checkCatchBoundary(t);
      }
      float? boundaryTime = timeReachedBoundary;
      SpringGenerator? catchSpring = boundarySpring;
      if (boundaryTime != null && catchSpring != null && t >= boundaryTime) {
        return catchSpring.next(t - boundaryTime);
      }
      if (!hasUpdatedFrame) {
        applyFriction(t);
      }
      return state;
    }
  ));
}
