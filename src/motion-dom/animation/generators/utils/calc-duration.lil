import { SpringGenerator, AnimGeneratorState } from "../generator";

export float maxGeneratorDuration = 20000.0;

export float calcGeneratorDuration(SpringGenerator gen) {
  float duration = 0.0;
  AnimGeneratorState state = gen.next(duration);
  while (!state.done && duration < maxGeneratorDuration) {
    duration += 50.0;
    state = gen.next(duration);
  }
  return if (duration >= maxGeneratorDuration) { 1.0 / 0.0 } else { duration };
}
