import { millisecondsToSeconds } from "../../../../motion-utils/time-conversion";
import { SpringGenerator } from "../generator";
import { calcGeneratorDuration, maxGeneratorDuration } from "./calc-duration";
import { animAssign3 as assign3 } from "../../anim-host";

export class GeneratorEasingResult {
  string type;
  func(float)->float ease;
  float duration;

  init(string type, func(float)->float ease, float duration) {
    this.type = type;
    this.ease = ease;
    this.duration = duration;
  }
}


export GeneratorEasingResult createGeneratorEasing(
  JsValue options,
  float scale,
  JsValue createGenerator
) {
  SpringGenerator gen = JS.assume(JS.call(createGenerator, JS.undefined(),
    assign3(JS.object(), options, JS.object("keyframes", JS.array(0.0, scale)))));
  float duration = calcGeneratorDuration(gen).min(maxGeneratorDuration);
  return new GeneratorEasingResult(
    "keyframes",
    (float progress) => {
      float value = JS.assume(gen.next(duration * progress).value);
      return value / scale;
    },
    millisecondsToSeconds(duration)
  );
}
