import { clamp } from "../../../motion-utils/clamp";
import {
  millisecondsToSeconds,
  secondsToMilliseconds
} from "../../../motion-utils/time-conversion";
import { calcGeneratorDuration, maxGeneratorDuration } from "./utils/calc-duration";
import { createGeneratorEasing, GeneratorEasingResult } from "./utils/create-generator-easing";
import { generateLinearEasing } from "../waapi/utils/linear";
import { SpringGenerator, AnimGeneratorState } from "./generator";
import { animSinh as sinh, animCosh as cosh } from "../anim-host";

export { SpringGenerator };

// Typed spring options, for callers that build them field by field. Unset
// fields stay undefined, so the object reads like the literal it stands for.
export class SpringInput {
  float[] keyframes;
  JsValue stiffness;
  JsValue damping;
  JsValue mass;
  JsValue velocity;
  JsValue duration;
  JsValue bounce;
  JsValue visualDuration;
  JsValue restSpeed;
  JsValue restDelta;

  init(float[] keyframes) {
    this.keyframes = keyframes;
    this.stiffness = JS.undefined();
    this.damping = JS.undefined();
    this.mass = JS.undefined();
    this.velocity = JS.undefined();
    this.duration = JS.undefined();
    this.bounce = JS.undefined();
    this.visualDuration = JS.undefined();
    this.restSpeed = JS.undefined();
    this.restDelta = JS.undefined();
  }
}

extern class AnimSpringOptions {
  JsValue keyframes;
  JsValue restSpeed;
  JsValue restDelta;
  JsValue? velocity;
  JsValue? stiffness;
  JsValue? damping;
  JsValue? mass;
  JsValue? duration;
  JsValue? bounce;
  JsValue visualDuration;
}

float calcAngularFreq(float undampedFreq, float dampingRatio) {
  return undampedFreq * (1.0 - dampingRatio * dampingRatio).sqrt();
}

export SpringGenerator spring(JsValue optionsOrVisualDuration, JsValue bounce) {
  JsValue? visualDuration = optionsOrVisualDuration;
  JsValue? bounceValue = bounce;
  AnimSpringOptions options = JS.assume(if (JS.typeOf(optionsOrVisualDuration) != "object") {
    JS.object(
      "visualDuration", visualDuration ?? 0.3,
      "keyframes", JS.array(0.0, 1.0),
      "bounce", bounceValue ?? 0.3
    )
  } else {
    optionsOrVisualDuration
  });
  float origin = JS.assume(options.keyframes[0]);
  float target = JS.assume(options.keyframes[options.keyframes.length - 1.0]);
  AnimGeneratorState state = JS.assume(JS.object("done", false, "value", origin));

  float velocity = -millisecondsToSeconds(JS.assume(JS.or(options.velocity, 0.0)));
  float stiffness = JS.assume(options.stiffness ?? 100.0);
  float damping = JS.assume(options.damping ?? 10.0);
  float mass = JS.assume(options.mass ?? 1.0);
  JsValue? duration = options.duration;
  bool isResolvedFromDuration = false;
  if (
    JS.isNullish(options.stiffness) && JS.isNullish(options.damping) && JS.isNullish(options.mass) &&
    !(JS.isNullish(duration) && JS.isNullish(options.bounce))
  ) {
    velocity = 0.0;
    mass = 1.0;
    if (options.visualDuration.truthy()) {
      float visualDuration = JS.assume(options.visualDuration);
      float root = (2.0 * 3.141592653589793) / (visualDuration * 1.2);
      stiffness = root * root;
      float bounceValue = JS.assume(JS.or(options.bounce, 0.0));
      damping = 2.0 * clamp(0.05, 1.0, 1.0 - bounceValue) * stiffness.sqrt();
    } else {
      // findSpring: approximate the spring that settles in `duration` with `bounce`.
      float findBounce = JS.assume(options.bounce ?? 0.3);
      float dampingRatio = clamp(0.05, 1.0, 1.0 - findBounce);
      float seconds = clamp(0.01, 10.0, millisecondsToSeconds(JS.assume(duration ?? 800.0)));
      float undampedFreq = 5.0 / seconds;
      for (int i = 1; i < 12; i++) {
        float exponentialDecay = undampedFreq * dampingRatio;
        float delta = exponentialDecay * seconds;
        float envelope = 0.0;
        float derivative = 0.0;
        if (dampingRatio < 1.0) {
          envelope = 0.001 - (exponentialDecay / calcAngularFreq(undampedFreq, dampingRatio)) * (-delta).exp();
          derivative = (if (-envelope + 0.001 > 0.0) { -1.0 } else { 1.0 }) *
            (-(dampingRatio * dampingRatio * (undampedFreq * undampedFreq) * seconds) * (-delta).exp()) /
            calcAngularFreq(undampedFreq * undampedFreq, dampingRatio);
        } else {
          envelope = -0.001 + (-undampedFreq * seconds).exp() * (undampedFreq * seconds + 1.0);
          derivative = (-undampedFreq * seconds).exp() * (-undampedFreq * (seconds * seconds));
        }
        undampedFreq = undampedFreq - envelope / derivative;
      }
      duration = secondsToMilliseconds(seconds);
      if (undampedFreq != undampedFreq) {
        stiffness = 100.0;
        damping = 10.0;
      } else {
        stiffness = undampedFreq * undampedFreq;
        damping = dampingRatio * 2.0 * stiffness.sqrt();
      }
      isResolvedFromDuration = true;
    }
  }

  float dampingRatio = damping / (2.0 * (stiffness * mass).sqrt());
  float initialDelta = target - origin;
  float undampedAngularFreq = millisecondsToSeconds((stiffness / mass).sqrt());
  bool isGranularScale = initialDelta.abs() < 5.0;
  float restSpeed = JS.assume(JS.or(options.restSpeed, if (isGranularScale) { 0.01 } else { 2.0 }));
  float restDelta = JS.assume(JS.or(options.restDelta, if (isGranularScale) { 0.005 } else { 0.5 }));

  float angularFreq = calcAngularFreq(undampedAngularFreq, dampingRatio);
  float dampedAngularFreq = undampedAngularFreq * (dampingRatio * dampingRatio - 1.0).sqrt();
  float A = (velocity + dampingRatio * undampedAngularFreq * initialDelta) /
    (if (dampingRatio < 1.0) { angularFreq } else { dampedAngularFreq });
  float sinCoeff = dampingRatio * undampedAngularFreq * A + initialDelta * angularFreq;
  float cosCoeff = dampingRatio * undampedAngularFreq * initialDelta - A * angularFreq;
  float sinhCoeff = dampingRatio * undampedAngularFreq * A - initialDelta * dampedAngularFreq;
  float coshCoeff = dampingRatio * undampedAngularFreq * initialDelta - A * dampedAngularFreq;
  float C = velocity + undampedAngularFreq * initialDelta;

  func(float)->float resolveSpring = (float t) => {
    float envelope = (-dampingRatio * undampedAngularFreq * t).exp();
    if (dampingRatio < 1.0) {
      return target - envelope * (A * (angularFreq * t).sin() + initialDelta * (angularFreq * t).cos());
    }
    if (dampingRatio == 1.0) {
      return target - (-undampedAngularFreq * t).exp() * (initialDelta + C * t);
    }
    float freqForT = (dampedAngularFreq * t).min(300.0);
    return target -
      (envelope * ((velocity + dampingRatio * undampedAngularFreq * initialDelta) * sinh(freqForT) +
        dampedAngularFreq * initialDelta * cosh(freqForT))) / dampedAngularFreq;
  };
  func(float)->float resolveVelocity = (float t) => {
    float envelope = (-dampingRatio * undampedAngularFreq * t).exp();
    if (dampingRatio < 1.0) {
      return envelope * (sinCoeff * (angularFreq * t).sin() + cosCoeff * (angularFreq * t).cos());
    }
    if (dampingRatio == 1.0) {
      return (-undampedAngularFreq * t).exp() * (undampedAngularFreq * C * t - velocity);
    }
    float freqForT = (dampedAngularFreq * t).min(300.0);
    return envelope * (sinhCoeff * sinh(freqForT) + coshCoeff * cosh(freqForT));
  };

  SpringGenerator gen = JS.assume(JS.object(
    "calculatedDuration", if (isResolvedFromDuration) { JS.or(duration, null) } else { null },
    "velocity", (float t) => secondsToMilliseconds(resolveVelocity(t)),
    "next", (float t) => {
      float current = 0.0;
      if (!isResolvedFromDuration && dampingRatio < 1.0) {
        float envelope = (-dampingRatio * undampedAngularFreq * t).exp();
        float sin = (angularFreq * t).sin();
        float cos = (angularFreq * t).cos();
        current = target - envelope * (A * sin + initialDelta * cos);
        state.done = secondsToMilliseconds(envelope * (sinCoeff * sin + cosCoeff * cos)).abs() <= restSpeed &&
          (target - current).abs() <= restDelta;
      } else {
        current = resolveSpring(t);
        float resolvedDuration = JS.assume(duration);
        state.done = if (isResolvedFromDuration) {
          t >= resolvedDuration
        } else {
          secondsToMilliseconds(resolveVelocity(t)).abs() <= restSpeed && (target - current).abs() <= restDelta
        };
      }
      state.value = if (state.done) { target } else { current };
      return state;
    },
    "toTransition", () => {}
  ));
  JS.set(gen, "toString", () => {
    float calculatedDuration = calcGeneratorDuration(gen).min(maxGeneratorDuration);
    return calculatedDuration + "ms " + generateLinearEasing(
      (float progress) => {
        float value = JS.assume(gen.next(calculatedDuration * progress).value);
        return value;
      },
      calculatedDuration,
      30.0
    );
  });
  return gen;
}

JsValue applySpringToOptions(JsValue options) {
  GeneratorEasingResult easing = createGeneratorEasing(options, 100.0, spring);
  options["ease"] = easing.ease;
  options["duration"] = secondsToMilliseconds(easing.duration);
  options["type"] = "keyframes";
  return options;
}

JS.set(spring, "applyToOptions", applySpringToOptions);

export { spring as springFromInput };
