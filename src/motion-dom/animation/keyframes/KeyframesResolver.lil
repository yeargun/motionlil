import { frame } from "../../frameloop/frame";
import { FrameData } from "../../frameloop/types";
import { positionalKeys } from "../../render/utils/keys-position";
import { findDimensionValueType } from "../../value/types/dimensions";
import { ValueType } from "../../value/types/types";
import { visualElementOf } from "../../cast";
import { getComputedStyleValue, windowPageYOffset, windowScrollTo } from "../../dom-host";
import { getVariableValue } from "../utils/css-variables-conversion";
import { containsCSSVariable, isCSSVariableToken } from "../utils/is-css-variable";
import { fillWildcards } from "./utils/fill-wildcards";
import { isNone } from "./utils/is-none";
import { makeNoneKeyframesAnimatable } from "./utils/make-none-animatable";
import {
  isNumOrPxType,
  isPositionalValue,
  positionalValue,
  removeNonTranslationalTransform
} from "./utils/unit-conversion";

extern float parseFloat(JsValue v);

export extern class AnimResolverState {
  JsValue unresolvedKeyframes;
  func(JsValue, JsValue, bool)->void onComplete;
  JsValue name;
  JsValue motionValue;
  JsValue element;
  bool isAsync;
  string state;
  bool needsMeasurement;
  JsValue finalKeyframe;
  float? suspendedScrollY;
  JsValue measuredOrigin;
}

AnimResolverState resolverStateOf(JsValue value) {
  return JS.assume(value);
}

KeyframeResolver[] toResolve = [];
bool isScheduled = false;
bool anyNeedsMeasurement = false;
bool isForced = false;

void removeResolver(KeyframeResolver resolver) {
  int index = toResolve.indexOf(resolver);
  if (index > -1) {
    toResolve.splice(index, 1);
  }
}

void measureAllKeyframes(FrameData _data) {
  if (anyNeedsMeasurement) {
    KeyframeResolver[] resolversToMeasure = toResolve.filter((KeyframeResolver resolver) => resolverStateOf(resolver).needsMeasurement);
    JsValue[] elementsToMeasure = [];
    resolversToMeasure.forEach((KeyframeResolver resolver) => {
      JsValue element = resolverStateOf(resolver).element;
      if (!elementsToMeasure.includes(element)) {
        elementsToMeasure.push(element);
      }
    });
    Map<JsValue, JsValue[]> transformsToRestore = new Map<JsValue, JsValue[]>();
    elementsToMeasure.forEach((JsValue element) => {
      JsValue[] removedTransforms = removeNonTranslationalTransform(element);
      if (removedTransforms.length > 0) {
        transformsToRestore.set(element, removedTransforms);
        visualElementOf(element).render();
      }
    });
    resolversToMeasure.forEach((KeyframeResolver resolver) => {
      resolver.measureInitialState();
    });
    elementsToMeasure.forEach((JsValue element) => {
      visualElementOf(element).render();
      JsValue[]? restore = transformsToRestore.get(element);
      if (restore != null) {
        restore.forEach((JsValue pair) => {
          JsValue? value = visualElementOf(element).getValue(JS.assume(pair[0]));
          if (value != null) {
            JS.invoke(value, "set", pair[1]);
          }
        });
      }
    });
    resolversToMeasure.forEach((KeyframeResolver resolver) => {
      resolver.measureEndState();
    });
    resolversToMeasure.forEach((KeyframeResolver resolver) => {
      float? scrollY = resolverStateOf(resolver).suspendedScrollY;
      if (scrollY != null) {
        windowScrollTo(0.0, scrollY);
      }
    });
  }
  anyNeedsMeasurement = false;
  isScheduled = false;
  toResolve.slice().forEach((KeyframeResolver resolver) => {
    resolver.complete(isForced);
  });
  toResolve.splice(0, toResolve.length);
}

void readAllKeyframes(FrameData _data) {
  toResolve.forEach((KeyframeResolver resolver) => {
    resolver.readKeyframes();
    if (resolverStateOf(resolver).needsMeasurement) {
      anyNeedsMeasurement = true;
    }
  });
}

export void flushKeyframeResolvers() {
  isForced = true;
  FrameData data = new FrameData();
  readAllKeyframes(data);
  measureAllKeyframes(data);
  isForced = false;
}

// One class for both resolvers: DOM resolution (the async kind) reads CSS
// variables, "none" values and positional units as upstream's subclass does.
export class KeyframeResolver {
  init(
    JsValue unresolvedKeyframes,
    func(JsValue, JsValue, bool)->void onComplete,
    JsValue name,
    JsValue motionValue,
    JsValue element,
    bool isAsync
  ) {
    AnimResolverState s = resolverStateOf(this);
    s.state = "pending";
    s.needsMeasurement = false;
    s.unresolvedKeyframes = JS.invoke(unresolvedKeyframes, "slice");
    s.onComplete = onComplete;
    s.name = name;
    s.motionValue = motionValue;
    s.element = element;
    s.isAsync = isAsync;
    s.finalKeyframe = JS.undefined();
    s.suspendedScrollY = null;
  }

  void scheduleResolve() {
    AnimResolverState s = resolverStateOf(this);
    s.state = "scheduled";
    if (s.isAsync) {
      if (!toResolve.includes(this)) {
        toResolve.push(this);
      }
      if (!isScheduled) {
        isScheduled = true;
        frame.read(readAllKeyframes, false, false);
        frame.resolveKeyframes(measureAllKeyframes, false, false);
      }
    } else {
      this.readKeyframes();
      this.complete(false);
    }
  }

  void readKeyframes() {
    AnimResolverState s = resolverStateOf(this);
    JsValue unresolvedKeyframes = s.unresolvedKeyframes;
    JsValue element = s.element;
    JsValue name = s.name;
    if (s.isAsync && !(element.truthy() && element["current"].truthy())) {
      return;
    }
    JsValue motionValue = s.motionValue;
    if (JS.strictEqual(unresolvedKeyframes[0], null)) {
      JsValue currentValue = if (motionValue.truthy()) { JS.invoke(motionValue, "get") } else { JS.undefined() };
      JsValue finalKeyframe = unresolvedKeyframes[unresolvedKeyframes.length - 1.0];
      if (!JS.isNullish(currentValue)) {
        unresolvedKeyframes[0] = currentValue;
      } else if (element.truthy() && name.truthy()) {
        JsValue valueAsRead = visualElementOf(element).readValue(JS.assume(name), finalKeyframe);
        if (!JS.isNullish(valueAsRead)) {
          unresolvedKeyframes[0] = valueAsRead;
        }
      }
      if (JS.isUndefined(unresolvedKeyframes[0])) {
        unresolvedKeyframes[0] = finalKeyframe;
      }
      if (motionValue.truthy() && JS.isNullish(currentValue)) {
        JS.invoke(motionValue, "set", unresolvedKeyframes[0]);
      }
    }
    fillWildcards(unresolvedKeyframes);
    if (!s.isAsync) {
      return;
    }
    JsValue current = element["current"];
    for (float i = 0.0; i < unresolvedKeyframes.length; i++) {
      JsValue keyframe = unresolvedKeyframes[i];
      if (keyframe is string) {
        string trimmed = keyframe.trim();
        if (isCSSVariableToken(trimmed)) {
          JsValue resolved = getVariableValue(trimmed, current);
          if (!JS.isUndefined(resolved)) {
            unresolvedKeyframes[i] = resolved;
          }
          if (i == unresolvedKeyframes.length - 1.0) {
            s.finalKeyframe = trimmed;
          }
        }
      }
    }
    this.resolveNoneKeyframes();
    if (!(name is string && positionalKeys.has(name) && unresolvedKeyframes.length == 2.0)) {
      return;
    }
    JsValue origin = unresolvedKeyframes[0];
    JsValue target = unresolvedKeyframes[1];
    ValueType? originType = findDimensionValueType(origin);
    ValueType? targetType = findDimensionValueType(target);
    if (containsCSSVariable(origin) != containsCSSVariable(target) && isPositionalValue(name)) {
      s.needsMeasurement = true;
      return;
    }
    if (originType == targetType) {
      return;
    }
    if (isNumOrPxType(originType) && isNumOrPxType(targetType)) {
      for (float i = 0.0; i < unresolvedKeyframes.length; i++) {
        JsValue value = unresolvedKeyframes[i];
        if (value is string) {
          unresolvedKeyframes[i] = parseFloat(value);
        }
      }
    } else if (isPositionalValue(name)) {
      s.needsMeasurement = true;
    }
  }

  void resolveNoneKeyframes() {
    AnimResolverState s = resolverStateOf(this);
    JsValue unresolvedKeyframes = s.unresolvedKeyframes;
    int[] noneKeyframeIndexes = [];
    for (int i = 0; i < unresolvedKeyframes.length; i++) {
      if (isNone(unresolvedKeyframes[i])) {
        noneKeyframeIndexes.push(i);
      }
    }
    if (noneKeyframeIndexes.length > 0) {
      makeNoneKeyframesAnimatable(unresolvedKeyframes, noneKeyframeIndexes, s.name);
    }
  }

  void measureInitialState() {
    AnimResolverState s = resolverStateOf(this);
    JsValue element = s.element;
    string name = JS.assume(s.name);
    JsValue current = element["current"];
    if (!current.truthy()) {
      return;
    }
    if (name == "height") {
      s.suspendedScrollY = windowPageYOffset();
    }
    JsValue unresolvedKeyframes = s.unresolvedKeyframes;
    s.measuredOrigin = positionalValue(name, visualElementOf(element).measureViewportBox(), getComputedStyleValue(current));
    unresolvedKeyframes[0] = s.measuredOrigin;
    JsValue measureKeyframe = unresolvedKeyframes[unresolvedKeyframes.length - 1.0];
    if (!JS.isUndefined(measureKeyframe)) {
      JS.invoke(visualElementOf(element).getValue(name, measureKeyframe, true), "jump", measureKeyframe, false);
    }
  }

  void measureEndState() {
    AnimResolverState s = resolverStateOf(this);
    JsValue element = s.element;
    string name = JS.assume(s.name);
    JsValue current = element["current"];
    if (!current.truthy()) {
      return;
    }
    JsValue? value = visualElementOf(element).getValue(name);
    if (value != null) {
      JS.invoke(value, "jump", s.measuredOrigin, false);
    }
    JsValue unresolvedKeyframes = s.unresolvedKeyframes;
    float finalKeyframeIndex = unresolvedKeyframes.length - 1.0;
    JsValue finalKeyframe = unresolvedKeyframes[finalKeyframeIndex];
    unresolvedKeyframes[finalKeyframeIndex] = positionalValue(name, visualElementOf(element).measureViewportBox(), getComputedStyleValue(current));
    if (JS.strictNotEqual(finalKeyframe, null) && JS.isUndefined(s.finalKeyframe)) {
      s.finalKeyframe = finalKeyframe;
    }
    this.resolveNoneKeyframes();
  }

  void complete(bool isForcedComplete) {
    AnimResolverState s = resolverStateOf(this);
    s.state = "complete";
    s.onComplete(s.unresolvedKeyframes, s.finalKeyframe, isForcedComplete);
    removeResolver(this);
  }

  void cancel() {
    AnimResolverState s = resolverStateOf(this);
    if (s.state == "scheduled") {
      removeResolver(this);
      s.state = "pending";
    }
  }

  void resume() {
    AnimResolverState s = resolverStateOf(this);
    if (s.state == "pending") {
      this.scheduleResolve();
    }
  }
}
