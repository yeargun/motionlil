import { progress } from "../../../../motion-utils/progress";
import { mixNumber } from "../../../utils/mix/number";

export void fillOffset(float[] offset, float remaining) {
  float min = offset[offset.length - 1];
  for (float i = 1.0; i <= remaining; i++) {
    offset.push(mixNumber(min, 1.0, progress(0.0, remaining, i)));
  }
}
