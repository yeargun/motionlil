import { analyseComplexValue } from "../../../value/types/complex/index";
import { getAnimatableNone } from "../../../value/types/utils/animatable-none";

export void makeNoneKeyframesAnimatable(
  JsValue unresolvedKeyframes,
  int[] noneKeyframeIndexes,
  JsValue name
) {
  JsValue animatableTemplate = JS.undefined();
  for (float i = 0.0; i < unresolvedKeyframes.length && !animatableTemplate.truthy(); i++) {
    JsValue keyframe = unresolvedKeyframes[i];
    if (keyframe is string && keyframe != "auto" && keyframe != "none" && keyframe != "0" && analyseComplexValue(keyframe).values.length > 0) {
      animatableTemplate = keyframe;
    }
  }
  if (animatableTemplate.truthy() && name.truthy()) {
    noneKeyframeIndexes.forEach((int noneIndex) => {
      unresolvedKeyframes[noneIndex] = getAnimatableNone(JS.assume(name), animatableTemplate);
    });
  }
}
