import { parseValueFromTransform } from "../../../render/dom/parse-transform";
import { transformPropOrder } from "../../../render/utils/keys-transform";
import { numberType } from "../../../value/types/numbers/index";
import { px } from "../../../value/types/numbers/units";
import { ValueType } from "../../../value/types/types";
import { visualElementOf } from "../../../cast";

extern float parseFloat(string v);

export bool isNumOrPxType(ValueType? v) {
  return v == numberType || v == px;
}

export JsValue[] removeNonTranslationalTransform(JsValue visualElement) {
  JsValue[] removedTransforms = [];
  transformPropOrder.forEach((string key) => {
    if (key != "x" && key != "y" && key != "z") {
      JsValue? value = visualElementOf(visualElement).getValue(key);
      if (value != null) {
        removedTransforms.push(JS.array(key, JS.invoke(value, "get")));
        JS.invoke(value, "set", if (key.startsWith("scale")) { 1.0 } else { 0.0 });
      }
    }
  });
  return removedTransforms;
}

float measureAxis(JsValue axis, JsValue style, string start, string end) {
  float min = JS.assume(axis["min"]);
  float max = JS.assume(axis["max"]);
  float size = max - min;
  return if (JS.strictEqual(style["boxSizing"], "border-box")) {
    size
  } else {
    size - parseFloat(JS.assume(JS.or(style[start], "0"))) - parseFloat(JS.assume(JS.or(style[end], "0")))
  };
}

float axisLength(JsValue axis) {
  float min = JS.assume(axis["min"]);
  float max = JS.assume(axis["max"]);
  return max - min;
}

float measureTransform(JsValue style, string axis) {
  return parseValueFromTransform(JS.assume(style["transform"]), axis);
}

// positionalValues[name](box, computedStyle), or null for other values.
export JsValue positionalValue(string name, JsValue bbox, JsValue style) {
  if (name == "width") {
    return measureAxis(bbox["x"], style, "paddingLeft", "paddingRight");
  }
  if (name == "height") {
    return measureAxis(bbox["y"], style, "paddingTop", "paddingBottom");
  }
  if (name == "top") {
    return parseFloat(JS.assume(style["top"]));
  }
  if (name == "left") {
    return parseFloat(JS.assume(style["left"]));
  }
  if (name == "bottom") {
    return parseFloat(JS.assume(style["top"])) + axisLength(bbox["y"]);
  }
  if (name == "right") {
    return parseFloat(JS.assume(style["left"])) + axisLength(bbox["x"]);
  }
  if (name == "x" || name == "translateX") {
    return measureTransform(style, "x");
  }
  return measureTransform(style, "y");
}

export bool isPositionalValue(string name) {
  return ["width", "height", "top", "left", "bottom", "right", "x", "y", "translateX", "translateY"].includes(name);
}
