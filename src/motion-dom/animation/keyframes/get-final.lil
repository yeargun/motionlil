extern class AnimRepeatOptions {
  JsValue repeat;
  JsValue? repeatType;
}

export JsValue getFinalKeyframe(
  JsValue keyframes,
  JsValue options,
  JsValue? finalKeyframe,
  float speed
) {
  JsValue resolved = JS.invoke(keyframes, "filter", (JsValue v) => JS.strictNotEqual(v, null));
  AnimRepeatOptions o = JS.assume(options);
  float index = if (speed < 0.0 || (o.repeat.truthy() && (o.repeatType ?? "loop") != "loop" && JS.strictEqual(JS.mod(o.repeat, 2.0), 1.0))) {
    0.0
  } else {
    resolved.length - 1.0
  };
  return if (index == 0.0 || finalKeyframe == null) { resolved[index] } else { finalKeyframe };
}
