extern class AnimRepeatOptions {
  JsValue repeat;
  JsValue repeatType;
}

// Upstream's getFinalKeyframe: `repeatType` defaults to "loop" and
// `finalKeyframe` is used only when it is not `undefined` (a `null` is a
// value), as its destructuring default and `=== undefined` test decide.
export JsValue getFinalKeyframe(
  JsValue keyframes,
  JsValue options,
  JsValue finalKeyframe = JS.undefined(),
  float speed = 1.0
) {
  JsValue resolved = JS.invoke(keyframes, "filter", (JsValue v) => JS.strictNotEqual(v, null));
  AnimRepeatOptions o = JS.assume(options);
  JsValue repeatType = o.repeatType;
  bool useFirstKeyframe = speed < 0.0 || (
    o.repeat.truthy() &&
    !JS.isUndefined(repeatType) && JS.strictNotEqual(repeatType, "loop") &&
    JS.strictEqual(JS.mod(o.repeat, 2.0), 1.0)
  );
  float index = if (useFirstKeyframe) { 0.0 } else { resolved.length - 1.0 };
  return if (index == 0.0 || JS.isUndefined(finalKeyframe)) { resolved[index] } else { finalKeyframe };
}
