export JsValue getFinalKeyframe(
  JsValue keyframesInput,
  JsValue options,
  JsValue finalKeyframe = JS.undefined(),
  float speed = 1.0
) {
  JsValue[] keyframes = JS.assume(keyframesInput);
  JsValue[] resolvedKeyframes = keyframes.filter((JsValue value) => !JS.strictEqual(value, null));
  JsValue repeat = options["repeat"];
  JsValue repeatType = options["repeatType"];
  if (JS.isUndefined(repeatType)) { repeatType = "loop"; }
  bool useFirstKeyframe = speed < 0.0 || (repeat.truthy() && !JS.strictEqual(repeatType, "loop") && JS.strictEqual(JS.mod(repeat, 2), 1));
  int index = resolvedKeyframes.length - 1;
  if (useFirstKeyframe) { index = 0; }
  if (index == 0 || JS.isUndefined(finalKeyframe)) { return resolvedKeyframes[index]; }
  return finalKeyframe;
}
