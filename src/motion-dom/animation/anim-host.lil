import extern {
  animAssign2,
  animAssign3,
  animDefineProperties,
  animSinh,
  animCosh,
  animNewPromise,
  animPromiseAll,
  animArrayFrom
} from "./anim-host.ts";

export extern JsValue animAssign2(JsValue target, JsValue source);
export extern JsValue animAssign3(JsValue target, JsValue a, JsValue b);
