import extern {
  animAssign2,
  animAssign3,
  animDefineProperties,
  animSinh,
  animCosh,
  animNewPromise,
  animPromiseAll,
  animArrayFrom,
  animClass,
  animAdopt,
  animCreate,
  animArity
} from "./anim-host.ts";

export extern JsValue animAssign2(JsValue target, JsValue source);
export extern JsValue animAssign3(JsValue target, JsValue a, JsValue b);
export extern JsValue animDefineProperties(JsValue target, JsValue props);
export extern float animSinh(float x);
export extern float animCosh(float x);
export extern Task<bool> animNewPromise(func(func()->void)->void executor);
export extern Task<bool> animPromiseAll(JsValue values);
export extern JsValue animArrayFrom(JsValue values);
export extern JsValue animClass(func(JsValue, JsValue)->JsValue construct, JsValue prototype, JsValue surface);
export extern void animAdopt(JsValue value, JsValue prototype);
export extern JsValue animCreate(JsValue prototype);
export extern JsValue animArity(JsValue method, float length);
