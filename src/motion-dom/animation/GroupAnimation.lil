import { animAdopt, animClass, animPromiseAll as promiseAll } from "./anim-host";

// Upstream's GroupAnimation.prototype: every group is created on it.
export JsValue groupAnimationPrototype = JS.object();

JsValue finishedOf(JsValue group) {
  return promiseAll(JS.invoke(group["animations"], "map", (JsValue animation) => animation["finished"]));
}

JsValue getAll(JsValue group, string propName) {
  return group["animations"][0][propName];
}

void setAll(JsValue group, string propName, JsValue newValue) {
  JsValue animations = group["animations"];
  for (float i = 0.0; i < animations.length; i++) {
    animations[i][propName] = newValue;
  }
}

float getMax(JsValue group, string propName) {
  JsValue animations = group["animations"];
  float max = 0.0;
  for (float i = 0.0; i < animations.length; i++) {
    JsValue value = animations[i][propName];
    float numeric = JS.assume(value);
    if (JS.strictNotEqual(value, null) && numeric > max) {
      max = numeric;
    }
  }
  return max;
}

JsValue runAll(JsValue group, string methodName) {
  JS.invoke(group["animations"], "forEach", (JsValue controls) => JS.invoke(controls, methodName));
  return JS.undefined();
}

JsValue groupSurface = JS.object(
  "finished", JS.object("get", JS.method0((JsValue self) => finishedOf(self))),
  "time", JS.object(
    "get", JS.method0((JsValue self) => getAll(self, "time")),
    "set", JS.method1((JsValue self, JsValue value) => {
      setAll(self, "time", value);
      return JS.undefined();
    })
  ),
  "speed", JS.object(
    "get", JS.method0((JsValue self) => getAll(self, "speed")),
    "set", JS.method1((JsValue self, JsValue value) => {
      setAll(self, "speed", value);
      return JS.undefined();
    })
  ),
  "state", JS.object("get", JS.method0((JsValue self) => getAll(self, "state"))),
  "startTime", JS.object("get", JS.method0((JsValue self) => getAll(self, "startTime"))),
  "duration", JS.object("get", JS.method0((JsValue self) => getMax(self, "duration"))),
  "iterationDuration", JS.object("get", JS.method0((JsValue self) => getMax(self, "iterationDuration"))),
  "attachTimeline", JS.object("value", JS.method1((JsValue self, JsValue timeline) => {
    JsValue animations = self["animations"];
    JsValue subscriptions = JS.invoke(animations, "map", (JsValue animation) => JS.invoke(animation, "attachTimeline", timeline));
    return () => {
      for (float i = 0.0; i < subscriptions.length; i++) {
        JsValue cancel = subscriptions[i];
        if (cancel.truthy()) {
          JS.call(cancel, JS.undefined());
        }
        JS.invoke(animations[i], "stop");
      }
    };
  })),
  "play", JS.object("value", JS.method0((JsValue self) => runAll(self, "play"))),
  "pause", JS.object("value", JS.method0((JsValue self) => runAll(self, "pause"))),
  "cancel", JS.object("value", JS.method0((JsValue self) => runAll(self, "cancel"))),
  "complete", JS.object("value", JS.method0((JsValue self) => runAll(self, "complete")))
);

export class GroupAnimation {
  JsValue[] animations;

  init(JsValue[] animations, JsValue prototype = groupAnimationPrototype) {
    animAdopt(this, prototype);
    GroupAnimation self = this;
    JS.set(this, "stop", () => {
      runAll(self, "stop");
    });
    this.animations = animations.filter((JsValue animation) => animation.truthy());
  }

  Task<bool> finished() {
    return JS.assume(finishedOf(this));
  }
}

// Upstream's public `GroupAnimation` class (`new GroupAnimation(animations)`).
export JsValue groupAnimationConstructor = animClass(
  (JsValue animations, JsValue _unused) => new GroupAnimation(JS.assume(animations)),
  groupAnimationPrototype,
  groupSurface
);
