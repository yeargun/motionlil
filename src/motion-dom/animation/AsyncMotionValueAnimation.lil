import { asyncOptions } from "./utils/control-abi";
import { animationOptionsOf } from "./utils/typed-options";
import { NativeAnimationExtended } from "./NativeAnimationExtended";
import { supportsResolvedBrowserAnimation } from "./waapi/supports/waapi";
import { readNumberUpdate } from "./timing";
import { WithPromise } from "./utils/WithPromise";
import { JSAnimation, JSAnimationOptions } from "./JSAnimationFull";
import { KeyframeResolver, flushKeyframeResolvers } from "./keyframes/KeyframesResolver";
import { createDOMKeyframesResolver } from "./keyframes/DOMKeyframesResolver";
import { getFinalKeyframe } from "./keyframes/get-final";
import { canAnimate } from "./utils/can-animate";
import { makeAnimationInstant } from "./utils/make-animation-instant";
import { time } from "../frameloop/sync-time";
import { MotionGlobalConfig } from "../../motion-utils/global-config";
import { isNumericalString } from "../../motion-utils/is-numerical-string";
import { callFn0, callFn1, isFunction, getProp, callMethod0, callMethod1, setProp } from "../dom-host";
import { isGenerator } from "./generators/utils/is-generator";
import extern { identity as asWithPromise } from "../cast-host.ts";

extern WithPromise asWithPromise(JsValue value);
extern float parseFloat(string value);

float MAX_RESOLVE_DELAY = 40.0;

export class AsyncMotionValueAnimation extends WithPromise {
  JsValue options;
  JsValue? animation;
  KeyframeResolver? resolver;
  float createdAt;
  float? resolvedAt;
  JsValue? pendingTimeline;
  (func()->void)? stopTimeline;
  bool isStopped;

  init(JsValue options) {
    super();
    this.options = asyncOptions(options);
    this.animation = null;
    this.resolver = null;
    this.createdAt = time.now();
    this.resolvedAt = null;
    this.pendingTimeline = null;
    this.stopTimeline = null;
    this.isStopped = false;
    this.createAnimation();
    AsyncMotionValueAnimation selfControls = this;
    setProp(this, "stop", () => { selfControls.stopAnimation(); });
  }

  JsValue getPlaybackTime() { return callMethod0(this.getAnimation(), "getPlaybackTime"); }
  JsValue getPlaybackSpeed() { return callMethod0(this.getAnimation(), "getPlaybackSpeed"); }
  JsValue getState() { return callMethod0(this.getAnimation(), "getState"); }
  JsValue getStartTime() { return callMethod0(this.getAnimation(), "getStartTime"); }
  JsValue getIterationDuration() { return callMethod0(this.getAnimation(), "getIterationDuration"); }
  JsValue getDuration() { return callMethod0(this.getAnimation(), "getDuration"); }
  void setPlaybackTime(float value) { callMethod1(this.getAnimation(), "setPlaybackTime", value); }
  void setPlaybackSpeed(float value) { callMethod1(this.getAnimation(), "setPlaybackSpeed", value); }

  void createAnimation() {
    JsValue options = this.options;
    JsValue[] unresolved = animationOptionsOf(options).keyframes;
    string? name = animationOptionsOf(options).name;
    JsValue motionValue = animationOptionsOf(options).motionValue;
    JsValue element = animationOptionsOf(options).element;
    AsyncMotionValueAnimation self = this;

    func(JsValue[], JsValue?, bool)->void onKeyframesResolved = (
      JsValue[] resolvedKeyframes,
      JsValue? finalKeyframe,
      bool forced
    ) => {
      self.onKeyframesResolved(resolvedKeyframes, finalKeyframe, !forced);
    };

    KeyframeResolver resolver = new KeyframeResolver(
      unresolved,
      onKeyframesResolved,
      name,
      motionValue,
      element,
      false
    );
    if (element.truthy()) {
      resolver = createDOMKeyframesResolver(
        unresolved,
        onKeyframesResolved,
        name,
        motionValue,
        element
      );
    }
    this.resolver = resolver;
    resolver.scheduleResolve();
  }

  void onKeyframesResolved(
    JsValue[] keyframes,
    JsValue? finalKeyframe,
    bool sync
  ) {
    this.resolver = null;
    JsValue options = this.options;
    this.resolvedAt = time.now();

    string? name = animationOptionsOf(options).name;
    JsValue type = options["type"];
    float velocity = animationOptionsOf(options).velocity ?? 0.0;
    float delay = animationOptionsOf(options).delay ?? 0.0;
    bool isHandoff = options["isHandoff"].truthy();
    JsValue onUpdate = options["onUpdate"];

    bool canAnimateValue = true;
    if (!canAnimate(keyframes, name, type, velocity)) {
      canAnimateValue = false;
      if (MotionGlobalConfig.instantAnimations == true || delay == 0.0) {
        if (isFunction(onUpdate)) {
          callFn1(onUpdate, getFinalKeyframe(keyframes, options, finalKeyframe));
        }
      }
      if (keyframes.length > 0) {
        keyframes[0] = keyframes[keyframes.length - 1];
      }
      makeAnimationInstant(options);
      options["repeat"] = 0.0;
    }

    float? startTime = null;
    if (sync) {
      float? resolved = this.resolvedAt;
      if (resolved == null) {
        startTime = this.createdAt;
      } else if (resolved - this.createdAt > MAX_RESOLVE_DELAY) {
        startTime = resolved;
      } else {
        startTime = this.createdAt;
      }
    }

    options["keyframes"] = keyframes;
    if (finalKeyframe != null) {
      options["finalKeyframe"] = finalKeyframe;
    }
    if (startTime != null) {
      options["startTime"] = startTime;
    }

    JsValue motionValue = options["motionValue"];
    JsValue element = options["element"];
    if (motionValue.truthy()) {
      JsValue owner = motionValue["owner"];
      if (owner.truthy() && owner["current"].truthy()) {
        element = owner["current"];
        options["element"] = element;
      }
    }

    JsValue animation = null;
    if (canAnimateValue && !isHandoff && supportsResolvedBrowserAnimation(options, keyframes)) {
      try {
        NativeAnimationExtended native = new NativeAnimationExtended(options);
        animation = native;
      } catch {
        // Motion falls back to its JS driver if native animation construction fails.
      }
    }
    if (animation == null) {
      JSAnimation jsAnim = new JSAnimation(options);
      animation = jsAnim;
    }

    AsyncMotionValueAnimation self = this;
    asWithPromise(animation).getFinished().then((JsValue _v) => {
      self.notifyFinished();
      return true;
    });

    if (this.pendingTimeline != null) {
      JsValue attach = getProp(animation, "attachTimeline");
      if (isFunction(attach)) {
        JsValue cancel = callMethod1(animation, "attachTimeline", this.pendingTimeline);
        if (isFunction(cancel)) {
          this.stopTimeline = () => {
            callFn0(cancel);
          };
        }
      }
      this.pendingTimeline = null;
    }

    this.animation = animation;
    this.finishedHook = () => asWithPromise(animation).getFinished();
  }

  JsValue getAnimation() {
    if (this.animation == null) {
      KeyframeResolver? resolver = this.resolver;
      if (resolver != null) {
        resolver.resume();
      }
      flushKeyframeResolvers();
    }
    return this.animation;
  }

  func()->void attachTimeline(JsValue timeline) {
    JsValue? animation = this.animation;
    if (animation != null) {
      JsValue attach = getProp(animation, "attachTimeline");
      if (isFunction(attach)) {
        JsValue cancel = callMethod1(animation, "attachTimeline", timeline);
        if (isFunction(cancel)) {
          this.stopTimeline = () => {
            callFn0(cancel);
          };
        }
      }
    } else {
      this.pendingTimeline = timeline;
    }
    AsyncMotionValueAnimation self = this;
    return () => {
      self.stop();
    };
  }

  void play() {
    JsValue animation = this.getAnimation();
    if (animation.truthy()) {
      callMethod0(animation, "play");
    }
  }

  void pause() {
    JsValue animation = this.getAnimation();
    if (animation.truthy()) {
      callMethod0(animation, "pause");
    }
  }

  void complete() {
    JsValue animation = this.getAnimation();
    if (animation.truthy()) {
      callMethod0(animation, "complete");
    }
  }

  void cancel() {
    JsValue? animation = this.animation;
    if (animation != null) {
      callMethod0(animation, "cancel");
    }
    KeyframeResolver? resolver = this.resolver;
    if (resolver != null) {
      resolver.cancel();
    }
  }

  void stop() { this.stopAnimation(); }

  void stopAnimation() {
    this.isStopped = true;
    if (this.animation != null) { callMethod0(this.animation, "stop"); }
    (func()->void)? stopTimeline = this.stopTimeline;
    if (stopTimeline != null) {
      stopTimeline();
    }
    KeyframeResolver? resolver = this.resolver;
    if (resolver != null) {
      resolver.cancel();
    }
  }

  float sample(float sampleTime) {
    JsValue animation = this.getAnimation();
    if (animation.truthy()) {
      JsValue result = callMethod1(animation, "sample", sampleTime);
      if (result.isObject()) {
        JsValue value = result["value"];
        if (value is float) {
          return value;
        }
      }
    }
    return 0.0;
  }
}

export constructor AsyncMotionValueAnimation as AsyncMotionValueAnimationConstructor;
