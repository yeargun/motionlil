import { MotionGlobalConfig } from "../../motion-utils/global-config";
import { time } from "../frameloop/sync-time";
import { createJSAnimation } from "./JSAnimation";
import { getFinalKeyframe } from "./keyframes/get-final";
import { KeyframeResolver, flushKeyframeResolvers } from "./keyframes/KeyframesResolver";
import { NativeAnimationExtended } from "./NativeAnimationExtended";
import { canAnimate } from "./utils/can-animate";
import { makeAnimationInstant } from "./utils/make-animation-instant";
import { promiseStateOf, updateFinished } from "./utils/WithPromise";
import { supportsBrowserAnimation } from "./waapi/supports/waapi";
import { animAssign2 as assign2, animClass, animCreate } from "./anim-host";

// Upstream's AsyncMotionValueAnimation.prototype: every instance is created on it.
JsValue asyncPrototype = JS.object();

extern class AnimAsyncOptions {
  JsValue? autoplay;
  JsValue? delay;
  JsValue? type;
  JsValue? repeat;
  JsValue? repeatDelay;
  JsValue? repeatType;
  JsValue keyframes;
  JsValue name;
  JsValue motionValue;
  JsValue element;
  JsValue velocity;
  JsValue isHandoff;
  JsValue onUpdate;
}

// An AsyncMotionValueAnimation is an ordinary object carrying upstream's
// fields and surface.
export extern class AsyncMotionValueAnimation {
  JsValue _animation;
  KeyframeResolver? keyframeResolver;
  float createdAt;
  float resolvedAt;
  JsValue pendingTimeline;
  JsValue stopTimeline;
}

AsyncMotionValueAnimation asyncOf(JsValue value) {
  return JS.assume(value);
}

JsValue getAnimation(JsValue self) {
  AsyncMotionValueAnimation a = asyncOf(self);
  if (!a._animation.truthy()) {
    KeyframeResolver? resolver = a.keyframeResolver;
    if (resolver != null) {
      resolver.resume();
    }
    flushKeyframeResolvers();
  }
  return a._animation;
}

JsValue stopAsync(JsValue self) {
  AsyncMotionValueAnimation a = asyncOf(self);
  JsValue animation = a._animation;
  if (animation.truthy()) {
    JS.invoke(animation, "stop");
    if (a.stopTimeline.truthy()) {
      JS.call(a.stopTimeline, JS.undefined());
    }
  }
  KeyframeResolver? resolver = a.keyframeResolver;
  if (resolver != null) {
    resolver.cancel();
  }
  return JS.undefined();
}

void onKeyframesResolved(AsyncMotionValueAnimation a, JsValue keyframes, JsValue finalKeyframe, AnimAsyncOptions options, bool sync) {
  a.keyframeResolver = null;
  a.resolvedAt = time.now();
  bool canAnimateValue = true;
  if (!canAnimate(keyframes, options.name, options.type, options.velocity)) {
    canAnimateValue = false;
    if ((MotionGlobalConfig.instantAnimations == true || !JS.or(options.delay ?? 0.0, false).truthy()) && options.onUpdate.truthy()) {
      JS.invoke(options, "onUpdate", getFinalKeyframe(keyframes, options, finalKeyframe, 1.0));
    }
    keyframes[0] = keyframes[keyframes.length - 1.0];
    makeAnimationInstant(options);
    options.repeat = 0.0;
  }
  JsValue resolvedOptions = assign2(
    JS.object(
      "startTime", if (sync) {
        if (a.resolvedAt - a.createdAt > 40.0) { a.resolvedAt } else { a.createdAt }
      } else {
        JS.undefined()
      },
      "finalKeyframe", finalKeyframe
    ),
    options
  );
  resolvedOptions["keyframes"] = keyframes;
  JsValue animation = JS.undefined();
  if (canAnimateValue && !options.isHandoff.truthy() && supportsBrowserAnimation(resolvedOptions)) {
    JsValue motionValue = resolvedOptions["motionValue"];
    JsValue owner = if (motionValue.truthy()) { motionValue["owner"] } else { JS.undefined() };
    JsValue nativeOptions = assign2(JS.object(), resolvedOptions);
    nativeOptions["element"] = if (owner.truthy()) { owner["current"] } else { JS.undefined() };
    try {
      animation = new NativeAnimationExtended(nativeOptions);
    } catch {
      animation = createJSAnimation(resolvedOptions);
    }
  } else {
    animation = createJSAnimation(resolvedOptions);
  }
  JS.invoke(JS.invoke(animation["finished"], "then", () => {
    promiseStateOf(a)._resolve();
  }), "catch", () => {});
  if (a.pendingTimeline.truthy()) {
    a.stopTimeline = JS.invoke(animation, "attachTimeline", a.pendingTimeline);
    a.pendingTimeline = JS.undefined();
  }
  a._animation = animation;
}

JsValue asyncSurface = JS.object(
  "finished", JS.object("get", JS.method0((JsValue self) =>
    if (asyncOf(self)._animation.truthy()) { getAnimation(self)["finished"] } else { promiseStateOf(self)._finished })),
  "then", JS.object("value", JS.method1((JsValue self, JsValue onResolve) =>
    JS.invoke(JS.invoke(self["finished"], "finally", onResolve), "then", () => {}))),
  "duration", JS.object("get", JS.method0((JsValue self) => getAnimation(self)["duration"])),
  "iterationDuration", JS.object("get", JS.method0((JsValue self) => getAnimation(self)["iterationDuration"])),
  "time", JS.object(
    "get", JS.method0((JsValue self) => getAnimation(self)["time"]),
    "set", JS.method1((JsValue self, JsValue newTime) => {
      getAnimation(self)["time"] = newTime;
      return JS.undefined();
    })
  ),
  "speed", JS.object(
    "get", JS.method0((JsValue self) => getAnimation(self)["speed"]),
    "set", JS.method1((JsValue self, JsValue newSpeed) => {
      getAnimation(self)["speed"] = newSpeed;
      return JS.undefined();
    })
  ),
  "state", JS.object("get", JS.method0((JsValue self) => getAnimation(self)["state"])),
  "startTime", JS.object("get", JS.method0((JsValue self) => getAnimation(self)["startTime"])),
  "animation", JS.object("get", JS.method0(getAnimation)),
  "attachTimeline", JS.object("value", JS.method1((JsValue self, JsValue timeline) => {
    AsyncMotionValueAnimation a = asyncOf(self);
    if (a._animation.truthy()) {
      a.stopTimeline = JS.invoke(getAnimation(self), "attachTimeline", timeline);
    } else {
      a.pendingTimeline = timeline;
    }
    return () => {
      stopAsync(self);
    };
  })),
  "play", JS.object("value", JS.method0((JsValue self) => JS.invoke(getAnimation(self), "play"))),
  "pause", JS.object("value", JS.method0((JsValue self) => JS.invoke(getAnimation(self), "pause"))),
  "complete", JS.object("value", JS.method0((JsValue self) => JS.invoke(getAnimation(self), "complete"))),
  "cancel", JS.object("value", JS.method0((JsValue self) => {
    AsyncMotionValueAnimation a = asyncOf(self);
    if (a._animation.truthy()) {
      JS.invoke(getAnimation(self), "cancel");
    }
    KeyframeResolver? resolver = a.keyframeResolver;
    if (resolver != null) {
      resolver.cancel();
    }
    return JS.undefined();
  }))
);

export AsyncMotionValueAnimation createAsyncMotionValueAnimation(JsValue optionsValue) {
  AsyncMotionValueAnimation a = asyncOf(animCreate(asyncPrototype));
  updateFinished(a);
  // Bound, as upstream's, to support the `return animation.stop` pattern.
  JS.set(a, "stop", () => stopAsync(a));
  a.createdAt = time.now();
  // Upstream's destructuring defaults: each applies to `undefined` only.
  AnimAsyncOptions options = JS.assume(assign2(JS.object(), optionsValue));
  if (JS.isUndefined(options.autoplay)) { options.autoplay = true; }
  if (JS.isUndefined(options.delay)) { options.delay = 0.0; }
  if (JS.isUndefined(options.type)) { options.type = "keyframes"; }
  if (JS.isUndefined(options.repeat)) { options.repeat = 0.0; }
  if (JS.isUndefined(options.repeatDelay)) { options.repeatDelay = 0.0; }
  if (JS.isUndefined(options.repeatType)) { options.repeatType = "loop"; }
  JsValue element = options.element;
  KeyframeResolver resolver = new KeyframeResolver(
    options.keyframes,
    (JsValue resolvedKeyframes, JsValue finalKeyframe, bool forced) => {
      onKeyframesResolved(a, resolvedKeyframes, finalKeyframe, options, !forced);
    },
    options.name,
    options.motionValue,
    element,
    element.truthy() && JS.strictNotEqual(element["type"], "object")
  );
  a.keyframeResolver = resolver;
  resolver.scheduleResolve();
  return a;
}

// Upstream's public `AsyncMotionValueAnimation` class.
export JsValue asyncMotionValueAnimationConstructor = animClass(
  (JsValue options, JsValue _unused) => createAsyncMotionValueAnimation(options),
  asyncPrototype,
  asyncSurface
);
