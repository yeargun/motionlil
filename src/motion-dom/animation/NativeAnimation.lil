import { NativeOptions, nativeOptionsOf, transitionOf, browserAnimationOf } from "./utils/typed-options";
extern float Number(JsValue value);
import { WithPromise } from "./utils/WithPromise";
import { startWaapiAnimation } from "./waapi/start-waapi-animation";
import { ValueAnimationTransition } from "./types";
import { invariant } from "../../motion-utils/errors";
import { getFinalKeyframe } from "./keyframes/get-final";
import { setStyle } from "../render/dom/style-set";
import { millisecondsToSeconds, secondsToMilliseconds } from "../../motion-utils/time-conversion";
import {
  callFn0,
  callFn1,
  setProp,
  getProp,
  isFunction,
  callMethod0,
  callMethod1,
  parseFloatValue
} from "../dom-host";
import { supportsScrollTimeline } from "../utils/supports/scroll-timeline";
import { supportsLinearEasing } from "../utils/supports/linear-easing";
import { isGenerator } from "./generators/utils/is-generator";

JsValue nativeTransition(JsValue options) {
  JsValue transition = record{};
  for (string key in options) {
    if (key != "type") { transition[key] = options[key]; }
  }
  JsValue type = options["type"];
  if (isGenerator(type) && supportsLinearEasing()) {
    return callMethod1(type, "applyToOptions", transition);
  }
  return transition;
}

export class NativeAnimation extends WithPromise {
  JsValue options;
  JsValue animation;
  bool isStopped;
  float? finishedTime;
  bool allowFlatten;
  bool isPseudoElement;
  float? manualStartTime;

  init(JsValue? options = null) {
    super();
    this.options = options;
    this.animation = null;
    this.isStopped = false;
    this.finishedTime = null;
    this.allowFlatten = false;
    this.isPseudoElement = false;
    this.manualStartTime = null;
    if (options == null) { return; }
    NativeOptions input = nativeOptionsOf(options);
    invariant(!(options["type"] is string), "Mini animate() doesn't support \"type\" as a string.", "mini-spring");
    this.allowFlatten = input.allowFlatten ?? false;
    this.isPseudoElement = input.pseudoElement != null && input.pseudoElement != "";
    JsValue prepared = nativeTransition(options);
    this.animation = startWaapiAnimation(input.element, input.name, input.keyframes, transitionOf(prepared), input.pseudoElement);
    if (nativeOptionsOf(prepared).autoplay == false) { browserAnimationOf(this.animation).pause(); }
    NativeAnimation self = this;
    JsValue keyframes = input.keyframes;
    JsValue finalKeyframe = input.finalKeyframe;
    JsValue element = input.element;
    string name = input.name;
    string? pseudoElement = input.pseudoElement;
    (func()->void)? onComplete = input.onComplete;
    setProp(this.animation, "onfinish", () => {
      self.finishedTime = self.getPlaybackTime();
      if (pseudoElement == null || pseudoElement == "") {
        JsValue keyframe = getFinalKeyframe(keyframes, self.options, finalKeyframe, self.getPlaybackSpeed());
        if (getProp(self, "updateMotionValue") != null) { callMethod1(self, "updateMotionValue", keyframe); }
        setStyle(element, name, keyframe);
        browserAnimationOf(self.animation).cancel();
      }
      if (onComplete != null) { onComplete(); }
      self.notifyFinished();
    });
  }

  float getIterationDuration() {
    float delay = 0.0;
    if (this.options != null) { delay = nativeOptionsOf(this.options).delay ?? 0.0; }
    return this.getDuration() + millisecondsToSeconds(delay);
  }
  string getState() {
    if (this.finishedTime != null) { return "finished"; }
    return browserAnimationOf(this.animation).playState;
  }
  void setStartTime(float start) {
    this.manualStartTime = start;
    browserAnimationOf(this.animation).startTime = start;
  }
  float getStartTime() {
    return this.manualStartTime ?? Number(browserAnimationOf(this.animation).startTime);
  }
  float getPlaybackTime() {
    float value = Number(browserAnimationOf(this.animation).currentTime);
    if (value == 0.0 || value != value) { value = 0.0; }
    return millisecondsToSeconds(value);
  }

  void setPlaybackTime(float newTime) {
    bool wasFinished = this.finishedTime != null;
    this.manualStartTime = null;
    this.finishedTime = null;
    JsValue anim = this.animation;
    if (anim.truthy()) {
      setProp(anim, "currentTime", secondsToMilliseconds(newTime));
      if (wasFinished) {
        this.pause();
      }
    }
  }

  float getPlaybackSpeed() { return browserAnimationOf(this.animation).playbackRate; }

  void setPlaybackSpeed(float newSpeed) {
    if (newSpeed < 0.0) {
      this.finishedTime = null;
    }
    JsValue anim = this.animation;
    if (anim.truthy()) {
      setProp(anim, "playbackRate", newSpeed);
    }
  }

  float getDuration() {
    JsValue effect = this.animation["effect"];
    if (effect.truthy()) {
      JsValue timing = callMethod0(effect, "getComputedTiming");
      if (timing.truthy()) {
        return millisecondsToSeconds(Number(timing["duration"]));
      }
    }
    return 0.0;
  }

  void commitStyles() {
    JsValue options = this.options;
    if (this.isPseudoElement || !options.truthy() || !options.isObject()) {
      return;
    }
    JsValue element = options["element"];
    if (!element.truthy()) {
      return;
    }
    JsValue isConnected = element["isConnected"];
    bool connected = true;
    if (isConnected is bool) {
      connected = isConnected;
    }
    if (!connected) {
      return;
    }
    JsValue anim = this.animation;
    if (anim.truthy() && hasFunctionNamed(anim, "commitStyles")) {
      callMethod0(anim, "commitStyles");
    }
  }

  void cancel() {
    try { browserAnimationOf(this.animation).cancel(); } catch {}
  }

  void complete() {
    JsValue anim = this.animation;
    if (anim.truthy() && hasFunctionNamed(anim, "finish")) {
      callMethod0(anim, "finish");
    }
  }

  void stop() {
    if (this.isStopped) {
      return;
    }
    this.isStopped = true;
    string state = this.getState();
    if (state == "idle" || state == "finished") {
      return;
    }
    if (getProp(this, "updateMotionValue") != null) { callMethod0(this, "updateMotionValue"); }
    else { this.commitStyles(); }
    if (!this.isPseudoElement) {
      this.cancel();
    }
  }

  void pause() { browserAnimationOf(this.animation).pause(); }

  void play() {
    if (this.isStopped) { return; }
    this.manualStartTime = null;
    browserAnimationOf(this.animation).play();
    if (this.getState() == "finished") { this.updateFinished(); }
  }

  func()->void attachTimeline(JsValue timelineOptions) {
    JsValue timeline = null;
    JsValue observe = null;
    JsValue rangeStart = null;
    JsValue rangeEnd = null;
    if (timelineOptions.isObject()) {
      JsValue t = timelineOptions["timeline"];
      if (t.truthy()) {
        timeline = t;
      }
      observe = timelineOptions["observe"];
      rangeStart = timelineOptions["rangeStart"];
      rangeEnd = timelineOptions["rangeEnd"];
    }
    JsValue anim = this.animation;
    if (this.allowFlatten && anim.truthy()) {
      JsValue effect = anim["effect"];
      if (effect.truthy() && hasFunctionNamed(effect, "updateTiming")) {
        callMethod1(effect, "updateTiming", record{ easing: "linear" });
      }
    }
    if (anim.truthy()) {
      setProp(anim, "onfinish", null);
    }
    if (anim.truthy() && timeline.truthy() && supportsScrollTimeline()) {
      setProp(anim, "timeline", timeline);
      if (rangeStart.truthy()) {
        setProp(anim, "rangeStart", rangeStart);
      }
      if (rangeEnd.truthy()) {
        setProp(anim, "rangeEnd", rangeEnd);
      }
      return () => {};
    }
    if (isFunction(observe)) {
      JsValue cancel = callFn1(observe, this);
      return () => {
        if (isFunction(cancel)) {
          callFn0(cancel);
        }
      };
    }
    return () => {};
  }
}

bool hasFunctionNamed(JsValue obj, string name) {
  JsValue method = getProp(obj, name);
  return isFunction(method);
}

export constructor NativeAnimation as NativeAnimationConstructor;
