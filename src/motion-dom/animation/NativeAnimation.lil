import { millisecondsToSeconds, secondsToMilliseconds } from "../../motion-utils/time-conversion";
import { setStyle } from "../render/dom/style-set";
import { supportsScrollTimeline } from "../utils/supports/scroll-timeline";
import { getFinalKeyframe } from "./keyframes/get-final";
import {
  WithPromise,
  finishedDescriptor,
  thenDescriptor,
  updateFinished
} from "./utils/WithPromise";
import { startWaapiAnimation } from "./waapi/start-waapi-animation";
import { applyGeneratorOptionsTo } from "./waapi/utils/apply-generator";
import { animAdopt, animClass } from "./anim-host";

// Upstream's NativeAnimation.prototype, which the extended and wrapper
// classes' prototypes inherit.
export JsValue nativeAnimationPrototype = JS.object();

export extern class AnimNativeOptions {
  JsValue element;
  JsValue name;
  JsValue keyframes;
  JsValue pseudoElement;
  JsValue allowFlatten;
  JsValue finalKeyframe;
  JsValue onComplete;
  JsValue? delay;
  JsValue motionValue;
}

// The browser Animation a NativeAnimation drives.
export extern class AnimWaapi {
  JsValue currentTime;
  JsValue startTime;
  JsValue playbackRate;
  JsValue playState;
  JsValue effect;
  JsValue onfinish;
  JsValue timeline;
  JsValue rangeStart;
  JsValue rangeEnd;
  void play();
  void pause();
  void cancel();
}

// A NativeAnimation's state lives on the object itself: the class declares no
// fields, so each construction site is an empty literal plus the constructor.
export extern class AnimNativeState {
  AnimNativeOptions options;
  AnimWaapi animation;
  JsValue finishedTime;
  bool isStopped;
  JsValue manualStartTime;
  bool isPseudoElement;
  bool allowFlatten;
  JsValue updateMotionValue;
}

export AnimNativeState nativeStateOf(JsValue value) {
  return JS.assume(value);
}

export float nativeTime(AnimNativeState animation) {
  float currentTime = JS.assume(JS.or(JS.number(animation.animation.currentTime), 0.0));
  return millisecondsToSeconds(currentTime);
}

float nativeDuration(AnimNativeState animation) {
  JsValue effect = animation.animation.effect;
  JsValue timing = if (effect.truthy() && effect["getComputedTiming"].truthy()) {
    JS.invoke(effect, "getComputedTiming")
  } else {
    JS.undefined()
  };
  return millisecondsToSeconds(JS.number(if (timing.truthy()) { JS.or(timing["duration"], 0.0) } else { 0.0 }));
}

JsValue nativeState(AnimNativeState animation) {
  return if (JS.strictEqual(animation.finishedTime, null)) { animation.animation.playState } else { "finished" };
}

export JsValue nativeStartTime(AnimNativeState animation) {
  JsValue? manual = animation.manualStartTime;
  return manual ?? JS.number(animation.animation.startTime);
}

export void setNativeStartTime(AnimNativeState animation, JsValue newStartTime) {
  animation.animation.startTime = newStartTime;
  animation.manualStartTime = newStartTime;
}

void cancelNative(AnimNativeState animation) {
  try {
    animation.animation.cancel();
  } catch {
  }
}

JsValue nativeSurface = JS.object(
  "finished", finishedDescriptor,
  "then", thenDescriptor,
  "duration", JS.object("get", JS.method0((JsValue self) => nativeDuration(nativeStateOf(self)))),
  "iterationDuration", JS.object("get", JS.method0((JsValue self) => {
    AnimNativeState animation = nativeStateOf(self);
    JsValue options = animation.options;
    float delay = JS.assume(JS.or(if (options.truthy()) { options["delay"] } else { JS.undefined() }, 0.0));
    return nativeDuration(animation) + millisecondsToSeconds(delay);
  })),
  "time", JS.object(
    "get", JS.method0((JsValue self) => nativeTime(nativeStateOf(self))),
    "set", JS.method1((JsValue self, JsValue newTime) => {
      AnimNativeState animation = nativeStateOf(self);
      bool wasFinished = JS.strictNotEqual(animation.finishedTime, null);
      animation.manualStartTime = null;
      animation.finishedTime = null;
      float seconds = JS.assume(newTime);
      animation.animation.currentTime = secondsToMilliseconds(seconds);
      if (wasFinished) {
        animation.animation.pause();
      }
      return JS.undefined();
    })
  ),
  "speed", JS.object(
    "get", JS.method0((JsValue self) => nativeStateOf(self).animation.playbackRate),
    "set", JS.method1((JsValue self, JsValue newSpeed) => {
      AnimNativeState animation = nativeStateOf(self);
      float speed = JS.assume(newSpeed);
      if (speed < 0.0) {
        animation.finishedTime = null;
      }
      animation.animation.playbackRate = newSpeed;
      return JS.undefined();
    })
  ),
  "state", JS.object("get", JS.method0((JsValue self) => nativeState(nativeStateOf(self)))),
  "startTime", JS.object(
    "get", JS.method0((JsValue self) => nativeStartTime(nativeStateOf(self))),
    "set", JS.method1((JsValue self, JsValue newStartTime) => {
      setNativeStartTime(nativeStateOf(self), newStartTime);
      return JS.undefined();
    })
  ),
  "play", JS.object("value", JS.method0((JsValue self) => {
    AnimNativeState animation = nativeStateOf(self);
    if (!animation.isStopped) {
      animation.manualStartTime = null;
      animation.animation.play();
      if (JS.strictEqual(nativeState(animation), "finished")) {
        updateFinished(self);
      }
    }
    return JS.undefined();
  })),
  "pause", JS.object("value", JS.method0((JsValue self) => {
    nativeStateOf(self).animation.pause();
    return JS.undefined();
  })),
  "stop", JS.object("value", JS.method0((JsValue self) => {
    AnimNativeState animation = nativeStateOf(self);
    if (animation.isStopped) {
      return JS.undefined();
    }
    animation.isStopped = true;
    JsValue state = nativeState(animation);
    if (JS.strictEqual(state, "idle") || JS.strictEqual(state, "finished")) {
      return JS.undefined();
    }
    if (animation.updateMotionValue.truthy()) {
      JS.invoke(animation, "updateMotionValue");
    } else {
      JsValue options = animation.options;
      JsValue element = if (options.truthy()) { options["element"] } else { JS.undefined() };
      JsValue waapi = animation.animation;
      if (!animation.isPseudoElement && element.truthy() && element["isConnected"].truthy() && waapi["commitStyles"].truthy()) {
        JS.invoke(waapi, "commitStyles");
      }
    }
    if (!animation.isPseudoElement) {
      cancelNative(animation);
    }
    return JS.undefined();
  })),
  "complete", JS.object("value", JS.method0((JsValue self) => {
    JsValue waapi = nativeStateOf(self).animation;
    if (waapi["finish"].truthy()) {
      JS.invoke(waapi, "finish");
    }
    return JS.undefined();
  })),
  "cancel", JS.object("value", JS.method0((JsValue self) => {
    cancelNative(nativeStateOf(self));
    return JS.undefined();
  })),
  "attachTimeline", JS.object("value", JS.method1((JsValue self, JsValue timelineOptions) => {
    AnimNativeState animation = nativeStateOf(self);
    AnimWaapi waapi = animation.animation;
    if (animation.allowFlatten) {
      JsValue effect = waapi.effect;
      if (effect.truthy()) {
        JS.invoke(effect, "updateTiming", JS.object("easing", "linear"));
      }
    }
    waapi.onfinish = null;
    JsValue timeline = timelineOptions["timeline"];
    if (timeline.truthy() && supportsScrollTimeline()) {
      waapi.timeline = timeline;
      JsValue rangeStart = timelineOptions["rangeStart"];
      JsValue rangeEnd = timelineOptions["rangeEnd"];
      if (rangeStart.truthy()) {
        waapi.rangeStart = rangeStart;
      }
      if (rangeEnd.truthy()) {
        waapi.rangeEnd = rangeEnd;
      }
      return () => {};
    }
    return JS.invoke(timelineOptions, "observe", self);
  }))
);

export class NativeAnimation extends WithPromise {
  init(JsValue optionsValue, JsValue prototype = nativeAnimationPrototype) {
    super();
    animAdopt(this, prototype);
    AnimNativeState animation = nativeStateOf(this);
    animation.finishedTime = null;
    animation.isStopped = false;
    animation.manualStartTime = null;
    if (!optionsValue.truthy()) {
      return;
    }
    AnimNativeOptions options = JS.assume(optionsValue);
    JsValue pseudoElement = options.pseudoElement;
    animation.isPseudoElement = pseudoElement.truthy();
    animation.allowFlatten = options.allowFlatten.truthy();
    animation.options = options;
    JsValue transition = applyGeneratorOptionsTo(options);
    AnimWaapi waapi = JS.assume(startWaapiAnimation(options.element, JS.assume(options.name), options.keyframes, transition, pseudoElement));
    animation.animation = waapi;
    if (JS.strictEqual(transition["autoplay"], false)) {
      waapi.pause();
    }
    NativeAnimation self = this;
    waapi.onfinish = () => {
      animation.finishedTime = nativeTime(animation);
      if (!pseudoElement.truthy()) {
        JsValue keyframe = getFinalKeyframe(options.keyframes, animation.options, options.finalKeyframe, JS.assume(waapi.playbackRate));
        if (animation.updateMotionValue.truthy()) {
          JS.invoke(animation, "updateMotionValue", keyframe);
        }
        setStyle(options.element, JS.assume(options.name), keyframe);
        waapi.cancel();
      }
      if (options.onComplete.truthy()) {
        JS.invoke(options, "onComplete");
      }
      self.notifyFinished();
    };
  }
}

// Upstream's public `NativeAnimation` class (`new NativeAnimation(options)`).
export JsValue nativeAnimationConstructor = animClass(
  (JsValue options, JsValue _unused) => new NativeAnimation(options),
  nativeAnimationPrototype,
  nativeSurface
);
