import { Axis, Box } from "../../../motion-utils/types/geometry";
import { px } from "../../value/types/numbers/units";

extern float parseFloat(JsValue value);

export float pixelsToPercent(float pixels, Axis axis) {
  return if (axis.max == axis.min) { 0.0 } else { (pixels / (axis.max - axis.min)) * 100.0 };
}

export JsValue correctBorderRadius = object{
  correct: (JsValue latest, JsValue node) => {
    JsValue target = node["target"];
    if (!target.truthy()) {
      return latest;
    }
    if (latest is string) {
      if (!px.test(latest)) {
        return latest;
      }
      latest = parseFloat(latest);
    }
    Box box = JS.assume(target);
    float pixels = JS.assume(latest);
    return `${pixelsToPercent(pixels, box.x)}% ${pixelsToPercent(pixels, box.y)}%`;
  }
};
