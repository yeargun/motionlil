import { Delta, Point } from "../../../motion-utils/types/geometry";
import { mixNumber } from "../../utils/mix/number";
import { complex } from "../../value/types/complex/index";

export JsValue correctBoxShadow = object{
  correct: (JsValue latest, JsValue node) => {
    JsValue[] shadow = JS.assume(complex.parse(latest));
    (func(string)->func(JsValue)->JsValue)? createTransformer = complex.createTransformer;
    if (shadow.length > 5 || createTransformer == null) {
      return latest;
    }
    func(JsValue)->JsValue template = createTransformer(JS.assume(latest));
    int offset = if (JS.typeOf(shadow[0]) != "number") { 1 } else { 0 };
    Delta projectionDelta = JS.assume(node["projectionDelta"]);
    Point treeScale = JS.assume(node["treeScale"]);
    float xScale = projectionDelta.x.scale * treeScale.x;
    float yScale = projectionDelta.y.scale * treeScale.y;
    float averageScale = mixNumber(xScale, yScale, 0.5);
    // Indices past the parsed values stay unwritten: this port's template reads every entry.
    for (int i = offset; i < shadow.length && i < offset + 4; i++) {
      JsValue value = shadow[i];
      if (i < offset + 2 || (value is float)) {
        float scale = averageScale;
        if (i == offset) {
          scale = xScale;
        } else if (i == offset + 1) {
          scale = yScale;
        }
        float amount = JS.assume(value);
        shadow[i] = amount / scale;
      }
    }
    return template(shadow);
  }
};
