import { Delta, Point } from "../../../motion-utils/types/geometry";

string rotation(JsValue values, string key, string name) {
  JsValue value = values[key];
  return if (value.truthy()) { `${name}(${value}deg) ` } else { "" };
}

export string buildProjectionTransform(
  Delta delta,
  Point treeScale,
  JsValue latestTransform = JS.undefined()
) {
  string transform = "";
  float xTranslate = delta.x.translate / treeScale.x;
  float yTranslate = delta.y.translate / treeScale.y;
  JsValue zTranslate = JS.or(JS.and(latestTransform, latestTransform["z"]), 0.0);
  if (JS.or(xTranslate, JS.or(yTranslate, zTranslate)).truthy()) {
    transform = `translate3d(${xTranslate}px, ${yTranslate}px, ${zTranslate}px) `;
  }
  if (treeScale.x != 1.0 || treeScale.y != 1.0) {
    transform += `scale(${1.0 / treeScale.x}, ${1.0 / treeScale.y}) `;
  }
  if (latestTransform.truthy()) {
    JsValue transformPerspective = latestTransform["transformPerspective"];
    if (transformPerspective.truthy()) {
      transform = `perspective(${transformPerspective}px) ${transform}`;
    }
    transform += rotation(latestTransform, "rotate", "rotate") +
      rotation(latestTransform, "pathRotation", "rotate") +
      rotation(latestTransform, "rotateX", "rotateX") +
      rotation(latestTransform, "rotateY", "rotateY") +
      rotation(latestTransform, "skewX", "skewX") +
      rotation(latestTransform, "skewY", "skewY");
  }
  float elementScaleX = delta.x.scale * treeScale.x;
  float elementScaleY = delta.y.scale * treeScale.y;
  if (elementScaleX != 1.0 || elementScaleY != 1.0) {
    transform += `scale(${elementScaleX}, ${elementScaleY})`;
  }
  return if (transform == "") { "none" } else { transform };
}
