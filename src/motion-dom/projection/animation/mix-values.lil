import { circOut, progress as calcProgress } from "../../../motion-utils/index";
import { identityEase } from "../../../motion-utils/noop";
import { mixNumber } from "../../utils/mix/number";
import { percent, px } from "../../value/types/numbers/units";
import { cornerRadiusProps } from "../../utils/border-radius";

extern float parseFloat(JsValue value);

float asNumber(JsValue value) {
  return if (value is string) { parseFloat(value) } else { JS.assume(value) };
}

bool isPx(JsValue value) {
  return (value is float) || px.test(value);
}

JsValue getRadius(JsValue values, string radiusName) {
  JsValue value = values[radiusName];
  return if (JS.isUndefined(value)) { values["borderRadius"] } else { value };
}

float opacityOf(JsValue values) {
  JsValue opacity = values["opacity"];
  return JS.assume(if (JS.isNullish(opacity)) { 1.0 } else { opacity });
}

func(float)->float compress(float min, float max, func(float)->float easing) {
  return (float p) => if (p < min) { 0.0 } else { if (p > max) { 1.0 } else { easing(calcProgress(min, max, p)) } };
}

func(float)->float easeCrossfadeIn = compress(0.0, 0.5, circOut);
func(float)->float easeCrossfadeOut = compress(0.5, 0.95, identityEase);

export void mixValues(
  JsValue target,
  JsValue follow,
  JsValue lead,
  float progress,
  bool shouldCrossfadeOpacity,
  bool isOnlyMember
) {
  if (shouldCrossfadeOpacity) {
    target["opacity"] = mixNumber(0.0, opacityOf(lead), easeCrossfadeIn(progress));
    target["opacityExit"] = mixNumber(opacityOf(follow), 0.0, easeCrossfadeOut(progress));
  } else if (isOnlyMember) {
    target["opacity"] = mixNumber(opacityOf(follow), opacityOf(lead), progress);
  }
  for (string borderLabel of cornerRadiusProps) {
    JsValue followRadius = getRadius(follow, borderLabel);
    JsValue leadRadius = getRadius(lead, borderLabel);
    if (JS.isUndefined(followRadius) && JS.isUndefined(leadRadius)) {
      continue;
    }
    followRadius = JS.or(followRadius, 0.0);
    leadRadius = JS.or(leadRadius, 0.0);
    if (JS.strictEqual(followRadius, 0.0) || JS.strictEqual(leadRadius, 0.0) || isPx(followRadius) == isPx(leadRadius)) {
      float mixed = mixNumber(asNumber(followRadius), asNumber(leadRadius), progress).max(0.0);
      target[borderLabel] = if (percent.test(leadRadius) || percent.test(followRadius)) { `${mixed}%` } else { mixed };
    } else {
      target[borderLabel] = leadRadius;
    }
  }
  JsValue followRotate = follow["rotate"];
  JsValue leadRotate = lead["rotate"];
  if (JS.or(followRotate, leadRotate).truthy()) {
    target["rotate"] = mixNumber(JS.assume(JS.or(followRotate, 0.0)), JS.assume(JS.or(leadRotate, 0.0)), progress);
  }
}
