import { BoundingBox, Box, Point } from "../../../motion-utils/types/geometry";
import { convertBoundingBoxToBox, transformBoxPoints } from "../geometry/conversion";
import { translateAxis } from "../geometry/delta-apply";

export Box measureViewportBox(JsValue instance, JsValue transformPoint = JS.undefined()) {
  return convertBoundingBoxToBox(transformBoxPoints(JS.assume(JS.invoke(instance, "getBoundingClientRect")), JS.assume(transformPoint)));
}

export Box measurePageBox(JsValue element, JsValue rootProjectionNode, JsValue transformPagePoint = JS.undefined()) {
  Box viewportBox = measureViewportBox(element, transformPagePoint);
  JsValue scroll = rootProjectionNode["scroll"];
  if (scroll.truthy()) {
    Point offset = JS.assume(scroll["offset"]);
    translateAxis(viewportBox.x, offset.x);
    translateAxis(viewportBox.y, offset.y);
  }
  return viewportBox;
}
