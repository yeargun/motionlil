export bool isIdentityScale(JsValue scale) {
  return JS.isUndefined(scale) || JS.strictEqual(scale, 1.0);
}

export bool hasScale(JsValue values) {
  return !isIdentityScale(values["scale"]) || !isIdentityScale(values["scaleX"]) || !isIdentityScale(values["scaleY"]);
}

JsValue is2DTranslate(JsValue value) {
  return JS.and(value, !JS.strictEqual(value, "0%"));
}

export JsValue has2DTranslate(JsValue values) {
  return JS.or(is2DTranslate(values["x"]), is2DTranslate(values["y"]));
}

export bool hasTransform(JsValue values) {
  return hasScale(values) ||
    JS.or(has2DTranslate(values), JS.or(values["z"], JS.or(values["rotate"], JS.or(values["rotateX"], JS.or(values["rotateY"], JS.or(values["skewX"], values["skewY"])))))).truthy();
}
