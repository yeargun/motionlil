import {
  Axis,
  AxisDelta,
  Box,
  Delta
} from "../../../motion-utils/types/geometry";

export AxisDelta createAxisDelta() {
  return new AxisDelta(0.0, 1.0, 0.0, 0.0);
}

export Delta createDelta() {
  return new Delta(createAxisDelta(), createAxisDelta());
}

export Axis createAxis() {
  return new Axis(0.0, 0.0);
}

export Box createBox() {
  return new Box(createAxis(), createAxis());
}
