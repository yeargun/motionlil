import { Axis, Box } from "../../../motion-utils/types/geometry";
import { mixNumber } from "../../utils/mix/number";
import { percent } from "../../value/types/numbers/units";
import { scalePoint } from "./delta-apply";

extern float parseFloat(string value);

export float removePointDelta(
  float point,
  float translate,
  float scale,
  float originPoint,
  float? boxScale = null
) {
  point = scalePoint(point - translate, 1.0 / scale, originPoint);
  if (boxScale != null) {
    point = scalePoint(point, 1.0 / boxScale, originPoint);
  }
  return point;
}

export void removeAxisDelta(
  Axis axis,
  JsValue translate = 0.0,
  float? scale = null,
  float? origin = null,
  float? boxScale = null,
  Axis? originAxis = null,
  Axis? sourceAxis = null
) {
  Axis originAx = originAxis ?? axis;
  Axis sourceAx = sourceAxis ?? axis;
  if (JS.isUndefined(translate)) {
    translate = 0.0;
  }
  if (percent.test(translate)) {
    translate = mixNumber(sourceAx.min, sourceAx.max, parseFloat(JS.assume(translate)) / 100.0) - sourceAx.min;
  }
  if (!(translate is float)) {
    return;
  }
  float distance = JS.assume(translate);
  float originPoint = mixNumber(originAx.min, originAx.max, origin ?? 0.5);
  if (axis == originAx) {
    originPoint -= distance;
  }
  axis.min = removePointDelta(axis.min, distance, scale ?? 1.0, originPoint, boxScale);
  axis.max = removePointDelta(axis.max, distance, scale ?? 1.0, originPoint, boxScale);
}

export void removeAxisTransforms(
  Axis axis,
  JsValue transforms,
  string[] keys,
  Axis? origin = null,
  Axis? sourceAxis = null
) {
  removeAxisDelta(axis, transforms[keys[0]], JS.assume(transforms[keys[1]]), JS.assume(transforms[keys[2]]), JS.assume(transforms["scale"]), origin, sourceAxis);
}

string[] xKeys = ["x", "scaleX", "originX"];
string[] yKeys = ["y", "scaleY", "originY"];

export void removeBoxTransforms(
  Box box,
  JsValue transforms,
  Box? originBox = null,
  Box? sourceBox = null
) {
  removeAxisTransforms(box.x, transforms, xKeys, if (originBox != null) { originBox.x } else { null }, if (sourceBox != null) { sourceBox.x } else { null });
  removeAxisTransforms(box.y, transforms, yKeys, if (originBox != null) { originBox.y } else { null }, if (sourceBox != null) { sourceBox.y } else { null });
}
