import { Axis, Box, Delta, Point } from "../../../motion-utils/types/geometry";
import { mixNumber } from "../../utils/mix/number";
import { hasTransform } from "../utils/has-transform";

extern float parseFloat(string value);

export float scalePoint(float point, float scale, float originPoint) {
  return originPoint + scale * (point - originPoint);
}

export float applyPointDelta(
  float point,
  float translate,
  float scale,
  float originPoint,
  float? boxScale = null
) {
  if (boxScale != null) {
    point = scalePoint(point, boxScale, originPoint);
  }
  return scalePoint(point, scale, originPoint) + translate;
}

export void applyAxisDelta(
  Axis axis,
  float translate,
  float scale,
  float originPoint,
  float? boxScale = null
) {
  axis.min = applyPointDelta(axis.min, translate, scale, originPoint, boxScale);
  axis.max = applyPointDelta(axis.max, translate, scale, originPoint, boxScale);
}

export void applyBoxDelta(Box box, Delta delta) {
  applyAxisDelta(box.x, delta.x.translate, delta.x.scale, delta.x.originPoint);
  applyAxisDelta(box.y, delta.y.translate, delta.y.scale, delta.y.originPoint);
}

export void translateAxis(Axis axis, float distance) {
  axis.min += distance;
  axis.max += distance;
}

export void transformAxis(
  Axis axis,
  float? axisTranslate = null,
  float? axisScale = null,
  float? boxScale = null,
  float? axisOrigin = null
) {
  applyAxisDelta(axis, axisTranslate ?? 0.0, axisScale ?? 1.0, mixNumber(axis.min, axis.max, axisOrigin ?? 0.5), boxScale);
}

float? resolveAxisTranslate(JsValue value, Axis axis) {
  if (value is string) {
    return (parseFloat(value) / 100.0) * (axis.max - axis.min);
  }
  return JS.assume(value);
}

export void transformBox(Box box, JsValue transform, Box? sourceBox = null) {
  Box resolveBox = sourceBox ?? box;
  transformAxis(box.x, resolveAxisTranslate(transform["x"], resolveBox.x), JS.assume(transform["scaleX"]), JS.assume(transform["scale"]), JS.assume(transform["originX"]));
  transformAxis(box.y, resolveAxisTranslate(transform["y"], resolveBox.y), JS.assume(transform["scaleY"]), JS.assume(transform["scale"]), JS.assume(transform["originY"]));
}

// Kept for callers that still name the tree node type; the tree walk reads nodes as upstream shapes.
export class ProjectionTreeNode {
  Delta? projectionDelta;
  JsValue? options;
  JsValue? scroll;
  bool isRoot;
  Record<JsValue> latestValues;
  Box? layoutBox;

  init() {
    this.projectionDelta = null;
    this.options = null;
    this.scroll = null;
    this.isRoot = false;
    this.latestValues = record{};
    this.layoutBox = null;
  }
}

export void applyTreeDeltas(
  Box box,
  Point treeScale,
  JsValue treePath,
  bool isSharedTransition = false
) {
  int treeLength = JS.assume(treePath["length"]);
  if (treeLength == 0) {
    return;
  }
  treeScale.x = 1.0;
  treeScale.y = 1.0;
  for (int i = 0; i < treeLength; i++) {
    JsValue node = treePath[i];
    JsValue options = node["options"];
    JsValue visualElement = options["visualElement"];
    if (visualElement.truthy()) {
      JsValue style = visualElement["props"]["style"];
      if (style.truthy() && JS.strictEqual(style["display"], "contents")) {
        continue;
      }
    }
    JsValue scroll = node["scroll"];
    if (isSharedTransition && options["layoutScroll"].truthy() && scroll.truthy() && !JS.strictEqual(node, node["root"])) {
      Point offset = JS.assume(scroll["offset"]);
      translateAxis(box.x, -offset.x);
      translateAxis(box.y, -offset.y);
    }
    JsValue delta = node["projectionDelta"];
    if (delta.truthy()) {
      Delta nodeDelta = JS.assume(delta);
      treeScale.x *= nodeDelta.x.scale;
      treeScale.y *= nodeDelta.y.scale;
      applyBoxDelta(box, nodeDelta);
    }
    JsValue latestValues = node["latestValues"];
    if (isSharedTransition && hasTransform(latestValues)) {
      JsValue layout = node["layout"];
      transformBox(box, latestValues, JS.assume(JS.and(layout, layout["layoutBox"])));
    }
  }
  if (treeScale.x < 1.0000000000001 && treeScale.x > 0.999999999999) {
    treeScale.x = 1.0;
  }
  if (treeScale.y < 1.0000000000001 && treeScale.y > 0.999999999999) {
    treeScale.y = 1.0;
  }
}
