import {
  Axis,
  BoundingBox,
  Box,
  Point
} from "../../../motion-utils/types/geometry";

export Box convertBoundingBoxToBox(BoundingBox bb) {
  return new Box(new Axis(bb.left, bb.right), new Axis(bb.top, bb.bottom));
}

export BoundingBox convertBoxToBoundingBox(Box box) {
  return new BoundingBox(box.y.min, box.x.max, box.y.max, box.x.min);
}

export BoundingBox transformBoxPoints(
  BoundingBox point,
  JsValue transformPoint = JS.undefined()
) {
  if (!transformPoint.truthy()) {
    return point;
  }
  func(Point)->Point transform = JS.assume(transformPoint);
  Point topLeft = transform(new Point(point.left, point.top));
  Point bottomRight = transform(new Point(point.right, point.bottom));
  return new BoundingBox(topLeft.y, bottomRight.x, bottomRight.y, topLeft.x);
}
