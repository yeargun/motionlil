export func()->void addDomEvent(
  JsValue target,
  string eventName,
  JsValue handler,
  JsValue options = JS.undefined()
) {
  JsValue opts = if (JS.isUndefined(options)) { JS.object("passive", true) } else { options };
  JS.invoke(target, "addEventListener", eventName, handler, opts);
  return () => {
    JS.invoke(target, "removeEventListener", eventName, handler, opts);
  };
}
