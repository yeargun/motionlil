import { asArr, asFloats, asMixer, asNum } from "../value/types/types";
import { interpolate, InterpolateOptions } from "./interpolate";
import extern { cast as asInterpolateOptions } from "../value/types/cast.ts";

extern InterpolateOptions? asInterpolateOptions(JsValue? options);

export class TransformOptions {
  bool clamp;
  (func(float)->float)[]? ease;

  init(bool clamp = true, (func(float)->float)[]? ease = null) {
    this.clamp = clamp;
    this.ease = ease;
  }
}

export { interpolate as transformRange };

// transform(value, inputRange, outputRange, options) maps at once;
// transform(inputRange, outputRange, options) returns the mapping.
export JsValue transform(JsValue a, JsValue b, JsValue? c = null, JsValue? d = null) {
  bool useImmediate = !a.isArray();
  func(float)->JsValue interpolator = asMixer(if (useImmediate) {
    interpolate(asFloats(b), asFloats(c), asInterpolateOptions(d))
  } else {
    interpolate(asFloats(a), asFloats(b), asInterpolateOptions(c))
  });
  return if (useImmediate) { interpolator(asNum(a)) } else { interpolator };
}
