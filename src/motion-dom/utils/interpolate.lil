import { clamp } from "../../motion-utils/clamp";
import { MotionGlobalConfig } from "../../motion-utils/global-config";
import { identityEase } from "../../motion-utils/noop";
import { progress } from "../../motion-utils/progress";
import { callFn2 } from "../dom-host";
import { asFloatFn, asMixer, floatsAsJs } from "../value/types/types";
import { getMixer } from "./mix/complex";

// `{ clamp, ease, mixer }`: JavaScript callers pass the same plain object.
export class InterpolateOptions {
  bool? clamp;
  JsValue? ease;
  JsValue? mixer;

  init(bool clamp = true, (func(float)->float)[]? ease = null) {
    this.clamp = clamp;
    this.ease = ease;
    this.mixer = null;
  }
}

// Maps a numerical input range to an output range of numbers, colours or
// complex strings. Typed for numbers; JavaScript callers pass any outputs.
export func(float)->float interpolate(
  float[] input,
  float[] outputRange,
  InterpolateOptions? options = null
) {
  JsValue[] output = floatsAsJs(outputRange);
  bool isClamp = true;
  JsValue? ease = null;
  JsValue? mixer = null;
  if (options != null) {
    isClamp = options.clamp ?? true;
    ease = options.ease;
    mixer = options.mixer;
  }
  int inputLength = input.length;
  if (inputLength == 1) {
    return asFloatFn((float v) => output[0]);
  }
  if (inputLength == 2 && output[0] == output[1]) {
    return asFloatFn((float v) => output[1]);
  }
  bool isZeroDeltaRange = input[0] == input[1];
  // An input running highest to lowest reverses both ranges.
  if (input[0] > input[inputLength - 1]) {
    input = [...input].reverse();
    output = [...output].reverse();
  }
  (func(float)->JsValue)[] mixers = [];
  JsValue? mixerFactory = mixer ?? MotionGlobalConfig.mix;
  for (int i = 0; i < output.length - 1; i++) {
    JsValue from = output[i];
    JsValue to = output[i + 1];
    func(float)->JsValue mix = if (mixerFactory != null) {
      asMixer(callFn2(mixerFactory, from, to))
    } else {
      getMixer(from)(from, to)
    };
    if (ease != null) {
      JsValue easing = if (ease.isArray()) {
        if (ease[i].truthy()) { ease[i] } else { identityEase }
      } else {
        ease
      };
      func(float)->JsValue eased = mix;
      func(float)->float easingFunction = asEasing(easing);
      mix = (float p) => eased(easingFunction(p));
    }
    mixers.push(mix);
  }
  int numMixers = mixers.length;
  func(float)->JsValue interpolator = (float v) => {
    if (isZeroDeltaRange && v < input[0]) {
      return output[0];
    }
    int i = 0;
    if (numMixers > 1) {
      while (i < input.length - 2 && v >= input[i + 1]) {
        i++;
      }
    }
    return mixers[i](progress(input[i], input[i + 1], v));
  };
  if (isClamp) {
    float min = input[0];
    float max = input[inputLength - 1];
    return asFloatFn((float v) => interpolator(clamp(min, max, v)));
  }
  return asFloatFn(interpolator);
}

import extern { cast as asEasing } from "../value/types/cast.ts";
extern func(float)->float asEasing(JsValue f);
