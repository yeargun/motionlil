import { easingDefinitionToFunction } from "../../motion-utils/easing/utils/map";
import { asJs, asNum, asOpt } from "../value/types/types";
import extern { cast as asEasingDefinition } from "../value/types/cast.ts";

extern string | float[] | func(float)->float asEasingDefinition(JsValue v);

export class StaggerOptions {
  float startDelay;
  string | float from;
  (string | float[] | func(float)->float)? ease;

  init(
    float startDelay = 0.0,
    string | float from = 0.0,
    (string | float[] | func(float)->float)? ease = null
  ) {
    this.startDelay = startDelay;
    this.from = from;
    this.ease = ease;
  }
}

export float getOriginIndex(JsValue from, int total) {
  if (from == "first") {
    return 0.0;
  }
  float lastIndex = total - 1;
  return if (from == "last") { lastIndex } else { lastIndex / 2.0 };
}

export func(int, int)->float stagger(float duration = 0.1, JsValue? options = null) {
  JsValue startDelay = 0.0;
  JsValue from = 0.0;
  JsValue? ease = null;
  if (options != null) {
    startDelay = asOpt(options["startDelay"]) ?? 0.0;
    from = asOpt(options["from"]) ?? 0.0;
    ease = asOpt(options["ease"]);
  }
  return (int i, int total) => {
    float fromIndex = if (from is float) { from } else { getOriginIndex(from, total) };
    float delay = duration * (fromIndex - i).abs();
    if (asJs(ease).truthy()) {
      float maxDelay = total * duration;
      delay = easingDefinitionToFunction(asEasingDefinition(ease))(delay / maxDelay) * maxDelay;
    }
    return asNum(startDelay) + delay;
  };
}
