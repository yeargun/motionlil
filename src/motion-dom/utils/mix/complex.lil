import { isCSSVariableToken } from "../../animation/utils/is-css-variable";
import { color } from "../../value/types/color/index";
import {
  analyseComplexValue,
  createTransformer,
  ComplexValueInfo
} from "../../value/types/complex/index";
import { asArr, asNum, asOpt, asRec, asStr } from "../../value/types/types";
import { mixColor } from "./color";
import { mixImmediate } from "./immediate";
import { mixNumber } from "./number";
import { invisibleValues, mixVisibility } from "./visibility";

func(float)->JsValue mixNumbers(JsValue a, JsValue b) {
  return (float p) => mixNumber(asNum(a), asNum(b), p);
}

export func(JsValue, JsValue)->func(float)->JsValue getMixer(JsValue a) {
  if (a is float) {
    return mixNumbers;
  }
  if (a is string) {
    return if (isCSSVariableToken(a)) {
      mixImmediate
    } else {
      if (color.test(a)) { mixColor } else { mixComplex }
    };
  }
  if (a.isArray()) {
    return mixArray;
  }
  if (a.isObject()) {
    return if (color.test(a)) { mixColor } else { mixObject };
  }
  return mixImmediate;
}

export func(float)->JsValue mixArray(JsValue a, JsValue b) {
  JsValue[] output = [...asArr(a)];
  int numValues = output.length;
  (func(float)->JsValue)[] blendValue = [];
  for (int i = 0; i < numValues; i++) {
    JsValue v = output[i];
    blendValue.push(getMixer(v)(v, b[i]));
  }
  return (float p) => {
    for (int i = 0; i < numValues; i++) {
      output[i] = blendValue[i](p);
    }
    return output;
  };
}

export func(float)->JsValue mixObject(JsValue a, JsValue b) {
  Record<JsValue> output = record{};
  Object.assign(Object.assign(output, asRec(a)), asRec(b));
  string[] keys = [];
  (func(float)->JsValue)[] blendValue = [];
  JsValue all = output;
  for (string key in all) {
    JsValue from = a[key];
    JsValue to = b[key];
    if (asOpt(from) != null && asOpt(to) != null) {
      keys.push(key);
      blendValue.push(getMixer(from)(from, to));
    }
  }
  return (float v) => {
    for (int i = 0; i < keys.length; i++) {
      output[keys[i]] = blendValue[i](v);
    }
    return output;
  };
}

JsValue[] matchOrder(ComplexValueInfo origin, ComplexValueInfo target) {
  JsValue[] orderedOrigin = [];
  JsValue pointers = object { color: 0, var: 0, number: 0 };
  JsValue indexes = origin.indexes;
  JsValue values = origin.values;
  for (int i = 0; i < target.values.length; i++) {
    string type = target.types[i];
    JsValue pointer = pointers[type];
    orderedOrigin.push(asOpt(values[indexes[type][pointer]]) ?? 0.0);
    pointers[type] = asNum(pointer) + 1.0;
  }
  return orderedOrigin;
}

export func(float)->JsValue mixComplex(JsValue origin, JsValue target) {
  func(JsValue)->JsValue template = createTransformer(asStr(target));
  ComplexValueInfo originStats = analyseComplexValue(origin);
  ComplexValueInfo targetStats = analyseComplexValue(target);
  if (
    originStats.indexes.var.length == targetStats.indexes.var.length &&
    originStats.indexes.color.length == targetStats.indexes.color.length &&
    originStats.indexes.number.length >= targetStats.indexes.number.length
  ) {
    if (
      (invisibleValues.has(asStr(origin)) && targetStats.values.length == 0) ||
      (invisibleValues.has(asStr(target)) && originStats.values.length == 0)
    ) {
      return mixVisibility(asStr(origin), asStr(target));
    }
    func(float)->JsValue mixer = mixArray(matchOrder(originStats, targetStats), targetStats.values);
    return (float p) => template(mixer(p));
  }
  return mixImmediate(origin, target);
}

export { mixComplex as mixComplexExport };
