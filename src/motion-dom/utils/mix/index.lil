import { mixNumber as mixNumberImmediate } from "./number";
import { getMixer } from "./complex";

export JsValue mix(JsValue from, JsValue to, JsValue p) {
  if (from is float && to is float && p is float) {
    return mixNumberImmediate(from, to, p);
  }
  return getMixer(from)(from, to);
}

export { mixNumberImmediate as mixNumber };
