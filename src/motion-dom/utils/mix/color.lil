import { hex } from "../../value/types/color/hex";
import { hsla } from "../../value/types/color/hsla";
import { hslaToRgba } from "../../value/types/color/hsla-to-rgba";
import { rgba } from "../../value/types/color/rgba";
import { findType } from "../../value/types/dimensions";
import { RGBA, ValueType, asHSLA, asRGBA, asRec } from "../../value/types/types";
import { mixImmediate } from "./immediate";
import { mixNumber } from "./number";

// Linear colour space blending: https://www.youtube.com/watch?v=LKnqECcg6Gw
export float mixLinearColor(float from, float to, float v) {
  float fromExpo = from * from;
  float expo = v * (to * to - fromExpo) + fromExpo;
  return if (expo < 0.0) { 0.0 } else { expo.sqrt() };
}

ValueType[] colorTypes = [hex, rgba, hsla];

RGBA? asRGBAModel(JsValue color) {
  ValueType? type = findType(colorTypes, color);
  if (type == null) {
    return null;
  }
  JsValue model = type.parse(color);
  return if (type == hsla) { hslaToRgba(asHSLA(model)) } else { asRGBA(model) };
}

export func(float)->JsValue mixColor(JsValue from, JsValue to) {
  RGBA? fromModel = asRGBAModel(from);
  RGBA? toModel = asRGBAModel(to);
  if (fromModel == null || toModel == null) {
    return mixImmediate(from, to);
  }
  RGBA a = fromModel;
  RGBA b = toModel;
  Record<JsValue> copy = record{};
  RGBA blended = asRGBA(Object.assign(copy, asRec(a)));
  return (float v) => {
    blended.red = mixLinearColor(a.red, b.red, v);
    blended.green = mixLinearColor(a.green, b.green, v);
    blended.blue = mixLinearColor(a.blue, b.blue, v);
    blended.alpha = mixNumber(a.alpha ?? 1.0, b.alpha ?? 1.0, v);
    return rgba.transform(blended);
  };
}
