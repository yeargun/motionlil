export Set<string> invisibleValues = new Set<string>();
invisibleValues.add("none");
invisibleValues.add("hidden");

// Returns "none"/"hidden" only at the origin or target end of the progress.
export func(float)->JsValue mixVisibility(string origin, string target) {
  if (invisibleValues.has(origin)) {
    return (float p) => if (p <= 0.0) { origin } else { target };
  }
  return (float p) => if (p >= 1.0) { target } else { origin };
}
