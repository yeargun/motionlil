import { arrayFrom } from "../string-host";
import {
  arrayFromNullable,
  documentQuerySelectorAll,
  isEventTarget,
  querySelectorAll
} from "../dom-host";
import { asRec } from "../value/types/types";

export class AnimationScope {
  JsValue current;
  JsValue[] animations;

  init(JsValue current) {
    this.current = current;
    this.animations = [];
  }
}

// A selector → elements lookup consulted before querying; JavaScript callers
// pass a plain object.
export class SelectorCache {
  init() {}
}

export JsValue[] resolveElements(
  JsValue? elementOrSelector = null,
  AnimationScope? scope = null,
  SelectorCache? selectorCache = null
) {
  if (elementOrSelector == null) {
    return [];
  }
  if (isEventTarget(elementOrSelector)) {
    return [elementOrSelector];
  }
  if (elementOrSelector is string) {
    JsValue? cached = if (selectorCache != null) { asRec(selectorCache)[elementOrSelector] } else { null };
    if (cached != null) {
      return arrayFrom(cached);
    }
    return if (scope != null) {
      querySelectorAll(scope.current, elementOrSelector)
    } else {
      documentQuerySelectorAll(elementOrSelector)
    };
  }
  return arrayFromNullable(elementOrSelector);
}
