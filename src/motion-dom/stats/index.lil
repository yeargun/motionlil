import { statsBuffer } from "./buffer";
import { LayoutProjectionMetrics, StatsRecording } from "./types";

extern JsValue Error;

export func()->void recordStats = () => {
  if (statsBuffer.value != null) {
    statsBuffer.value = null;
    statsBuffer.addProjectionMetrics = null;
    throw JS.construct(Error, "Stats are already being measured");
  }
  StatsRecording recording = new StatsRecording();
  statsBuffer.value = recording;
  statsBuffer.addProjectionMetrics = (LayoutProjectionMetrics metrics) => {
    recording.layoutProjection.nodes.push(metrics.nodes);
    recording.layoutProjection.calculatedTargetDeltas.push(metrics.calculatedTargetDeltas);
    recording.layoutProjection.calculatedProjections.push(metrics.calculatedProjections);
  };
};
