import { isPressing } from "./state";
import { RHElement, PointerEvent } from "../../../render/host-views";

func(JsValue)->void filterEvents(func(JsValue)->void callback) {
  return (JsValue event) => {
    if (!JS.strictEqual(event["key"], "Enter")) {
      return;
    }
    callback(event);
  };
}

void firePointerEvent(RHElement target, string type) {
  target.dispatchEvent(JS.construct(PointerEvent, "pointer" + type, object{isPrimary: true, bubbles: true}));
}

export void enableKeyboardPress(JsValue focusEvent, JsValue eventOptions) {
  JsValue currentTarget = focusEvent["currentTarget"];
  if (!currentTarget.truthy()) {
    return;
  }
  RHElement element = JS.assume(currentTarget);
  func(JsValue)->void handleKeydown = filterEvents((JsValue _event) => {
    if (isPressing.has(element)) {
      return;
    }
    firePointerEvent(element, "down");
    element.addEventListener("keyup", filterEvents((JsValue _up) => {
      firePointerEvent(element, "up");
    }), eventOptions);
    element.addEventListener("blur", () => {
      firePointerEvent(element, "cancel");
    }, eventOptions);
  });
  element.addEventListener("keydown", handleKeydown, eventOptions);
  element.addEventListener("blur", () => {
    JS.invoke(element, "removeEventListener", "keydown", handleKeydown);
  }, eventOptions);
}
