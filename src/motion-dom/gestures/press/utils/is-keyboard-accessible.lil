import { RHSet, Set } from "../../../render/host-views";

RHSet keyboardAccessibleElements = JS.assume(JS.construct(Set, JS.array("BUTTON", "INPUT", "SELECT", "TEXTAREA", "A")));
RHSet textInputElements = JS.assume(JS.construct(Set, JS.array("INPUT", "SELECT", "TEXTAREA")));

export bool isElementKeyboardAccessible(JsValue element) {
  return keyboardAccessibleElements.has(element["tagName"]) || JS.strictEqual(element["isContentEditable"], true);
}

export bool isElementTextInput(JsValue element) {
  return textInputElements.has(element["tagName"]) || JS.strictEqual(element["isContentEditable"], true);
}
