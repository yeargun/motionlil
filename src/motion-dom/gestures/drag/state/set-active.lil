import { isDragActive, isDragging } from "./is-active";

export (func()->void)? setDragLock(JsValue axis) {
  if (JS.strictEqual(axis, "x") || JS.strictEqual(axis, "y")) {
    string name = JS.assume(axis);
    if (isDragging[name].truthy()) {
      return null;
    }
    isDragging[name] = true;
    return () => {
      isDragging[name] = false;
    };
  }
  if (isDragActive()) {
    return null;
  }
  isDragging["x"] = true;
  isDragging["y"] = true;
  return () => {
    isDragging["x"] = false;
    isDragging["y"] = false;
  };
}
