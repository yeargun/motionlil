import { setupGesture, GestureSetup } from "./utils/setup";
import { isDragActive } from "./drag/state/is-active";
import { RHElement, window } from "../render/host-views";

bool isValidHover(JsValue event) {
  return !(JS.strictEqual(event["pointerType"], "touch") || isDragActive());
}

export func()->void hover(
  JsValue elementOrSelector,
  JsValue onHoverStart,
  JsValue options = JS.undefined()
) {
  GestureSetup setup = setupGesture(elementOrSelector, JS.or(options, JS.object()));
  JsValue eventOptions = setup.eventOptions;
  func(JsValue, JsValue)->JsValue start = JS.assume(onHoverStart);
  setup.elements.forEach((JsValue node) => {
    RHElement element = JS.assume(node);
    bool isPressed = false;
    bool deferredHoverEnd = false;
    JsValue hoverEndCallback = JS.undefined();
    JsValue onPointerLeave = JS.undefined();
    JsValue onPointerUp = JS.undefined();
    func(JsValue)->void endHover = (JsValue event) => {
      if (hoverEndCallback.truthy()) {
        func(JsValue)->void end = JS.assume(hoverEndCallback);
        end(event);
        hoverEndCallback = JS.undefined();
      }
      JS.invoke(element, "removeEventListener", "pointerleave", onPointerLeave);
    };
    onPointerUp = (JsValue event) => {
      isPressed = false;
      JS.invoke(window, "removeEventListener", "pointerup", onPointerUp);
      JS.invoke(window, "removeEventListener", "pointercancel", onPointerUp);
      if (deferredHoverEnd) {
        deferredHoverEnd = false;
        endHover(event);
      }
    };
    onPointerLeave = (JsValue leaveEvent) => {
      if (JS.strictEqual(leaveEvent["pointerType"], "touch")) {
        return;
      }
      if (isPressed) {
        deferredHoverEnd = true;
        return;
      }
      endHover(leaveEvent);
    };
    element.addEventListener("pointerenter", (JsValue enterEvent) => {
      if (!isValidHover(enterEvent)) {
        return;
      }
      deferredHoverEnd = false;
      JsValue onHoverEnd = start(element, enterEvent);
      if (JS.typeOf(onHoverEnd) != "function") {
        return;
      }
      hoverEndCallback = onHoverEnd;
      element.addEventListener("pointerleave", onPointerLeave, eventOptions);
    }, eventOptions);
    element.addEventListener("pointerdown", () => {
      isPressed = true;
      JS.invoke(window, "addEventListener", "pointerup", onPointerUp, eventOptions);
      JS.invoke(window, "addEventListener", "pointercancel", onPointerUp, eventOptions);
    }, eventOptions);
  });
  return setup.cancel;
}
