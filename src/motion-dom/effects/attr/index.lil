import { FrameData } from "../../frameloop/types";
import { camelToDash } from "../../render/dom/utils/camel-to-dash";
import { MotionValue } from "../../value/index";
import { asOpt } from "../../value/types/types";
import { MotionValueState } from "../MotionValueState";
import { createSelectorEffect } from "../utils/create-dom-effect";
import { createEffect } from "../utils/create-effect";
import { DomTarget, asDomTarget, canSetAsProperty } from "../utils/dom";

export func()->void addAttrValue(
  JsValue element,
  MotionValueState state,
  string key,
  MotionValue value
) {
  bool isProp = canSetAsProperty(element, key);
  string name = if (!isProp && (key.startsWith("data") || key.startsWith("aria"))) {
    camelToDash(key)
  } else {
    key
  };
  DomTarget target = asDomTarget(element);
  // Set the attribute directly via its property where one is available.
  func(FrameData)->void render = if (isProp) {
    (FrameData _data) => {
      element[name] = state.latest[key];
    }
  } else {
    (FrameData _data) => {
      JsValue v = state.latest[key];
      if (asOpt(v) == null) {
        target.removeAttribute(name);
      } else {
        target.setAttribute(name, `${v}`);
      }
    }
  };
  return state.set(key, value, render, null, true);
}

export func(JsValue, Record<MotionValue>)->func()->void attrEffect =
  createSelectorEffect(createEffect(addAttrValue));
