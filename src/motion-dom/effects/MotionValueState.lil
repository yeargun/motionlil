import { cancelFrame, frame } from "../frameloop/frame";
import { FrameData } from "../frameloop/types";
import { MotionValue } from "../value/index";
import { numberValueType } from "../value/types/maps/number";
import { asJs } from "../value/types/types";
import { getAsType } from "../value/types/utils/get-as-type";

// This object lives in the state cache shared through WeakMap and callbacks.
// Match the host's named reference object; a copied positional value product
// cannot preserve a mutable Map's public storage representation.
shape StoredValue {
  data MotionValue value;
  data func()->void onRemove;
}

export class MotionValueState {
  JsValue latest;
  Map<string, StoredValue> values;

  init() {
    this.latest = object {};
    this.values = new Map<string, StoredValue>();
  }

  func()->void set(
    string name,
    MotionValue value,
    (func(FrameData)->void)? render,
    MotionValue? computed,
    bool useDefaultValueType
  ) {
    StoredValue? existingValue = this.values.get(name);
    if (existingValue != null) {
      existingValue.onRemove();
    }
    MotionValueState self = this;
    func(JsValue?, JsValue?, JsValue?)->void onChange = (JsValue? a, JsValue? b, JsValue? c) => {
      JsValue v = asJs(value.get());
      self.latest[name] = if (useDefaultValueType) { getAsType(v, numberValueType(name)) } else { v };
      if (render != null) {
        frame.render(render, false, false);
      }
    };
    onChange(null, null, null);
    func()->void cancelOnChange = value.on("change", onChange);
    if (computed != null) {
      value.addDependent(computed);
    }
    func()->void remove = () => {
      cancelOnChange();
      if (render != null) {
        cancelFrame(render);
      }
      self.values.delete(name);
      if (computed != null) {
        value.removeDependent(computed);
      }
    };
    this.values.set(name, StoredValue{value: value, onRemove: remove});
    return remove;
  }

  MotionValue? get(string name) {
    StoredValue? stored = this.values.get(name);
    return if (stored != null) { stored.value } else { null };
  }
}
