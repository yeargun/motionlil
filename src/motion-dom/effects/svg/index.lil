import { frame } from "../../frameloop/index";
import { FrameData } from "../../frameloop/types";
import { hasOwn } from "../../dom-host";
import { MotionValue, motionValue } from "../../value/index";
import { asNum, asOpt } from "../../value/types/types";
import { addAttrValue } from "../attr/index";
import { MotionValueState } from "../MotionValueState";
import { addStyleValue } from "../style/index";
import { createSelectorEffect } from "../utils/create-dom-effect";
import { createEffect } from "../utils/create-effect";
import { DomTarget, asDomTarget } from "../utils/dom";
import extern { stringReplace as replaceWith } from "../../string-host.ts";

extern string replaceWith(string s, Regex re, func(string, string)->string replacement);

Regex attrKeyRegex = new Regex("^attr([A-Z])", "");

func()->void addSVGPathValue(
  JsValue element,
  MotionValueState state,
  string key,
  MotionValue value
) {
  DomTarget target = asDomTarget(element);
  frame.render((FrameData _data) => target.setAttribute("pathLength", "1"), false, false);
  if (key == "pathOffset") {
    // Unitless values avoid a Safari zoom bug.
    return state.set(key, value, (FrameData _data) => {
      target.setAttribute("stroke-dashoffset", `${-asNum(state.latest[key])}`);
    }, null, true);
  }
  if (state.get("stroke-dasharray") == null) {
    state.set("stroke-dasharray", motionValue("1 1"), (FrameData _data) => {
      JsValue pathLength = asOpt(state.latest["pathLength"]) ?? 1.0;
      target.setAttribute(
        "stroke-dasharray",
        `${pathLength} ${asOpt(state.latest["pathSpacing"]) ?? 1.0 - asNum(pathLength)}`
      );
    }, null, true);
  }
  return state.set(key, value, null, state.get("stroke-dasharray"), true);
}

func()->void addSVGValue(
  JsValue element,
  MotionValueState state,
  string key,
  MotionValue value
) {
  if (key.startsWith("path")) {
    return addSVGPathValue(element, state, key, value);
  }
  if (key.startsWith("attr")) {
    return addAttrValue(
      element,
      state,
      replaceWith(key, attrKeyRegex, (string _match, string firstChar) => firstChar.toLowerCase()),
      value
    );
  }
  return if (hasOwn(element["style"], key)) {
    addStyleValue(element, state, key, value)
  } else {
    addAttrValue(element, state, key, value)
  };
}

export func(JsValue, Record<MotionValue>)->func()->void svgEffect =
  createSelectorEffect(createEffect(addSVGValue));
