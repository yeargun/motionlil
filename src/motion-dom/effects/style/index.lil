import { FrameData } from "../../frameloop/types";
import { isCSSVar } from "../../render/dom/is-css-var";
import { transformProps } from "../../render/utils/keys-transform";
import { isHTMLElement } from "../../utils/is-html-element";
import { MotionValue, motionValue } from "../../value/index";
import { asOpt } from "../../value/types/types";
import { MotionValueState } from "../MotionValueState";
import { createSelectorEffect } from "../utils/create-dom-effect";
import { createEffect } from "../utils/create-effect";
import { asStyleTarget } from "../utils/dom";
import { buildTransform } from "./transform";

string[] originProps = ["originX", "originY", "originZ"];

export func()->void addStyleValue(
  JsValue element,
  MotionValueState state,
  string key,
  MotionValue value
) {
  JsValue style = element["style"];
  (func(FrameData)->void)? render = null;
  MotionValue? computed = null;
  if (transformProps.has(key)) {
    if (state.get("transform") == null) {
      // Outside HTML, transform-box fill-box normalises the transform to the
      // element's bounding box.
      if (!isHTMLElement(element) && state.get("transformBox") == null) {
        addStyleValue(element, state, "transformBox", motionValue("fill-box"));
      }
      state.set("transform", motionValue("none"), (FrameData _data) => {
        style["transform"] = buildTransform(state);
      }, null, true);
    }
    computed = state.get("transform");
  } else if (originProps.includes(key)) {
    if (state.get("transformOrigin") == null) {
      state.set("transformOrigin", motionValue(""), (FrameData _data) => {
        style["transformOrigin"] = `${asOpt(state.latest["originX"]) ?? "50%"} ${asOpt(state.latest["originY"]) ?? "50%"} ${asOpt(state.latest["originZ"]) ?? 0.0}`;
      }, null, true);
    }
    computed = state.get("transformOrigin");
  } else if (isCSSVar(key)) {
    render = (FrameData _data) => asStyleTarget(style).setProperty(key, state.latest[key]);
  } else {
    render = (FrameData _data) => {
      style[key] = state.latest[key];
    };
  }
  return state.set(key, value, render, computed, true);
}

export func(JsValue, Record<MotionValue>)->func()->void styleEffect =
  createSelectorEffect(createEffect(addStyleValue));
