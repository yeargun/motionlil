import { transformPropOrder } from "../../render/utils/keys-transform";
import { asOpt, asStr } from "../../value/types/types";
import extern { cast as asStrOpt } from "../../value/types/cast.ts";
import { MotionValueState } from "../MotionValueState";

extern float parseFloat(string value);
extern string? asStrOpt(JsValue v);

JsValue translateAlias = object {
  x: "translateX",
  y: "translateY",
  z: "translateZ",
  transformPerspective: "perspective"
};

export string buildTransform(MotionValueState state) {
  string transform = "";
  bool transformIsDefault = true;
  // Every possible transform, in order: the present ones are written.
  for (string key of transformPropOrder) {
    JsValue value = state.latest[key];
    if (asOpt(value) != null) {
      float defaultValue = if (key.startsWith("scale")) { 1.0 } else { 0.0 };
      bool valueIsDefault = if (value is float) { value == defaultValue } else { parseFloat(asStr(value)) == defaultValue };
      if (!valueIsDefault) {
        transformIsDefault = false;
        transform += `${asStrOpt(translateAlias[key]) ?? key}(${value}) `;
      }
    }
  }
  // An additive `rotate()`, so a user `rotate` is not clobbered.
  JsValue pathRotation = state.latest["pathRotation"];
  if (pathRotation.truthy()) {
    transformIsDefault = false;
    transform += if (pathRotation is float) { `rotate(${pathRotation}deg) ` } else { `rotate(${pathRotation}) ` };
  }
  return if (transformIsDefault) { "none" } else { transform.trim() };
}
