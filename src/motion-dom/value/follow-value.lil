import { JSAnimation, createJSAnimation, jsAnimationVelocity, stopJSAnimation } from "../animation/JSAnimation";
import { animAssign3 } from "../animation/anim-host";
import { callMethod0, callMethod2 } from "../dom-host";
import { frame } from "../frameloop/index";
import { FrameData } from "../frameloop/types";
import { MotionValue, motionValue } from "./index";
import { asCallback, asNum, asRec, asStr } from "./types/types";
import { isMotionValue } from "./utils/is-motion-value";

extern float parseFloat(string v);

// The options object a JavaScript caller passes (`{ type, stiffness, … }`).
export class FollowValueOptions {
  string? type;
  float? stiffness;
  float? damping;
  float? mass;
  float? duration;
  float? restDelta;
  float? restSpeed;
  float? velocity;
  bool? skipInitialAnimation;

  init() {
    this.type = null;
    this.stiffness = null;
    this.damping = null;
    this.mass = null;
    this.duration = null;
    this.restDelta = null;
    this.restSpeed = null;
    this.velocity = null;
    this.skipInitialAnimation = null;
  }
}

Regex unitRegex = new Regex("[\\d.-]", "g");

JsValue parseValue(JsValue v, string? unit) {
  return if (unit != null && unit != "") { `${v}${unit}` } else { v };
}

float asNumber(JsValue v) {
  return if (v is float) { v } else { parseFloat(asStr(v)) };
}

// A MotionValue that animates to its latest value with any transition type;
// `source` is an initial value or a MotionValue to track.
export MotionValue followValue(JsValue source, JsValue? options = null) {
  MotionValue value = motionValue(if (isMotionValue(source)) { callMethod0(source, "get") } else { source });
  attachFollow(value, source, options);
  return value;
}

// Animates `value` whenever it is set; returns the cleanup.
export func()->void attachFollow(MotionValue value, JsValue source, JsValue? options = null) {
  JsValue? initialValue = value.get();
  JSAnimation? activeAnimation = null;
  JsValue? latestValue = initialValue;
  (func(float)->void)? latestSetter = null;
  string? unit = if (initialValue is string) { initialValue.replace(unitRegex, "") } else { null };

  func()->void stopAnimation = () => {
    JSAnimation? active = activeAnimation;
    if (active != null) {
      stopJSAnimation(active);
      activeAnimation = null;
    }
    value.animation = null;
  };

  func()->void startAnimation = () => {
    float currentValue = asNumber(value.get());
    float targetValue = asNumber(latestValue);
    if (currentValue == targetValue) {
      stopAnimation();
      return;
    }
    // The running animation's analytical velocity, else the value's own.
    JSAnimation? active = activeAnimation;
    float velocity = if (active != null) { jsAnimationVelocity(active) } else { value.getVelocity() };
    stopAnimation();
    activeAnimation = createJSAnimation(animAssign3(
      JS.object("keyframes", JS.array(currentValue, targetValue), "velocity", velocity, "type", "spring", "restDelta", 0.001, "restSpeed", 0.01),
      options,
      JS.object("onUpdate", latestSetter)
    ));
  };

  // A stable callback so the frame loop deduplicates calls within a frame.
  func(FrameData)->void scheduleAnimation = (FrameData _data) => {
    startAnimation();
    JSAnimation? active = activeAnimation;
    value.animation = active;
    value.emit("animationStart");
    if (active != null) {
      active.then(() => {
        value.animation = null;
        value.emit("animationComplete");
      }, null);
    }
  };

  value.attach((JsValue v, func(JsValue)->void set) => {
    latestValue = v;
    latestSetter = (float latest) => set(parseValue(latest, unit));
    frame.postRender(scheduleAnimation, false, false);
  }, stopAnimation);

  if (isMotionValue(source)) {
    bool skipNextAnimation = options != null && options["skipInitialAnimation"] == true;
    func()->void removeSourceOnChange = asCallback(callMethod2(source, "on", "change", (JsValue v) => {
      if (skipNextAnimation) {
        skipNextAnimation = false;
        value.jump(parseValue(v, unit), false);
      } else {
        value.set(parseValue(v, unit));
      }
    }));
    func()->void removeValueOnDestroy = value.on("destroy", (JsValue? a, JsValue? b, JsValue? c) => removeSourceOnChange());
    return () => {
      removeSourceOnChange();
      removeValueOnDestroy();
    };
  }
  return stopAnimation;
}
