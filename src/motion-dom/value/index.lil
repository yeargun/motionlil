import { SubscriptionManager } from "../../motion-utils/subscription-manager";
import { velocityPerSecond } from "../../motion-utils/velocity-per-second";
import { taskFromCallback, callFn0, callMethod0, isFunction, setProp } from "../dom-host";
import { frame } from "../frameloop/index";
import { time } from "../frameloop/sync-time";
import { FrameData } from "../frameloop/types";
import { asNum, asStr, undefined } from "./types/types";
import extern { cast as asManager } from "./types/cast.ts";
import { animAdopt, animArity, animClass } from "../animation/anim-host";

extern SubscriptionManager? asManager(JsValue v);

// ECMAScript's parseFloat converts any value to a string first.
extern float parseFloat(JsValue v);

// Maximum time between the value of two frames, beyond which the velocity is
// assumed to have since been 0.
float MAX_VELOCITY_DELTA = 30.0;

export class Owner {
  JsValue current;
  func()->JsValue getProps;

  init(JsValue current, func()->JsValue getProps) {
    this.current = current;
    this.getProps = getProps;
  }
}

export class AccelerateConfig {
  func(JsValue)->func()->void factory;
  float[] times;
  JsValue[] keyframes;
  JsValue? ease;
  float duration;
  bool? isTransformed;

  init(
    func(JsValue)->func()->void factory,
    float[] times,
    JsValue[] keyframes,
    float duration,
    JsValue? ease = null,
    bool? isTransformed = null
  ) {
    this.factory = factory;
    this.times = times;
    this.keyframes = keyframes;
    this.ease = ease;
    this.duration = duration;
    this.isTransformed = isTransformed;
  }
}

export class MotionValueOptions {
  JsValue? owner;

  init(JsValue? owner = null) {
    this.owner = owner;
  }
}

export class CollectMotionValues {
  MotionValue[]? current;

  init() {
    this.current = null;
  }
}

export CollectMotionValues collectMotionValues = new CollectMotionValues();

// Upstream's MotionValue.prototype: every value is created on it, so its
// methods are shared, as upstream's class methods are.
JsValue motionValuePrototype = JS.object();

MotionValue motionValueOf(JsValue value) {
  return JS.assume(value);
}

export class MotionValue {
  JsValue? owner;
  JsValue? current;
  JsValue? prev;
  JsValue? prevFrameValue;
  float updatedAt;
  float? prevUpdatedAt;
  (func(JsValue, func(JsValue)->void)->void)? passiveEffect;
  (func()->void)? stopPassiveEffect;
  JsValue? animation;
  bool? canTrackVelocity;
  MotionValue[]? dependents;
  JsValue events;
  bool hasAnimated;

  init(JsValue initValue) {
    this.canTrackVelocity = null;
    this.events = object {};
    this.hasAnimated = false;
    animAdopt(this, motionValuePrototype);
    this.setCurrent(initValue);
    MotionValue self = this;
    // Upstream binds this one to each value.
    setProp(this, "updateAndNotify", (JsValue v) => self.updateAndNotify(v));
  }

  void setCurrent(JsValue current) {
    this.current = current;
    this.updatedAt = time.now();
    // Upstream tests `current !== undefined`: a null value is still classified.
    if (this.canTrackVelocity == null && !JS.isUndefined(current)) {
      float parsed = parseFloat(current);
      this.canTrackVelocity = parsed == parsed;
    }
  }

  void setPrevFrameValue() {
    this.prevFrameValue = this.current;
    this.prevUpdatedAt = this.updatedAt;
  }

  void emit(string eventName, JsValue? v = JS.undefined()) {
    SubscriptionManager? manager = asManager(this.events[eventName]);
    if (manager != null) {
      manager.notify(v);
    }
  }

  func()->void onChange(func(JsValue?, JsValue?, JsValue?)->void subscription) {
    return this.on("change", subscription);
  }

  func()->void on(string eventName, func(JsValue?, JsValue?, JsValue?)->void callback) {
    SubscriptionManager manager = asManager(this.events[eventName]) ?? new SubscriptionManager();
    this.events[eventName] = manager;
    func()->void unsubscribe = manager.add(callback);
    if (eventName == "change") {
      MotionValue self = this;
      return () => {
        unsubscribe();
        // With no change listeners left by the next frame, stop animating.
        frame.read((FrameData _data) => {
          if (manager.getSize() == 0) {
            self.stop();
          }
        }, false, false);
      };
    }
    return unsubscribe;
  }

  void clearListeners() {
    for (string eventName in this.events) {
      SubscriptionManager? manager = asManager(this.events[eventName]);
      if (manager != null) {
        manager.clear();
      }
    }
  }

  void attach(
    func(JsValue, func(JsValue)->void)->void passiveEffect,
    func()->void stopPassiveEffect
  ) {
    this.passiveEffect = passiveEffect;
    this.stopPassiveEffect = stopPassiveEffect;
  }

  void set(JsValue v) {
    (func(JsValue, func(JsValue)->void)->void)? effect = this.passiveEffect;
    if (effect == null) {
      this.updateAndNotify(v);
    } else {
      MotionValue self = this;
      effect(v, (JsValue latest) => self.updateAndNotify(latest));
    }
  }

  void setWithVelocity(JsValue prev, JsValue current, float delta) {
    this.set(current);
    this.prev = null;
    this.prevFrameValue = prev;
    this.prevUpdatedAt = this.updatedAt - delta;
  }

  void jump(JsValue v, bool endAnimation = true) {
    this.updateAndNotify(v);
    this.prev = v;
    this.prevUpdatedAt = null;
    this.prevFrameValue = null;
    if (endAnimation) {
      this.stop();
    }
    (func()->void)? stopEffect = this.stopPassiveEffect;
    if (stopEffect != null) {
      stopEffect();
    }
  }

  void dirty() {
    this.emit("change", this.current);
  }

  void addDependent(MotionValue dependent) {
    MotionValue[] dependents = this.dependents ?? [];
    this.dependents = dependents;
    if (!dependents.includes(dependent)) {
      dependents.push(dependent);
    }
  }

  void removeDependent(MotionValue dependent) {
    MotionValue[]? dependents = this.dependents;
    if (dependents != null) {
      int index = dependents.indexOf(dependent);
      if (index > -1) {
        dependents.splice(index, 1);
      }
    }
  }

  void updateAndNotify(JsValue v) {
    // Updating during a later frame or event loop than the previous one:
    // the previous frame value is the current one.
    if (this.updatedAt != time.now()) {
      this.setPrevFrameValue();
    }
    this.prev = this.current;
    this.setCurrent(v);
    if (this.current != this.prev) {
      this.emit("change", this.current);
      MotionValue[]? dependents = this.dependents;
      if (dependents != null) {
        for (MotionValue dependent of dependents) {
          dependent.dirty();
        }
      }
    }
  }

  JsValue? get() {
    MotionValue[]? collected = collectMotionValues.current;
    if (collected != null) {
      collected.push(this);
    }
    return this.current;
  }

  JsValue? getPrevious() {
    return this.prev;
  }

  float getVelocity() {
    // Read the synchronous time first, as upstream does: reading it caches it
    // for the rest of the event-loop turn.
    float currentTime = time.now();
    if (
      this.canTrackVelocity != true ||
      this.prevFrameValue == null ||
      currentTime - this.updatedAt > MAX_VELOCITY_DELTA
    ) {
      return 0.0;
    }
    return velocityPerSecond(
      parseFloat(this.current) - parseFloat(this.prevFrameValue),
      (this.updatedAt - asNum(this.prevUpdatedAt)).min(MAX_VELOCITY_DELTA)
    );
  }

  Task<JsValue> start(func(func()->void)->JsValue? startAnimation) {
    this.stop();
    MotionValue self = this;
    return taskFromCallback((func()->void resolve) => {
      self.hasAnimated = true;
      self.animation = startAnimation(resolve);
      self.emit("animationStart");
    }).then((bool _done) => {
      self.emit("animationComplete");
      self.clearAnimation();
      // Upstream's promise settles with nothing.
      return JS.undefined();
    });
  }

  void stop() {
    JsValue? animation = this.animation;
    if (animation != null) {
      if (isFunction(animation["stop"])) {
        callMethod0(animation, "stop");
      } else {
        JsValue stopActive = animation["stopActive"];
        if (isFunction(stopActive)) {
          callFn0(stopActive);
        }
      }
      this.emit("animationCancel");
    }
    this.clearAnimation();
  }

  bool isAnimating() {
    return this.animation != null;
  }

  void clearAnimation() {
    this.animation = null;
  }

  void destroy() {
    this.dependents = null;
    this.emit("destroy");
    this.clearListeners();
    this.stop();
    (func()->void)? stopEffect = this.stopPassiveEffect;
    if (stopEffect != null) {
      stopEffect();
    }
  }
}

export MotionValue motionValue(JsValue initValue, JsValue? options = null) {
  MotionValue value = new MotionValue(initValue);
  if (options != null) {
    value.owner = options["owner"];
  }
  return value;
}

// Upstream's public `MotionValue` class (`new MotionValue(init, options)`):
// its prototype methods, with upstream's declared parameter counts.
export JsValue motionValueConstructor = animClass(
  (JsValue initial, JsValue options) => motionValue(initial, options),
  motionValuePrototype,
  JS.object(
    "setCurrent", JS.object("value", JS.method1((JsValue self, JsValue current) => {
      motionValueOf(self).setCurrent(current);
      return JS.undefined();
    })),
    "onChange", JS.object("value", JS.method1((JsValue self, JsValue subscription) =>
      motionValueOf(self).on("change", JS.assume(subscription)))),
    "on", JS.object("value", JS.method2((JsValue self, JsValue eventName, JsValue callback) =>
      motionValueOf(self).on(JS.assume(eventName), JS.assume(callback)))),
    "clearListeners", JS.object("value", JS.method0((JsValue self) => {
      motionValueOf(self).clearListeners();
      return JS.undefined();
    })),
    "attach", JS.object("value", JS.method2((JsValue self, JsValue passiveEffect, JsValue stopPassiveEffect) => {
      motionValueOf(self).attach(JS.assume(passiveEffect), JS.assume(stopPassiveEffect));
      return JS.undefined();
    })),
    "set", JS.object("value", JS.method1((JsValue self, JsValue v) => {
      motionValueOf(self).set(v);
      return JS.undefined();
    })),
    "setWithVelocity", JS.object("value", JS.method3((JsValue self, JsValue prev, JsValue current, JsValue delta) => {
      motionValueOf(self).setWithVelocity(prev, current, JS.assume(delta));
      return JS.undefined();
    })),
    "jump", JS.object("value", animArity(JS.methodRest((JsValue self, JsValue args) => {
      JsValue endAnimation = args[1];
      motionValueOf(self).jump(args[0], JS.isUndefined(endAnimation) || endAnimation.truthy());
      return JS.undefined();
    }), 1.0)),
    "dirty", JS.object("value", JS.method0((JsValue self) => {
      motionValueOf(self).dirty();
      return JS.undefined();
    })),
    "addDependent", JS.object("value", JS.method1((JsValue self, JsValue dependent) => {
      motionValueOf(self).addDependent(JS.assume(dependent));
      return JS.undefined();
    })),
    "removeDependent", JS.object("value", JS.method1((JsValue self, JsValue dependent) => {
      motionValueOf(self).removeDependent(JS.assume(dependent));
      return JS.undefined();
    })),
    "get", JS.object("value", JS.method0((JsValue self) => motionValueOf(self).get())),
    "getPrevious", JS.object("value", JS.method0((JsValue self) => motionValueOf(self).prev)),
    "getVelocity", JS.object("value", JS.method0((JsValue self) => motionValueOf(self).getVelocity())),
    "start", JS.object("value", JS.method1((JsValue self, JsValue startAnimation) =>
      motionValueOf(self).start(JS.assume(startAnimation)))),
    "stop", JS.object("value", JS.method0((JsValue self) => {
      motionValueOf(self).stop();
      return JS.undefined();
    })),
    "isAnimating", JS.object("value", JS.method0((JsValue self) => motionValueOf(self).animation != null)),
    "clearAnimation", JS.object("value", JS.method0((JsValue self) => {
      motionValueOf(self).clearAnimation();
      return JS.undefined();
    })),
    "destroy", JS.object("value", JS.method0((JsValue self) => {
      motionValueOf(self).destroy();
      return JS.undefined();
    }))
  )
);
