import { attachFollow, followValue } from "./follow-value";
import { MotionValue } from "./index";
import { asRec } from "./types/types";

JsValue springOptions(JsValue? options) {
  JsValue springOptions = object { type: "spring" };
  Object.assign(asRec(springOptions), asRec(options));
  return springOptions;
}

// A MotionValue that animates to its latest value with a spring.
export MotionValue springValue(JsValue source, JsValue? options = null) {
  return followValue(source, springOptions(options));
}

export func()->void attachSpring(MotionValue value, JsValue source, JsValue? options = null) {
  return attachFollow(value, source, springOptions(options));
}
