import { MotionGlobalConfig } from "../../../motion-utils/global-config";
import { callMethod1, constructConfigured } from "../../dom-host";
import { visualElementOf } from "../../cast";
import { isWillChangeMotionValue } from "./is";

export void addValueToWillChange(JsValue visualElement, string key) {
  VisualElement element = visualElementOf(visualElement);
  JsValue? willChange = element.getValue("willChange");
  // A user may have set willChange to a regular MotionValue.
  if (isWillChangeMotionValue(willChange)) {
    callMethod1(willChange, "add", key);
    return;
  }
  JsValue? WillChange = MotionGlobalConfig.WillChange;
  if (willChange == null && WillChange != null) {
    JsValue newWillChange = constructConfigured(WillChange, "auto");
    element.addValue("willChange", newWillChange);
    callMethod1(newWillChange, "add", key);
  }
}

import { VisualElement } from "../../render/VisualElement";
