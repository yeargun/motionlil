export class RGBA {
  float red;
  float green;
  float blue;
  float alpha;

  init(float red = 0.0, float green = 0.0, float blue = 0.0, float alpha = 1.0) {
    this.red = red;
    this.green = green;
    this.blue = blue;
    this.alpha = alpha;
  }
}

export class HSLA {
  float hue;
  float saturation;
  float lightness;
  float alpha;

  init(float hue = 0.0, float saturation = 0.0, float lightness = 0.0, float alpha = 1.0) {
    this.hue = hue;
    this.saturation = saturation;
    this.lightness = lightness;
    this.alpha = alpha;
  }
}

export extern class ValueType {
  func(JsValue)->bool test;
  func(JsValue)->JsValue parse;
  (func(JsValue)->JsValue)? transform;
  (func(string)->func(JsValue)->JsValue)? createTransformer;
  JsValue? default;
  (func(JsValue)->JsValue)? getAnimatableNone;

}

export pure ValueType valueTypeRecord(JsValue value) { return JS.assume(value); }

export pure ValueType? optionalValueType(JsValue value) { return JS.assume(value); }
