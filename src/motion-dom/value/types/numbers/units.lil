import { ValueType, valueType, asNum } from "../types";

extern float parseFloat(string v);

ValueType createUnitType(string unit) {
  return valueType(object {
    test: (JsValue v) => v is string && v.endsWith(unit) && v.split(" ").length == 1,
    parse: parseFloat,
    transform: (JsValue v) => `${v}${unit}`
  });
}

export ValueType degrees = createUnitType("deg");
export ValueType percent = createUnitType("%");
export ValueType px = createUnitType("px");
export ValueType vh = createUnitType("vh");
export ValueType vw = createUnitType("vw");

export ValueType progressPercentage = valueType(object {
  test: percent.test,
  parse: (JsValue v) => asNum(percent.parse(v)) / 100.0,
  transform: (JsValue v) => percent.transform(asNum(v) * 100.0)
});
