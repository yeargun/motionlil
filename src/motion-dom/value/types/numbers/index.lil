import { clamp } from "../../../../motion-utils/clamp";
import { ValueType, valueTypeRecord } from "../types";

extern float parseFloat(string v);

export ValueType numberType = valueTypeRecord(object{test: (JsValue v) => v is float, parse: (JsValue v) => {
    if (v is float) {
      return v;
    }
    if (v is string) {
      return parseFloat(v);
    }
    return 0.0;
  }, transform: (JsValue v) => v});

export ValueType alpha = valueTypeRecord(object{test: numberType.test, parse: numberType.parse, transform: (JsValue v) => {
    float n = 0.0;
    if (v is float) {
      n = v;
    }
    return clamp(0.0, 1.0, n);
  }});

export ValueType scale = valueTypeRecord(object{test: numberType.test, parse: numberType.parse, transform: numberType.transform, default: 1.0});
