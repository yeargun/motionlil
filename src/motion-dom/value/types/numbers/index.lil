import { clamp } from "../../../../motion-utils/clamp";
import { ValueType, valueType, asNum } from "../types";

extern float parseFloat(JsValue v);

export func(JsValue)->bool isNumber = (JsValue v) => v is float;

export ValueType numberType = valueType(object {
  test: isNumber,
  parse: parseFloat,
  transform: (JsValue v) => v
});

export ValueType alpha = valueType(object {
  test: isNumber,
  parse: parseFloat,
  transform: (JsValue v) => clamp(0.0, 1.0, asNum(v))
});

export ValueType scale = valueType(object {
  test: isNumber,
  parse: parseFloat,
  transform: numberType.transform,
  default: 1.0
});
