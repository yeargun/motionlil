import { ValueType } from "../types";
import extern { cast as asValueType } from "../cast.ts";

extern ValueType? asValueType(JsValue v);

export class ValueTypeMap {
  JsValue entries;

  init(JsValue entries) {
    this.entries = entries;
  }

  ValueType? get(string key) {
    return asValueType(this.entries[key]);
  }
}
