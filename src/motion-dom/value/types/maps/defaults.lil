import { color } from "../color/index";
import { filter } from "../complex/filter";
import { mask } from "../complex/mask";
import { ValueType, asRec } from "../types";
import extern { cast as asValueType } from "../cast.ts";

extern ValueType? asValueType(JsValue v);
import { numberValueTypes } from "./number";

// Default value types for common values.
export JsValue defaultValueTypes = Object.assign(
  Object.assign(asRec(object {}), asRec(numberValueTypes)),
  asRec(object {
    // Color props
    color: color,
    backgroundColor: color,
    outlineColor: color,
    fill: color,
    stroke: color,
    // Border props
    borderColor: color,
    borderTopColor: color,
    borderRightColor: color,
    borderBottomColor: color,
    borderLeftColor: color,
    filter: filter,
    WebkitFilter: filter,
    mask: mask,
    WebkitMask: mask
  })
);

export ValueType? getDefaultValueType(string key) {
  return asValueType(defaultValueTypes[key]);
}
