import { color } from "../color/index";
import { colorRegex } from "../utils/color-regex";
import { floatRegex } from "../utils/float-regex";
import { sanitize } from "../utils/sanitize";
import { ValueType, valueType, asNum, asOpt } from "../types";
import extern { stringMatch as matchAll } from "../../../string-host.ts";
import { stringReplace } from "../../../string-host";

extern float parseFloat(string v);
extern bool isNaN(JsValue v);
extern string[]? matchAll(string s, Regex re);

string NUMBER_TOKEN = "number";
string COLOR_TOKEN = "color";
string VAR_TOKEN = "var";
string VAR_FUNCTION_TOKEN = "var(";
string SPLIT_TOKEN = "${}";

// singleCssVariableRegex | rgbHSLValueRegex | digitRegex
Regex complexRegex = new Regex(
  "var\\s*\\(\\s*--(?:[\\w-]+\\s*|[\\w-]+\\s*,(?:\\s*[^)(\\s]|\\s*\\((?:[^)(]|\\([^)(]*\\))*\\))+\\s*)\\)|#[\\da-f]{3,8}|(?:rgb|hsl)a?\\((?:-?[\\d.]+%?[,\\s]+){2}-?[\\d.]+%?\\s*(?:[,/]\\s*)?(?:\\b\\d+(?:\\.\\d+)?|\\.\\d+)?%?\\)|-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)",
  "giu"
);

export class ValueIndexes {
  int[] color;
  int[] number;
  int[] var;

  init() {
    this.color = [];
    this.number = [];
    this.var = [];
  }
}

export class ComplexValueInfo {
  JsValue[] values;
  string[] split;
  ValueIndexes indexes;
  string[] types;

  init(JsValue[] values, string[] split, ValueIndexes indexes, string[] types) {
    this.values = values;
    this.split = split;
    this.indexes = indexes;
    this.types = types;
  }
}

export ComplexValueInfo analyseComplexValue(JsValue value) {
  JsValue[] values = [];
  ValueIndexes indexes = new ValueIndexes();
  string[] types = [];
  int i = 0;
  string tokenised = stringReplace(`${value}`, complexRegex, (string parsedValue) => {
    if (color.test(parsedValue)) {
      indexes.color.push(i);
      types.push(COLOR_TOKEN);
      values.push(color.parse(parsedValue));
    } else if (parsedValue.startsWith(VAR_FUNCTION_TOKEN)) {
      indexes.var.push(i);
      types.push(VAR_TOKEN);
      values.push(parsedValue);
    } else {
      indexes.number.push(i);
      types.push(NUMBER_TOKEN);
      values.push(parseFloat(parsedValue));
    }
    i++;
    return SPLIT_TOKEN;
  });
  return new ComplexValueInfo(values, tokenised.split(SPLIT_TOKEN), indexes, types);
}

export func(JsValue)->string buildTransformer(ComplexValueInfo info) {
  string[] split = info.split;
  string[] types = info.types;
  int numSections = split.length;
  return (JsValue v) => {
    string output = "";
    for (int i = 0; i < numSections; i++) {
      output += split[i];
      JsValue current = v[i];
      if (asOpt(current) != null) {
        string type = types[i];
        if (type == NUMBER_TOKEN) {
          output += `${sanitize(asNum(current))}`;
        } else if (type == COLOR_TOKEN) {
          output += `${color.transform(current)}`;
        } else {
          output += `${current}`;
        }
      }
    }
    return output;
  };
}

export JsValue[] parseComplexValue(JsValue v) {
  return analyseComplexValue(v).values;
}

export func(JsValue)->JsValue createTransformer(string source) {
  return buildTransformer(analyseComplexValue(source));
}

JsValue convertToZero(JsValue value, string splitBefore) {
  if (value is float) {
    return if (splitBefore.trim().endsWith("/")) { value } else { 0.0 };
  }
  return if (color.test(value)) { color.getAnimatableNone(value) } else { value };
}

JsValue getAnimatableNone(JsValue v) {
  ComplexValueInfo info = analyseComplexValue(v);
  JsValue[] zeroed = [];
  for (int i = 0; i < info.values.length; i++) {
    zeroed.push(convertToZero(info.values[i], info.split[i]));
  }
  return buildTransformer(info)(zeroed);
}

export bool complexTest(JsValue v) {
  return isNaN(v) && v is string &&
    (matchAll(v, floatRegex) != null || matchAll(v, colorRegex) != null);
}

export ValueType complex = valueType(object {
  test: complexTest,
  parse: parseComplexValue,
  createTransformer: createTransformer,
  getAnimatableNone: getAnimatableNone
});

export { createTransformer as createComplexTransformer };
