import { complexTest, createTransformer, parseComplexValue } from "./index";
import { ValueType, valueType, asRec, asStr } from "../types";

export ValueType mask = valueType(object {
  test: complexTest,
  parse: parseComplexValue,
  createTransformer: createTransformer,
  getAnimatableNone: (JsValue v) => {
    JsValue[] parsed = parseComplexValue(v);
    func(JsValue)->JsValue transformer = createTransformer(asStr(v));
    return transformer(parsed.map((JsValue item) => {
      if (item is float) {
        return 0.0;
      }
      if (item.isObject()) {
        Record<JsValue> opaque = record{};
        Object.assign(opaque, asRec(item))["alpha"] = 1.0;
        return opaque;
      }
      return item;
    }));
  }
});
