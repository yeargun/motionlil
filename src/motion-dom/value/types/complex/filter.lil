import { complexTest, createTransformer, parseComplexValue } from "./index";
import { floatRegex } from "../utils/float-regex";
import { ValueType, valueType, asStr } from "../types";
import extern { stringMatch as matchAll, stringReplace as replaceText } from "../../../string-host.ts";

extern string[]? matchAll(string s, Regex re);
extern string replaceText(string s, string pattern, string replacement);

// Properties that default to 1 or 100%.
string[] maxDefaults = ["brightness", "contrast", "saturate", "opacity"];

string applyDefaultFilter(string v) {
  string[] parts = v.slice(0, -1).split("(");
  string name = parts[0];
  string value = parts[1];
  if (name == "drop-shadow") {
    return v;
  }
  string[]? numbers = matchAll(value, floatRegex);
  if (numbers == null) {
    return v;
  }
  string num = numbers[0];
  float defaultValue = if (maxDefaults.includes(name)) { 1.0 } else { 0.0 };
  if (num != value) {
    defaultValue *= 100.0;
  }
  return `${name}(${defaultValue}${replaceText(value, num, "")})`;
}

Regex functionRegex = new Regex("\\b([a-z-]*)\\(.*?\\)", "gu");

export ValueType filter = valueType(object {
  test: complexTest,
  parse: parseComplexValue,
  createTransformer: createTransformer,
  getAnimatableNone: (JsValue v) => {
    string[]? functions = matchAll(asStr(v), functionRegex);
    return if (functions != null) { functions.map(applyDefaultFilter).join(" ") } else { v };
  }
});
