import { HSLA, RGBA, asRGBA } from "../types";

float hueToRgb(float p, float q, float t) {
  if (t < 0.0) {
    t += 1.0;
  }
  if (t > 1.0) {
    t -= 1.0;
  }
  if (t < 1.0 / 6.0) {
    return p + (q - p) * 6.0 * t;
  }
  if (t < 1.0 / 2.0) {
    return q;
  }
  if (t < 2.0 / 3.0) {
    return p + (q - p) * (2.0 / 3.0 - t) * 6.0;
  }
  return p;
}

export RGBA hslaToRgba(HSLA color) {
  float hue = color.hue / 360.0;
  float saturation = color.saturation / 100.0;
  float lightness = color.lightness / 100.0;
  float red = lightness;
  float green = lightness;
  float blue = lightness;
  if (saturation != 0.0) {
    float q = if (lightness < 0.5) {
      lightness * (1.0 + saturation)
    } else {
      lightness + saturation - lightness * saturation
    };
    float p = 2.0 * lightness - q;
    red = hueToRgb(p, q, hue + 1.0 / 3.0);
    green = hueToRgb(p, q, hue);
    blue = hueToRgb(p, q, hue - 1.0 / 3.0);
  }
  return asRGBA(object {
    red: (red * 255.0).round(),
    green: (green * 255.0).round(),
    blue: (blue * 255.0).round(),
    alpha: color.alpha
  });
}
