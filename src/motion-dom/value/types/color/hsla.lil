import { alpha as alphaType } from "../numbers/index";
import { HSLA, ValueType, valueType, asNum, asHSLA } from "../types";
import { sanitize } from "../utils/sanitize";
import { isColorString, splitColor } from "./utils";

export ValueType hsla = valueType(object {
  test: isColorString("hsl", "hue"),
  parse: splitColor("hue", "saturation", "lightness"),
  transform: (JsValue v) => {
    HSLA c = asHSLA(v);
    return `hsla(${c.hue.round()}, ${sanitize(c.saturation)}%, ${sanitize(c.lightness)}%, ${sanitize(asNum(alphaType.transform(c.alpha ?? 1.0)))})`;
  }
});
