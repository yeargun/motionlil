import { floatRegex } from "../utils/float-regex";
import { singleColorRegex } from "../utils/single-color-regex";
import { asOpt, asRec, asStr } from "../types";
import extern { stringMatch as matchList } from "../../../string-host.ts";

extern float parseFloat(JsValue v);
extern JsValue[] matchList(string s, Regex re);

// True for a single colour string of this model ("rgb…", "hsl…", "#…"), or
// for a parsed colour object carrying the model's own key.
export func(JsValue)->bool isColorString(string type, string? testProp = null) {
  return (JsValue v) =>
    (v is string && singleColorRegex.test(v) && v.startsWith(type)) ||
    (testProp != null && asOpt(v) != null && Object.hasOwn(asRec(v), testProp));
}

export func(JsValue)->JsValue splitColor(string aName, string bName, string cName) {
  return (JsValue v) => {
    if (!(v is string)) {
      return v;
    }
    JsValue[] parts = matchList(v, floatRegex);
    Record<float> color = record{};
    color[aName] = parseFloat(asStr(parts[0]));
    color[bName] = parseFloat(asStr(parts[1]));
    color[cName] = parseFloat(asStr(parts[2]));
    color["alpha"] = if (parts.length > 3) { parseFloat(asStr(parts[3])) } else { 1.0 };
    return color;
  };
}
