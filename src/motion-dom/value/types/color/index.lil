import { ValueType, valueType, asRec, asRGBA } from "../types";
import { hex } from "./hex";
import { hsla } from "./hsla";
import { rgba } from "./rgba";

JsValue colorParse(JsValue v) {
  if (rgba.test(v)) {
    return rgba.parse(v);
  }
  return if (hsla.test(v)) { hsla.parse(v) } else { hex.parse(v) };
}

JsValue colorTransform(JsValue v) {
  if (v is string) {
    return v;
  }
  return if (Object.hasOwn(asRec(v), "red")) { rgba.transform(v) } else { hsla.transform(v) };
}

export ValueType color = valueType(object {
  test: (JsValue v) => rgba.test(v) || hex.test(v) || hsla.test(v),
  parse: colorParse,
  transform: colorTransform,
  getAnimatableNone: (JsValue v) => {
    JsValue parsed = colorParse(v);
    asRGBA(parsed).alpha = 0.0;
    return colorTransform(parsed);
  }
});

export { hex, hsla, rgba };
