import { ValueType, valueType, asStr } from "../types";
import { rgba } from "./rgba";
import { isColorString } from "./utils";

extern float parseInt(string v, int radix);

// "#rrggbb[aa]" or the "#rgb[a]" shorthand.
JsValue parseHex(JsValue value) {
  string v = asStr(value);
  func(int)->string channel = (int i) => if (v.length > 5) {
    v.slice(2 * i + 1, 2 * i + 3)
  } else {
    v.slice(i + 1, i + 2).repeat(2)
  };
  string a = channel(3);
  return object {
    red: parseInt(channel(0), 16),
    green: parseInt(channel(1), 16),
    blue: parseInt(channel(2), 16),
    alpha: if (a != "") { parseInt(a, 16) / 255.0 } else { 1.0 }
  };
}

export ValueType hex = valueType(object {
  test: isColorString("#"),
  parse: parseHex,
  transform: rgba.transform
});
