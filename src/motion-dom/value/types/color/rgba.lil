import { clamp } from "../../../../motion-utils/clamp";
import { alpha as alphaType, isNumber } from "../numbers/index";
import { RGBA, ValueType, valueType, asNum, asRGBA } from "../types";
import { sanitize } from "../utils/sanitize";
import { isColorString, splitColor } from "./utils";

extern float parseFloat(string v);

float rgbUnitTransform(JsValue v) {
  return clamp(0.0, 255.0, asNum(v)).round();
}

export ValueType rgbUnit = valueType(object {
  test: isNumber,
  parse: parseFloat,
  transform: rgbUnitTransform
});

export ValueType rgba = valueType(object {
  test: isColorString("rgb", "red"),
  parse: splitColor("red", "green", "blue"),
  transform: (JsValue v) => {
    RGBA c = asRGBA(v);
    return `rgba(${rgbUnitTransform(c.red)}, ${rgbUnitTransform(c.green)}, ${rgbUnitTransform(c.blue)}, ${sanitize(asNum(alphaType.transform(c.alpha ?? 1.0)))})`;
  }
});
