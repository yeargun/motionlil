import { isSVGElement } from "../utils/is-svg-element";
import { resolveElements } from "../utils/resolve-elements";
import { RHObserver, RHSet, RHWeakMap, WeakMap, Set, ResizeObserver } from "../render/host-views";

RHWeakMap resizeHandlers = JS.assume(JS.construct(WeakMap));
JsValue observer = JS.undefined();

JsValue getSize(string borderBoxAxis, string svgAxis, string htmlAxis, JsValue target, JsValue borderBoxSize) {
  if (JS.and(borderBoxSize, borderBoxSize[0]).truthy()) {
    return borderBoxSize[0][borderBoxAxis];
  }
  if (isSVGElement(target) && JS.in("getBBox", target)) {
    return JS.invoke(target, "getBBox")[svgAxis];
  }
  return target[htmlAxis];
}

void notifyTarget(JsValue entry) {
  JsValue target = entry["target"];
  JsValue borderBoxSize = entry["borderBoxSize"];
  JsValue handlers = resizeHandlers.get(target);
  if (handlers.truthy()) {
    RHSet set = JS.assume(handlers);
    set.forEach((JsValue handler) => {
      func(JsValue, JsValue)->void notify = JS.assume(handler);
      notify(target, object{
        width: getSize("inlineSize", "width", "offsetWidth", target, borderBoxSize),
        height: getSize("blockSize", "height", "offsetHeight", target, borderBoxSize)
      });
    });
  }
}

export func()->void resizeElement(JsValue target, JsValue handler) {
  if (!observer.truthy() && JS.typeOf(ResizeObserver) != "undefined") {
    observer = JS.construct(ResizeObserver, (JsValue entries) => {
      JS.invoke(entries, "forEach", notifyTarget);
    });
  }
  JsValue[] elements = resolveElements(target);
  elements.forEach((JsValue element) => {
    JsValue elementHandlers = resizeHandlers.get(element);
    if (!elementHandlers.truthy()) {
      elementHandlers = JS.construct(Set);
      resizeHandlers.set(element, elementHandlers);
    }
    RHSet set = JS.assume(elementHandlers);
    set.add(handler);
    if (observer.truthy()) {
      RHObserver obs = JS.assume(observer);
      obs.observe(element);
    }
  });
  return () => {
    elements.forEach((JsValue element) => {
      JsValue elementHandlers = resizeHandlers.get(element);
      if (elementHandlers.truthy()) {
        RHSet set = JS.assume(elementHandlers);
        set.delete(handler);
      }
      if (!JS.and(elementHandlers, elementHandlers["size"]).truthy() && observer.truthy()) {
        RHObserver obs = JS.assume(observer);
        obs.unobserve(element);
      }
    });
  };
}
