import { resizeElement } from "./handle-element";
import { resizeWindow } from "./handle-window";
import { ResizeInfo } from "./types";

export func()->void resize(JsValue a, JsValue b = JS.undefined()) {
  return if (JS.typeOf(a) == "function") { resizeWindow(a) } else { resizeElement(a, b) };
}

export { resizeElement, resizeWindow, ResizeInfo };
