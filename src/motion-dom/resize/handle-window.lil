import { RHSet, window, Set } from "../render/host-views";

RHSet windowCallbacks = JS.assume(JS.construct(Set));
JsValue windowResizeHandler = JS.undefined();

export func()->void resizeWindow(JsValue callback) {
  windowCallbacks.add(callback);
  if (!windowResizeHandler.truthy()) {
    windowResizeHandler = () => {
      JsValue info = object{width: window["innerWidth"], height: window["innerHeight"]};
      windowCallbacks.forEach((JsValue handler) => {
        func(JsValue)->void notify = JS.assume(handler);
        notify(info);
      });
    };
    JS.invoke(window, "addEventListener", "resize", windowResizeHandler);
  }
  return () => {
    windowCallbacks.delete(callback);
    if (!windowCallbacks.size.truthy() && JS.typeOf(windowResizeHandler) == "function") {
      JS.invoke(window, "removeEventListener", "resize", windowResizeHandler);
      windowResizeHandler = JS.undefined();
    }
  };
}
