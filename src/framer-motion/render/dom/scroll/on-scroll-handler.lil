import { updateScrollInfo } from "./info";
import { resolveOffsets } from "./offsets/index";
import { OnScrollHandler, RHElement, ScrollInfo } from "./types";

void measure(RHElement container, JsValue targetValue, ScrollInfo info) {
  RHElement target = JS.assume(if (JS.isUndefined(targetValue)) { container } else { targetValue });
  info.x.targetOffset = 0.0;
  info.y.targetOffset = 0.0;
  if (target != container) {
    JsValue node = target;
    while (node.truthy() && !JS.strictEqual(node, container)) {
      RHElement current = JS.assume(node);
      info.x.targetOffset += current.offsetLeft;
      info.y.targetOffset += current.offsetTop;
      node = current.offsetParent;
    }
  }
  info.x.targetLength = if (target == container) { target.scrollWidth } else { target.clientWidth };
  info.y.targetLength = if (target == container) { target.scrollHeight } else { target.clientHeight };
  info.x.containerLength = container.clientWidth;
  info.y.containerLength = container.clientHeight;
}

export OnScrollHandler createOnScrollHandler(
  RHElement element,
  func(ScrollInfo)->void onScroll,
  ScrollInfo info,
  JsValue options
) {
  return new OnScrollHandler(
    (float time) => {
      measure(element, options["target"], info);
      updateScrollInfo(element, info, time);
      if (JS.or(options["offset"], options["target"]).truthy()) {
        resolveOffsets(element, info, options);
      }
    },
    () => {
      onScroll(info);
    }
  );
}
