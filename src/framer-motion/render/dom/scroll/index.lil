import { attachToAnimation } from "./attach-animation";
import { attachToFunction } from "./attach-function";
import { document } from "./types";

export func()->void scroll(JsValue onScroll, JsValue options = JS.undefined()) {
  JsValue resolved = JS.or(options, JS.object());
  JsValue axis = resolved["axis"];
  JsValue container = resolved["container"];
  if (JS.isUndefined(container)) {
    container = document["scrollingElement"];
  }
  if (!container.truthy()) {
    return () => {};
  }
  JsValue optionsWithDefaults = object{axis: if (JS.isUndefined(axis)) { "y" } else { axis }, container: container};
  for (string key in resolved) {
    if (key != "axis" && key != "container") {
      optionsWithDefaults[key] = resolved[key];
    }
  }
  return if (JS.typeOf(onScroll) == "function") {
    attachToFunction(onScroll, optionsWithDefaults)
  } else {
    attachToAnimation(onScroll, optionsWithDefaults)
  };
}
