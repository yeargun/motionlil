import { progress } from "../../../../motion-utils/progress";
import { velocityPerSecond } from "../../../../motion-utils/velocity-per-second";
import { AxisScrollInfo, RHElement, ScrollInfo } from "./types";

export ScrollInfo createScrollInfo() {
  return new ScrollInfo();
}

void updateAxisInfo(AxisScrollInfo axis, float current, float scrollLength, float prevTime, float time) {
  float prev = axis.current;
  axis.current = current.abs();
  axis.scrollLength = scrollLength;
  axis.offset.length = 0;
  axis.offset.push(0.0);
  axis.offset.push(scrollLength);
  axis.progress = progress(0.0, scrollLength, axis.current);
  float elapsed = time - prevTime;
  axis.velocity = if (elapsed > 50.0) { 0.0 } else { velocityPerSecond(axis.current - prev, elapsed) };
}

export void updateScrollInfo(RHElement element, ScrollInfo info, float time) {
  updateAxisInfo(info.x, element.scrollLeft, element.scrollWidth - element.clientWidth, info.time, time);
  updateAxisInfo(info.y, element.scrollTop, element.scrollHeight - element.clientHeight, info.time, time);
  info.time = time;
}
