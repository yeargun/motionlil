import { defaultOffsetFloats } from "../../../../../motion-dom/animation/keyframes/offsets/default";
import { interpolate, InterpolateOptions } from "../../../../../motion-dom/utils/interpolate";
import { clamp } from "../../../../../motion-utils/clamp";
import { AxisScrollInfo, RHElement, ScrollInfo } from "../types";
import { calcInset, InsetPoint } from "./inset";
import { resolveOffset } from "./offset";
import { scrollOffsetAll } from "./presets";

InsetPoint point = new InsetPoint();

export void resolveOffsets(RHElement container, ScrollInfo info, JsValue options) {
  JsValue offsetDefinition = options["offset"];
  if (JS.isUndefined(offsetDefinition)) {
    offsetDefinition = scrollOffsetAll;
  }
  JsValue targetValue = options["target"];
  RHElement target = JS.assume(if (JS.isUndefined(targetValue)) { container } else { targetValue });
  bool isY = !JS.strictEqual(options["axis"], "x");
  InsetPoint inset = if (target != container) { calcInset(target, container) } else { point };
  float targetLength = if (target == container) {
    if (isY) { container.scrollHeight } else { container.scrollWidth }
  } else {
    if (JS.in("getBBox", target) && target.tagName != "svg") {
      JS.assume(target.getBBox()[if (isY) { "height" } else { "width" }])
    } else {
      if (isY) { target.clientHeight } else { target.clientWidth }
    }
  };
  float containerLength = if (isY) { container.clientHeight } else { container.clientWidth };
  AxisScrollInfo axis = if (isY) { info.y } else { info.x };
  axis.offset.length = 0;
  JsValue axisState = axis;
  bool hasChanged = !axisState["interpolate"].truthy();
  int numOffsets = JS.assume(offsetDefinition["length"]);
  for (int i = 0; i < numOffsets; i++) {
    float offset = resolveOffset(offsetDefinition[i], containerLength, targetLength, if (isY) { inset.y } else { inset.x });
    if (!hasChanged && !JS.strictEqual(offset, axisState["interpolatorOffsets"][i])) {
      hasChanged = true;
    }
    axis.offset.push(offset);
  }
  if (hasChanged) {
    axisState["interpolate"] = interpolate(axis.offset, defaultOffsetFloats(axis.offset), new InterpolateOptions(false));
    axisState["interpolatorOffsets"] = [...axis.offset];
  }
  func(float)->float interpolateProgress = JS.assume(axisState["interpolate"]);
  axis.progress = clamp(0.0, 1.0, interpolateProgress(axis.current));
}
