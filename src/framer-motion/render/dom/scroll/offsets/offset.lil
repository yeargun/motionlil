import { namedEdges, resolveEdge } from "./edge";

JsValue defaultOffset = [0.0, 0.0];

export float resolveOffset(
  JsValue offset,
  float containerLength,
  float targetLength,
  float targetInset
) {
  JsValue offsetDefinition = if (offset.isArray()) { offset } else { defaultOffset };
  if (offset is float) {
    offsetDefinition = [offset, offset];
  } else if (offset is string) {
    string trimmed = offset.trim();
    if (trimmed.includes(" ")) {
      offsetDefinition = trimmed.split(" ");
    } else {
      offsetDefinition = [trimmed, if (JS.get(namedEdges, trimmed).truthy()) { trimmed } else { "0" }];
    }
  }
  return resolveEdge(offsetDefinition[0], targetLength, targetInset) -
    resolveEdge(offsetDefinition[1], containerLength);
}
