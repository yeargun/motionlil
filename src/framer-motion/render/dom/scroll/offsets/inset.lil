import { isHTMLElement } from "../../../../../motion-dom/utils/is-html-element";
import { RHElement } from "../types";

export class InsetPoint {
  float x;
  float y;

  init(float x = 0.0, float y = 0.0) {
    this.x = x;
    this.y = y;
  }
}

export InsetPoint calcInset(RHElement element, RHElement container) {
  InsetPoint inset = new InsetPoint();
  JsValue node = element;
  while (node.truthy() && !JS.strictEqual(node, container)) {
    RHElement current = JS.assume(node);
    if (isHTMLElement(current)) {
      inset.x += current.offsetLeft;
      inset.y += current.offsetTop;
      node = current.offsetParent;
    } else if (current.tagName == "svg") {
      JsValue svgBoundingBox = current.getBoundingClientRect();
      RHElement parent = JS.assume(current.parentElement);
      node = parent;
      JsValue parentBoundingBox = parent.getBoundingClientRect();
      float left = JS.assume(svgBoundingBox["left"]);
      float parentLeft = JS.assume(parentBoundingBox["left"]);
      float top = JS.assume(svgBoundingBox["top"]);
      float parentTop = JS.assume(parentBoundingBox["top"]);
      inset.x += left - parentLeft;
      inset.y += top - parentTop;
    } else if (JS.in("getBBox", current)) {
      JsValue box = current.getBBox();
      float x = JS.assume(box["x"]);
      float y = JS.assume(box["y"]);
      inset.x += x;
      inset.y += y;
      JsValue parentNode = current.parentNode;
      while (parentNode.truthy() && !JS.strictEqual(parentNode["tagName"], "svg")) {
        parentNode = parentNode["parentNode"];
      }
      node = parentNode;
    } else {
      break;
    }
  }
  return inset;
}
