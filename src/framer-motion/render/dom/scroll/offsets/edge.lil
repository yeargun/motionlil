import { document } from "../types";

extern float parseFloat(JsValue value);

export JsValue namedEdges = object{start: 0.0, center: 0.5, end: 1.0};

export float resolveEdge(JsValue edge, float length, float inset = 0.0) {
  float delta = 0.0;
  if (JS.in(edge, namedEdges)) {
    edge = JS.get(namedEdges, JS.assume(edge));
  }
  if (edge is string) {
    string text = edge;
    float asNumber = parseFloat(text);
    if (text.endsWith("px")) {
      delta = asNumber;
    } else if (text.endsWith("%")) {
      edge = asNumber / 100.0;
    } else if (text.endsWith("vw")) {
      float width = JS.assume(document["documentElement"]["clientWidth"]);
      delta = (asNumber / 100.0) * width;
    } else if (text.endsWith("vh")) {
      float height = JS.assume(document["documentElement"]["clientHeight"]);
      delta = (asNumber / 100.0) * height;
    } else {
      edge = asNumber;
    }
  }
  if (edge is float) {
    delta = length * edge;
  }
  return inset + delta;
}
