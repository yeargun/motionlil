import { cancelFrame, frame, frameData } from "../../../../motion-dom/frameloop/index";
import { FrameData } from "../../../../motion-dom/frameloop/types";
import { resize } from "../../../../motion-dom/resize/index";
import { createScrollInfo } from "./info";
import { createOnScrollHandler } from "./on-scroll-handler";
import { OnScrollHandler, RHElement, ScrollInfo, RHSet, RHWeakMap, WeakMap, Set, document, window } from "./types";

RHWeakMap scrollListeners = JS.assume(JS.construct(WeakMap));
RHWeakMap resizeListeners = JS.assume(JS.construct(WeakMap));
RHWeakMap onScrollHandlers = JS.assume(JS.construct(WeakMap));
RHWeakMap scrollSize = JS.assume(JS.construct(WeakMap));
RHWeakMap dimensionCheckProcesses = JS.assume(JS.construct(WeakMap));

RHElement getEventTarget(JsValue element) {
  return JS.assume(if (JS.strictEqual(element, document["scrollingElement"])) { window } else { element });
}

export func()->void scrollInfo(func(ScrollInfo)->void onScroll, JsValue options = JS.undefined()) {
  JsValue resolved = JS.or(options, JS.object());
  JsValue containerValue = resolved["container"];
  if (JS.isUndefined(containerValue)) {
    containerValue = document["scrollingElement"];
  }
  if (!containerValue.truthy()) {
    return () => {};
  }
  RHElement container = JS.assume(containerValue);
  JsValue handlerSet = onScrollHandlers.get(container);
  if (!handlerSet.truthy()) {
    handlerSet = JS.construct(Set);
    onScrollHandlers.set(container, handlerSet);
  }
  RHSet containerHandlers = JS.assume(handlerSet);
  OnScrollHandler containerHandler = createOnScrollHandler(container, onScroll, createScrollInfo(), resolved);
  containerHandlers.add(containerHandler);

  if (!scrollListeners.has(container)) {
    func(FrameData)->void notifyAll = (FrameData _data) => {
      containerHandlers.forEach((JsValue handler) => {
        OnScrollHandler h = JS.assume(handler);
        h.notify();
      });
    };
    func(FrameData)->void measureAll = (FrameData _data) => {
      containerHandlers.forEach((JsValue handler) => {
        OnScrollHandler h = JS.assume(handler);
        h.measure(frameData.timestamp);
      });
      frame.preUpdate(notifyAll, false, false);
    };
    func(FrameData)->void listener = (FrameData _data) => {
      frame.read(measureAll, false, false);
    };
    scrollListeners.set(container, listener);
    RHElement target = getEventTarget(container);
    JS.invoke(window, "addEventListener", "resize", listener);
    if (!JS.strictEqual(container, document["documentElement"])) {
      resizeListeners.set(container, resize(container, listener));
    }
    JS.invoke(target, "addEventListener", "scroll", listener);
    listener(frameData);
  }

  bool trackContentSize = JS.assume(resolved["trackContentSize"]);
  if (trackContentSize && !dimensionCheckProcesses.has(container)) {
    func(FrameData)->void listener = JS.assume(scrollListeners.get(container));
    JsValue size = object{width: container.scrollWidth, height: container.scrollHeight};
    scrollSize.set(container, size);
    func(FrameData)->void checkScrollDimensions = (FrameData _data) => {
      float newWidth = container.scrollWidth;
      float newHeight = container.scrollHeight;
      if (!JS.strictEqual(size["width"], newWidth) || !JS.strictEqual(size["height"], newHeight)) {
        listener(frameData);
        size["width"] = newWidth;
        size["height"] = newHeight;
      }
    };
    dimensionCheckProcesses.set(container, frame.read(checkScrollDimensions, true, false));
  }

  func(FrameData)->void listener = JS.assume(scrollListeners.get(container));
  frame.read(listener, false, true);

  return () => {
    cancelFrame(listener);
    JsValue currentHandlers = onScrollHandlers.get(container);
    if (!currentHandlers.truthy()) {
      return;
    }
    RHSet handlers = JS.assume(currentHandlers);
    handlers.delete(containerHandler);
    if (handlers.size.truthy()) {
      return;
    }
    JsValue scrollListener = scrollListeners.get(container);
    scrollListeners.delete(container);
    if (scrollListener.truthy()) {
      JS.invoke(getEventTarget(container), "removeEventListener", "scroll", scrollListener);
      JsValue resizeCancel = resizeListeners.get(container);
      if (resizeCancel.truthy()) {
        func()->void cancelResize = JS.assume(resizeCancel);
        cancelResize();
      }
      JS.invoke(window, "removeEventListener", "resize", scrollListener);
    }
    JsValue dimensionCheckProcess = dimensionCheckProcesses.get(container);
    if (dimensionCheckProcess.truthy()) {
      cancelFrame(JS.assume(dimensionCheckProcess));
      dimensionCheckProcesses.delete(container);
    }
    scrollSize.delete(container);
  };
}
