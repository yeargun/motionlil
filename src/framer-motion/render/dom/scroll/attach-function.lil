import { observeTimeline } from "../../../../motion-dom/scroll/observe";
import { scrollInfo } from "./track";
import { ScrollInfo } from "./types";
import { getTimeline } from "./utils/get-timeline";
import { isElementTracking } from "./utils/is-element-tracking";

export func()->void attachToFunction(JsValue onScroll, JsValue options) {
  if (JS.strictEqual(onScroll["length"], 2.0) || isElementTracking(options)) {
    func(float, ScrollInfo)->void callback = JS.assume(onScroll);
    return scrollInfo((ScrollInfo info) => {
      callback((if (JS.strictEqual(options["axis"], "x")) { info.x } else { info.y }).progress, info);
    }, options);
  }
  return observeTimeline(JS.assume(onScroll), getTimeline(options));
}
