import { observeTimeline } from "../../../../motion-dom/scroll/observe";
import { getTimeline } from "./utils/get-timeline";
import { canUseNativeTimeline } from "./utils/can-use-native-timeline";
import { offsetToViewTimelineRange } from "./utils/offset-to-range";

// Every animation carries upstream's surface (attachTimeline, pause, time,
// iterationDuration), so this is upstream's attachToAnimation as written.
export func()->void attachToAnimation(JsValue animation, JsValue options) {
  JsValue timeline = getTimeline(options);
  JsValue target = options["target"];
  JsValue range = if (target.truthy()) { offsetToViewTimelineRange(options["offset"]) } else { JS.undefined() };
  bool useNative = if (target.truthy()) { canUseNativeTimeline(target) && range.truthy() } else { canUseNativeTimeline() };
  JsValue timelineOptions = object{timeline: if (useNative) { timeline } else { JS.undefined() }};
  if (range.truthy() && useNative) {
    timelineOptions["rangeStart"] = range["rangeStart"];
    timelineOptions["rangeEnd"] = range["rangeEnd"];
  }
  timelineOptions["observe"] = (JsValue valueAnimation) => {
    JS.invoke(valueAnimation, "pause");
    return observeTimeline((float progress) => {
      float duration = JS.assume(valueAnimation["iterationDuration"]);
      valueAnimation["time"] = duration * progress;
    }, timeline);
  };
  return JS.assume(JS.invoke(animation, "attachTimeline", timelineOptions));
}
