// Scroll info records handed to user callbacks, in upstream's key order, plus the host views the
// scroll modules read through (typed extern reads print as plain property accesses).
export class AxisScrollInfo {
  float current;
  float[] offset;
  float progress;
  float scrollLength;
  float targetOffset;
  float targetLength;
  float containerLength;
  float velocity;

  init() {
    this.current = 0.0;
    this.offset = [];
    this.progress = 0.0;
    this.scrollLength = 0.0;
    this.targetOffset = 0.0;
    this.targetLength = 0.0;
    this.containerLength = 0.0;
    this.velocity = 0.0;
  }
}

AxisScrollInfo createAxisInfo() {
  return new AxisScrollInfo();
}

export class ScrollInfo {
  float time;
  AxisScrollInfo x;
  AxisScrollInfo y;

  init() {
    this.time = 0.0;
    this.x = createAxisInfo();
    this.y = createAxisInfo();
  }
}

export class OnScrollHandler {
  func(float)->void measure;
  func()->void notify;

  init(func(float)->void measure, func()->void notify) {
    this.measure = measure;
    this.notify = notify;
  }
}

import { RHElement, RHSet, RHWeakMap, document, window, WeakMap, Set } from "../../../../motion-dom/render/host-views";
export { RHElement, RHSet, RHWeakMap, document, window, WeakMap, Set };
