import { supportsScrollTimeline, supportsViewTimeline } from "../../../../../motion-dom/utils/supports/scroll-timeline";

import { window } from "../../../../../motion-dom/render/host-views";

export bool canUseNativeTimeline(JsValue target = JS.undefined()) {
  if (JS.typeOf(window) == "undefined") {
    return false;
  }
  return if (target.truthy()) { supportsViewTimeline() } else { supportsScrollTimeline() };
}
