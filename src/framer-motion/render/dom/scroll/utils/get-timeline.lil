import { scrollInfo } from "../track";
import { ScrollInfo } from "../types";
import { canUseNativeTimeline } from "./can-use-native-timeline";
import { offsetToViewTimelineRange } from "./offset-to-range";

import { RHMap, Map } from "../../../../../motion-dom/render/host-views";

extern JsValue ViewTimeline;
extern JsValue ScrollTimeline;

RHMap timelineCache = JS.assume(JS.construct(Map));

JsValue scrollTimelineFallback(JsValue options) {
  JsValue currentTime = object{value: 0.0};
  func()->void cancel = scrollInfo((ScrollInfo info) => {
    currentTime["value"] = (if (JS.strictEqual(options["axis"], "x")) { info.x } else { info.y }).progress * 100.0;
  }, options);
  return object{currentTime: currentTime, cancel: cancel};
}

export JsValue getTimeline(JsValue options) {
  JsValue container = JS.or(options["source"], options["container"]);
  JsValue axis = options["axis"];
  JsValue target = options["target"];
  JsValue offset = options["offset"];
  JsValue containerCacheValue = timelineCache.get(container);
  if (!containerCacheValue.truthy()) {
    containerCacheValue = JS.construct(Map);
    timelineCache.set(container, containerCacheValue);
  }
  RHMap containerCache = JS.assume(containerCacheValue);
  JsValue targetKey = if (JS.isNullish(target)) { "self" } else { target };
  JsValue targetCache = containerCache.get(targetKey);
  if (!targetCache.truthy()) {
    targetCache = JS.object();
    containerCache.set(targetKey, targetCache);
  }
  string axisKey = JS.assume(JS.add(axis, JS.invoke(JS.or(offset, JS.array()), "join", ",")));
  if (!JS.get(targetCache, axisKey).truthy()) {
    JsValue fallbackOptions = object{container: container};
    for (string key in options) {
      if (key != "source" && key != "container") {
        fallbackOptions[key] = options[key];
      }
    }
    JsValue timeline = JS.undefined();
    if (target.truthy() && canUseNativeTimeline(target)) {
      timeline = if (offsetToViewTimelineRange(offset).truthy()) {
        JS.construct(ViewTimeline, object{subject: target, axis: axis})
      } else {
        scrollTimelineFallback(fallbackOptions)
      };
    } else if (canUseNativeTimeline()) {
      timeline = JS.construct(ScrollTimeline, object{source: container, axis: axis});
    } else {
      timeline = scrollTimelineFallback(fallbackOptions);
    }
    JS.set(targetCache, axisKey, timeline);
  }
  return JS.get(targetCache, axisKey);
}
