import {
  scrollOffsetEnter,
  scrollOffsetExit,
  scrollOffsetAny,
  scrollOffsetAll
} from "../offsets/presets";

JsValue presets = [[scrollOffsetEnter, "entry"], [scrollOffsetExit, "exit"], [scrollOffsetAny, "cover"], [scrollOffsetAll, "contain"]];
JsValue stringToProgress = object{start: 0.0, end: 1.0};

JsValue parseStringOffset(string s) {
  JsValue parts = JS.invoke(s.trim(), "split", new Regex("\\s+"));
  if (!JS.strictEqual(parts["length"], 2.0)) {
    return JS.undefined();
  }
  JsValue a = JS.get(stringToProgress, JS.assume(parts[0]));
  JsValue b = JS.get(stringToProgress, JS.assume(parts[1]));
  if (JS.isUndefined(a) || JS.isUndefined(b)) {
    return JS.undefined();
  }
  return [a, b];
}

JsValue normaliseOffset(JsValue offset) {
  if (!JS.strictEqual(offset["length"], 2.0)) {
    return JS.undefined();
  }
  JsValue[] result = [];
  for (int i = 0; i < 2; i++) {
    JsValue item = offset[i];
    if (item.isArray()) {
      result.push(item);
    } else if (item is string) {
      JsValue parsed = parseStringOffset(item);
      if (!parsed.truthy()) {
        return JS.undefined();
      }
      result.push(parsed);
    } else {
      return JS.undefined();
    }
  }
  return result;
}

bool matchesPreset(JsValue offset, JsValue preset) {
  JsValue normalised = normaliseOffset(offset);
  if (!normalised.truthy()) {
    return false;
  }
  for (int i = 0; i < 2; i++) {
    JsValue o = normalised[i];
    JsValue p = preset[i];
    if (!JS.strictEqual(o[0], p[0]) || !JS.strictEqual(o[1], p[1])) {
      return false;
    }
  }
  return true;
}

JsValue range(string name) {
  return object{rangeStart: `${name} 0%`, rangeEnd: `${name} 100%`};
}

export JsValue offsetToViewTimelineRange(JsValue offset) {
  if (!offset.truthy()) {
    return range("contain");
  }
  for (int i = 0; i < 4; i++) {
    JsValue preset = presets[i];
    if (matchesPreset(offset, preset[0])) {
      return range(JS.assume(preset[1]));
    }
  }
  return JS.undefined();
}
