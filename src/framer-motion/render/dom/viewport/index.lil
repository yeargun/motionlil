import { resolveElements } from "../../../../motion-dom/utils/resolve-elements";

import { RHObserver, RHWeakMap, WeakMap, IntersectionObserver } from "../../../../motion-dom/render/host-views";

JsValue thresholds = object{some: 0.0, all: 1.0};

export func()->void inView(
  JsValue elementOrSelector,
  JsValue onStart,
  JsValue options = JS.undefined()
) {
  JsValue resolved = JS.or(options, JS.object());
  JsValue amount = resolved["amount"];
  if (JS.isUndefined(amount)) {
    amount = "some";
  }
  JsValue[] elements = resolveElements(elementOrSelector);
  RHWeakMap activeIntersections = JS.assume(JS.construct(WeakMap));
  func(JsValue, JsValue)->JsValue start = JS.assume(onStart);
  RHObserver observer = JS.assume(JS.undefined());
  JsValue onIntersectionChange = (JsValue entries) => {
    JS.invoke(entries, "forEach", (JsValue entry) => {
      JsValue target = entry["target"];
      JsValue onEnd = activeIntersections.get(target);
      bool isIntersecting = JS.assume(entry["isIntersecting"]);
      if (isIntersecting == onEnd.truthy()) {
        return;
      }
      if (isIntersecting) {
        JsValue newOnEnd = start(target, entry);
        if (JS.typeOf(newOnEnd) == "function") {
          activeIntersections.set(target, newOnEnd);
        } else {
          observer.unobserve(target);
        }
      } else if (JS.typeOf(onEnd) == "function") {
        func(JsValue)->void end = JS.assume(onEnd);
        end(entry);
        activeIntersections.delete(target);
      }
    });
  };
  observer = JS.assume(JS.construct(IntersectionObserver, onIntersectionChange, object{
    root: resolved["root"],
    rootMargin: resolved["margin"],
    threshold: if (amount is float) { amount } else { JS.get(thresholds, JS.assume(amount)) }
  }));
  elements.forEach((JsValue element) => {
    observer.observe(element);
  });
  return () => {
    observer.disconnect();
  };
}
