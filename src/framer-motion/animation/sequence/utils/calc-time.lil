import extern { view as asString } from "../../utils/anim-host.ts";

extern float parseFloat(JsValue value);
extern string asString(JsValue value);

export float calcNextTime(
  float current,
  JsValue next,
  float prev,
  Map<string, float> labels
) {
  if (next is float) {
    return next;
  }
  string label = asString(next);
  if (label.startsWith("-") || label.startsWith("+")) {
    return (current + parseFloat(label)).max(0.0);
  }
  if (label == "<") {
    return prev;
  }
  if (label.startsWith("<")) {
    return (prev + parseFloat(label.slice(1))).max(0.0);
  }
  return labels.get(label) ?? current;
}
