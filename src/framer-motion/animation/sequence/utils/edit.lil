import { mixNumber } from "../../../../motion-dom/utils/mix/number";
import { getEasingForSegment } from "../../../../motion-utils/easing/utils/get-easing-for-segment";
import extern { view as asKeyframe } from "../../utils/anim-host.ts";
import { AbsoluteKeyframe } from "./sort";

extern AbsoluteKeyframe asKeyframe(JsValue value);

export void eraseKeyframes(AbsoluteKeyframe[] sequence, float startTime, float endTime) {
  for (int i = 0; i < sequence.length; i++) {
    AbsoluteKeyframe keyframe = sequence[i];
    if (keyframe.at > startTime && keyframe.at < endTime) {
      sequence.splice(i, 1);
      i--;
    }
  }
}

export void addKeyframes(
  AbsoluteKeyframe[] sequence,
  JsValue[] keyframes,
  JsValue easing,
  float[] offset,
  float startTime,
  float endTime
) {
  eraseKeyframes(sequence, startTime, endTime);
  for (int i = 0; i < keyframes.length; i++) {
    sequence.push(asKeyframe(object{
      value: keyframes[i],
      at: mixNumber(startTime, endTime, offset[i]),
      easing: getEasingForSegment(easing, i)
    }));
  }
}
