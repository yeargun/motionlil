import extern { sortBy } from "../../utils/anim-host.ts";

// A keyframe placed on the sequence timeline: `{ value, at, easing }`.
export extern class AbsoluteKeyframe {
  JsValue value;
  float at;
  JsValue easing;
}

extern void sortBy(AbsoluteKeyframe[] list, func(AbsoluteKeyframe, AbsoluteKeyframe)->float compare);

export float compareByTime(AbsoluteKeyframe a, AbsoluteKeyframe b) {
  if (a.at == b.at) {
    if (a.value == null) {
      return 1.0;
    }
    if (b.value == null) {
      return -1.0;
    }
    return 0.0;
  }
  return a.at - b.at;
}

export void sortByTime(AbsoluteKeyframe[] frames) {
  sortBy(frames, compareByTime);
}
