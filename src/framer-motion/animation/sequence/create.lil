import { defaultOffset } from "../../../motion-dom/animation/keyframes/offsets/default";
import { fillOffset } from "../../../motion-dom/animation/keyframes/offsets/fill";
import { isMotionValue } from "../../../motion-dom/value/utils/is-motion-value";
import { AnimationScope, SelectorCache } from "../../../motion-dom/utils/resolve-elements";
import { getEasingForSegment } from "../../../motion-utils/easing/utils/get-easing-for-segment";
import { progress } from "../../../motion-utils/progress";
import { reverseEasing } from "../../../motion-utils/easing/modifiers/reverse";
import { callFn2, deleteProp, isFunction } from "../../../motion-dom/dom-host";
import extern {
  copy,
  spread,
  spread3,
  view as asTransition,
  view as asNumber,
  view as asOptionalNumber,
  view as asNumbers,
  view as asEasing,
  view as asString,
  view as asList,
  forEachEntry
} from "../utils/anim-host.ts";
import { resolveSubjects } from "../animate/resolve-subjects";
import { AbsoluteKeyframe, sortByTime } from "./utils/sort";
import { calcNextTime } from "./utils/calc-time";
import { addKeyframes } from "./utils/edit";
import { normalizeTimes } from "./utils/normalize-times";

// The fields a segment transition is read through; the host object is used as is.
extern class SegmentTransition {
  JsValue? at;
  JsValue delay;
  JsValue? times;
  float? repeat;
  string? repeatType;
  float? repeatDelay;
  JsValue? ease;
  float? duration;
}

extern JsValue copy(JsValue? a);
extern JsValue spread(JsValue? a, JsValue? b);
extern JsValue spread3(JsValue? a, JsValue? b, JsValue? c);
extern SegmentTransition asTransition(JsValue value);
extern float asNumber(JsValue value);
extern float? asOptionalNumber(JsValue value);
extern float[]? asNumbers(JsValue value);
extern func(float)->float asEasing(JsValue value);
extern string asString(JsValue value);
extern JsValue[] asList(JsValue value);
extern void forEachEntry(
  Map<JsValue, Record<AbsoluteKeyframe[]> > map,
  func(Record<AbsoluteKeyframe[]>, JsValue)->void callback
);

export JsValue[] keyframesAsList(JsValue keyframes) {
  return if (keyframes.isArray()) { asList(keyframes) } else { [keyframes] };
}

AbsoluteKeyframe[] getValueSequence(string name, Record<AbsoluteKeyframe[]> sequences) {
  AbsoluteKeyframe[]? existing = sequences[name];
  if (existing != null) {
    return existing;
  }
  AbsoluteKeyframe[] created = [];
  sequences[name] = created;
  return created;
}

// Walks the sequence and reports, per subject in first-seen order, the
// keyframes and transition of every value it animates.
export void createAnimationsFromSequence(
  JsValue[] sequence,
  JsValue? sequenceOptions,
  AnimationScope? scope,
  func(JsValue, JsValue, JsValue)->void onDefinition
) {
  JsValue sequenceTransition = copy(sequenceOptions);
  JsValue? defaultTransitionOption = sequenceTransition["defaultTransition"];
  deleteProp(sequenceTransition, "defaultTransition");
  JsValue defaultTransition = defaultTransitionOption ?? object{};
  JsValue defaultDurationValue = defaultTransition["duration"];
  float defaultDuration = asNumber(if (defaultDurationValue.truthy()) { defaultDurationValue } else { 0.3 });
  JsValue defaultEase = defaultTransition["ease"];
  if (!defaultEase.truthy()) {
    defaultEase = "easeOut";
  }

  Map<JsValue, Record<AbsoluteKeyframe[]> > sequences = new Map<JsValue, Record<AbsoluteKeyframe[]> >();
  SelectorCache elementCache = new SelectorCache();
  Map<string, float> timeLabels = new Map<string, float>();
  float prevTime = 0.0;
  float currentTime = 0.0;
  float totalDuration = 0.0;

  auto getSubjectSequence = (JsValue subject) => {
    Record<AbsoluteKeyframe[]>? existing = sequences.get(subject);
    if (existing != null) {
      return existing;
    }
    Record<AbsoluteKeyframe[]> created = record{};
    sequences.set(subject, created);
    return created;
  };

  for (int i = 0; i < sequence.length; i++) {
    JsValue segment = sequence[i];

    if (segment is string) {
      timeLabels.set(segment, currentTime);
      continue;
    }
    if (!segment.isArray()) {
      timeLabels.set(
        asString(segment["name"]),
        calcNextTime(currentTime, segment["at"], prevTime, timeLabels)
      );
      continue;
    }

    JsValue[] parts = asList(segment);
    JsValue subject = parts[0];
    JsValue keyframes = parts[1];
    JsValue? transitionOption = parts[2];
    JsValue transition = transitionOption ?? object{};

    JsValue? at = asTransition(transition).at;
    if (at != null) {
      currentTime = calcNextTime(currentTime, at, prevTime, timeLabels);
    }

    float maxDuration = 0.0;
    auto resolveValueSequence = (
      JsValue valueKeyframes,
      JsValue valueTransitionValue,
      AbsoluteKeyframe[] valueSequence,
      int elementIndex,
      int numSubjects
    ) => {
      JsValue[] valueKeyframesAsList = keyframesAsList(valueKeyframes);
      SegmentTransition valueTransition = asTransition(valueTransitionValue);
      JsValue delay = valueTransition.delay;
      float calculatedDelay = asOptionalNumber(
        if (isFunction(delay)) { callFn2(delay, elementIndex, numSubjects) } else { delay }
      ) ?? 0.0;
      float[] times = asNumbers(valueTransition.times) ?? defaultOffset(valueKeyframesAsList);
      float repeat = valueTransition.repeat ?? 0.0;
      string? repeatType = valueTransition.repeatType;
      float repeatDelay = valueTransition.repeatDelay ?? 0.0;
      JsValue ease = valueTransition.ease ?? defaultEase;
      float duration = valueTransition.duration ?? defaultDuration;
      float startTime = currentTime + calculatedDelay;

      if (times.length == 1 && times[0] == 0.0) {
        times.push(1.0);
      }
      int remainder = times.length - valueKeyframesAsList.length;
      if (remainder > 0) {
        fillOffset(times, remainder);
      }
      if (valueKeyframesAsList.length == 1) {
        valueKeyframesAsList = [null, ...valueKeyframesAsList];
      }

      // Segments cannot express `repeat: Infinity` or very large counts.
      if (repeat != 0.0 && repeat < 20.0) {
        float repeatDelayUnits = if (duration > 0.0) { repeatDelay / duration } else { 0.0 };
        duration = duration * (repeat + 1.0) + repeatDelay * repeat;
        JsValue[] originalKeyframes = [...valueKeyframesAsList];
        float[] originalTimes = [...times];
        JsValue[] easeList = if (ease.isArray()) { [...asList(ease)] } else { [ease] };
        JsValue[] originalEase = [...easeList];
        bool isFlipping = repeatType == "reverse" || repeatType == "mirror";
        JsValue[] flippedKeyframes = originalKeyframes;
        JsValue[] flippedEases = originalEase;
        if (isFlipping) {
          flippedKeyframes = [...originalKeyframes].reverse();
          if (repeatType == "reverse") {
            flippedEases = [...originalEase].reverse().map((JsValue e) => {
              if (isFunction(e)) {
                JsValue reversed = reverseEasing(asEasing(e));
                return reversed;
              }
              return e;
            });
          }
        }
        for (int repeatIndex = 0; repeatIndex < repeat; repeatIndex++) {
          bool isFlipped = isFlipping && repeatIndex % 2 == 0;
          JsValue[] iterKeyframes = if (isFlipped) { flippedKeyframes } else { originalKeyframes };
          JsValue[] iterEase = if (isFlipped) { flippedEases } else { originalEase };
          float iterStartOffset = (repeatIndex + 1) * (1.0 + repeatDelayUnits);
          if (repeatDelayUnits > 0.0) {
            valueKeyframesAsList.push(valueKeyframesAsList[valueKeyframesAsList.length - 1]);
            times.push(iterStartOffset);
            easeList.push("linear");
          }
          for (int keyframeIndex = 0; keyframeIndex < iterKeyframes.length; keyframeIndex++) {
            valueKeyframesAsList.push(iterKeyframes[keyframeIndex]);
            times.push(originalTimes[keyframeIndex] + iterStartOffset);
            easeList.push(
              if (keyframeIndex == 0) { "linear" } else { getEasingForSegment(iterEase, keyframeIndex - 1) }
            );
          }
        }
        normalizeTimes(times, repeat, repeatDelayUnits);
        ease = easeList;
      }

      float targetTime = startTime + duration;
      addKeyframes(valueSequence, valueKeyframesAsList, ease, times, startTime, targetTime);
      maxDuration = (calculatedDelay + duration).max(maxDuration);
      totalDuration = targetTime.max(totalDuration);
    };

    if (isMotionValue(subject)) {
      resolveValueSequence(
        keyframes,
        transition,
        getValueSequence("default", getSubjectSequence(subject)),
        0,
        0
      );
    } else {
      JsValue[] subjects = resolveSubjects(subject, keyframes, scope, elementCache);
      int numSubjects = subjects.length;
      for (int subjectIndex = 0; subjectIndex < numSubjects; subjectIndex++) {
        Record<AbsoluteKeyframe[]> subjectSequence = getSubjectSequence(subjects[subjectIndex]);
        for (string key in keyframes) {
          resolveValueSequence(
            keyframes[key],
            spread(transition, transition[key]),
            getValueSequence(key, subjectSequence),
            subjectIndex,
            numSubjects
          );
        }
      }
    }

    prevTime = currentTime;
    currentTime = currentTime + maxDuration;
  }

  // `type` is left out: springs were resolved to easing above.
  JsValue remainingDefaultTransition = copy(defaultTransition);
  deleteProp(remainingDefaultTransition, "type");

  forEachEntry(sequences, (Record<AbsoluteKeyframe[]> valueSequences, JsValue subject) => {
    bool animatesValues = false;
    JsValue definitionKeyframes = object{};
    JsValue definitionTransition = object{};
    for (string key in valueSequences) {
      animatesValues = true;
      AbsoluteKeyframe[] valueSequence = getValueSequence(key, valueSequences);
      sortByTime(valueSequence);
      JsValue[] keyframes = [];
      float[] valueOffset = [];
      JsValue[] valueEasing = [];
      for (int f = 0; f < valueSequence.length; f++) {
        AbsoluteKeyframe frame = valueSequence[f];
        keyframes.push(frame.value);
        valueOffset.push(progress(0.0, totalDuration, frame.at));
        JsValue easing = frame.easing;
        valueEasing.push(if (easing.truthy()) { easing } else { "easeOut" });
      }
      if (valueOffset[0] != 0.0) {
        valueOffset = [0.0, ...valueOffset];
        keyframes = [keyframes[0], ...keyframes];
        valueEasing = ["easeInOut", ...valueEasing];
      }
      if (valueOffset[valueOffset.length - 1] != 1.0) {
        valueOffset.push(1.0);
        keyframes.push(null);
      }
      definitionKeyframes[key] = keyframes;
      definitionTransition[key] = spread3(
        remainingDefaultTransition,
        object{ duration: totalDuration, ease: valueEasing, times: valueOffset },
        sequenceTransition
      );
    }
    if (animatesValues) {
      onDefinition(subject, definitionKeyframes, definitionTransition);
    }
  });
}
