import { motionValue } from "../../../motion-dom/value/index";
import { AnimationScope } from "../../../motion-dom/utils/resolve-elements";
import { isFunction } from "../../../motion-dom/dom-host";
import extern { view as asList, view as asEmitter } from "../utils/anim-host.ts";
import { createAnimationsFromSequence } from "../sequence/create";

extern class ChangeEmitter {
  void on(string eventName, JsValue callback);
}

extern JsValue[] asList(JsValue value);
extern ChangeEmitter asEmitter(JsValue value);

export bool isSequence(JsValue value) {
  return value.isArray() && asList(value).some((JsValue segment) => segment.isArray());
}

// `animateSubject` is the caller's subject animator (DOM-only or full).
export JsValue[] animateSequence(
  JsValue sequence,
  JsValue? options,
  AnimationScope? scope,
  func(JsValue, JsValue, JsValue, AnimationScope?)->JsValue[] animateSubject
) {
  JsValue[] animations = [];
  createAnimationsFromSequence(
    asList(sequence).map((JsValue segment) => {
      if (segment.isArray() && isFunction(segment[0])) {
        JsValue mv = motionValue(0.0);
        asEmitter(mv).on("change", segment[0]);
        float length = segment.length;
        JsValue[] converted = if (length == 1.0) {
          [mv, [0.0, 1.0]]
        } else {
          if (length == 2.0) { [mv, [0.0, 1.0], segment[1]] } else { [mv, segment[1], segment[2]] }
        };
        return converted;
      }
      return segment;
    }),
    options,
    scope,
    (JsValue subject, JsValue keyframes, JsValue transition) => {
      animations = animations.concat(animateSubject(subject, keyframes, transition, null));
    }
  );
  return animations;
}
