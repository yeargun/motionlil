import { animateTarget } from "../../../motion-dom/animation/interfaces/visual-element-target";
import { animateSingleValue } from "../../../motion-dom/animation/animate/single-value";
import { isMotionValue } from "../../../motion-dom/value/utils/is-motion-value";
import { visualElementStore } from "../../../motion-dom/render/store";
import { AnimationScope } from "../../../motion-dom/utils/resolve-elements";
import { callFn2, isFunction } from "../../../motion-dom/dom-host";
import extern { copy, spread, view as asStore } from "../utils/anim-host.ts";
import { createDOMVisualElement } from "../utils/create-html-visual-element";
import { isDOMKeyframes } from "../utils/is-dom-keyframes";
import { resolveSubjects } from "./resolve-subjects";

// The visual element store, read through its WeakMap methods.
extern class VisualElementStore {
  bool has(JsValue key);
  JsValue get(JsValue key);
}

extern JsValue copy(JsValue? a);
extern JsValue spread(JsValue? a, JsValue? b);
extern VisualElementStore asStore(JsValue value);

export JsValue[] animateSubject(
  JsValue subject,
  JsValue keyframes,
  JsValue options,
  AnimationScope? scope
) {
  if (isMotionValue(subject) || (subject is float) || ((subject is string) && !isDOMKeyframes(keyframes))) {
    JsValue valueKeyframes = keyframes;
    if (isDOMKeyframes(keyframes)) {
      JsValue defaultKeyframes = keyframes["default"];
      if (defaultKeyframes.truthy()) {
        valueKeyframes = defaultKeyframes;
      }
    }
    JsValue valueOptions = options;
    if (options.truthy()) {
      JsValue defaultOptions = options["default"];
      if (defaultOptions.truthy()) {
        valueOptions = defaultOptions;
      }
    }
    return [animateSingleValue(subject, valueKeyframes, valueOptions)];
  }

  JsValue[] animations = [];
  VisualElementStore store = asStore(visualElementStore);
  JsValue[] subjects = resolveSubjects(subject, keyframes, scope);
  int numSubjects = subjects.length;
  for (int i = 0; i < numSubjects; i++) {
    JsValue thisSubject = subjects[i];
    if (!store.has(thisSubject)) {
      createDOMVisualElement(thisSubject);
    }
    JsValue transition = copy(options);
    JsValue delay = transition["delay"];
    if (isFunction(delay)) {
      transition["delay"] = callFn2(delay, i, numSubjects);
    }
    JsValue definition = spread(keyframes, object{ transition: transition });
    animations = animations.concat(
      animateTarget(store.get(thisSubject), definition, object{})
    );
  }
  return animations;
}
