import { GroupAnimationWithThen } from "../../../motion-dom/animation/GroupAnimationWithThen";
import { AnimationScope } from "../../../motion-dom/utils/resolve-elements";
import { removeItem } from "../../../motion-utils/array";
import { callFn0, deleteProp, isFunction } from "../../../motion-dom/dom-host";
import extern { spread } from "../utils/anim-host.ts";
import { animateSequence, isSequence } from "./sequence";
import { animateSubject } from "./subject";

extern JsValue spread(JsValue? a, JsValue? b);

export class ScopedAnimateOptions {
  AnimationScope? scope;
  bool? reduceMotion;
  bool? skipAnimations;

  init(
    AnimationScope? scope = null,
    bool? reduceMotion = null,
    bool? skipAnimations = null
  ) {
    this.scope = scope;
    this.reduceMotion = reduceMotion;
    this.skipAnimations = skipAnimations;
  }
}

// Public animate accepts DOM elements, plain objects and MotionValues.
// Share subject dispatch with the full entry so cross-realm elements follow upstream.
export func(JsValue, JsValue, JsValue)->GroupAnimationWithThen createScopedAnimate(
  ScopedAnimateOptions? options = null
) {
  AnimationScope? scope = null;
  JsValue inherited = object{};
  if (options != null) {
    scope = options.scope;
    bool? reduceMotion = options.reduceMotion;
    if (reduceMotion != null) {
      inherited["reduceMotion"] = reduceMotion;
    }
    bool? skipAnimations = options.skipAnimations;
    if (skipAnimations != null) {
      inherited["skipAnimations"] = skipAnimations;
    }
  }

  return (JsValue subjectOrSequence, JsValue optionsOrKeyframes, JsValue transition) => {
    bool sequence = isSequence(subjectOrSequence);
    JsValue rest = spread(inherited, if (sequence) { optionsOrKeyframes } else { transition });
    JsValue onComplete = rest["onComplete"];
    deleteProp(rest, "onComplete");
    GroupAnimationWithThen animation = new GroupAnimationWithThen(
      if (sequence) {
        animateSequence(subjectOrSequence, rest, scope, animateSubject)
      } else {
        animateSubject(subjectOrSequence, optionsOrKeyframes, rest, scope)
      }
    );
    if (isFunction(onComplete)) {
      JsValue finished = JS.assume(animation.finished());
      JS.invoke(finished, "then", onComplete);
    }
    if (scope != null) {
      AnimationScope activeScope = scope;
      activeScope.animations.push(animation);
      animation.finished().then((bool _v) => {
        removeItem(activeScope.animations, animation);
        return true;
      });
    }
    return animation;
  };
}

export func(JsValue, JsValue, JsValue)->GroupAnimationWithThen animate =
  createScopedAnimate();
