import { GroupAnimationWithThen } from "../../../../motion-dom/animation/GroupAnimationWithThen";
import { animateElements } from "./animate-elements";

export func(JsValue, JsValue, JsValue)->GroupAnimationWithThen animateMini =
  (JsValue elementOrSelector, JsValue keyframes, JsValue options) =>
    new GroupAnimationWithThen(animateElements(elementOrSelector, keyframes, options, null));
