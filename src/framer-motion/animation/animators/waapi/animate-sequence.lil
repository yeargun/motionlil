import { GroupAnimationWithThen } from "../../../../motion-dom/animation/GroupAnimationWithThen";
import extern { view as asList } from "../../utils/anim-host.ts";
import { createAnimationsFromSequence } from "../../sequence/create";
import { animateElements } from "./animate-elements";

extern JsValue[] asList(JsValue value);

export GroupAnimationWithThen animateSequence(
  JsValue definition,
  JsValue? options = null
) {
  JsValue[] animations = [];
  createAnimationsFromSequence(
    asList(definition),
    options,
    null,
    (JsValue element, JsValue keyframes, JsValue transition) => {
      animations = animations.concat(animateElements(element, keyframes, transition, null));
    }
  );
  return new GroupAnimationWithThen(animations);
}
