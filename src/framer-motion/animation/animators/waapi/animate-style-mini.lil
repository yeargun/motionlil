import { GroupAnimationWithThenMini } from "../../../../motion-dom/animation/GroupAnimationWithThenMini";
import { animateElements } from "./animate-elements-mini";

export func(JsValue, JsValue, JsValue)->GroupAnimationWithThenMini animateMini =
  (JsValue elementOrSelector, JsValue keyframes, JsValue options) =>
    new GroupAnimationWithThenMini(animateElements(elementOrSelector, keyframes, options, null));
