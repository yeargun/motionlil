import {
  animationMapKey,
  getAnimationMap
} from "../../../../motion-dom/animation/utils/active-animations";
import { applyPxDefaults } from "../../../../motion-dom/animation/keyframes/utils/apply-px-defaults";
import { fillWildcards } from "../../../../motion-dom/animation/keyframes/utils/fill-wildcards";
import { getComputedStyle } from "../../../../motion-dom/render/dom/style-computed";
import { getValueTransition } from "../../../../motion-dom/animation/utils/get-value-transition";
import { NativeAnimation } from "../../../../motion-dom/animation/NativeAnimation";
import { resolveElements, AnimationScope } from "../../../../motion-dom/utils/resolve-elements";
import { secondsToMilliseconds } from "../../../../motion-utils/time-conversion";
import { callFn2, isFunction } from "../../../../motion-dom/dom-host";
import extern {
  copy,
  spread,
  view as asNumber,
  view as asString,
  view as asStoppable
} from "../../utils/anim-host.ts";
import { keyframesAsList } from "../../sequence/create";

extern class Stoppable {
  void stop();
}

extern JsValue copy(JsValue? a);
extern JsValue spread(JsValue? a, JsValue? b);
extern float asNumber(JsValue value);
extern string asString(JsValue value);
extern Stoppable asStoppable(JsValue value);

struct AnimationDefinition {
  Map<string, JsValue> map;
  string key;
  JsValue[] unresolvedKeyframes;
  JsValue options;
  JsValue element;
  string name;
  JsValue pseudoElement;
}

export JsValue[] animateElements(
  JsValue? elementOrSelector,
  JsValue keyframes,
  JsValue options,
  AnimationScope? scope
) {
  JsValue[] animations = [];
  if (elementOrSelector == null) {
    return animations;
  }
  JsValue[] elements = resolveElements(elementOrSelector, scope);
  int numElements = elements.length;

  /**
   * WAAPI cannot interrupt animations, so starting them is three passes:
   * stop existing animations (write), resolve keyframes (read), then
   * create the new animations (write).
   */
  AnimationDefinition[] animationDefinitions = [];
  for (int i = 0; i < numElements; i++) {
    JsValue element = elements[i];
    JsValue elementTransition = copy(options);
    JsValue delay = elementTransition["delay"];
    if (isFunction(delay)) {
      elementTransition["delay"] = callFn2(delay, i, numElements);
    }
    for (string valueName in keyframes) {
      JsValue valueOptions = spread(
        getValueTransition(elementTransition, valueName),
        object{
          element: element,
          name: valueName,
          allowFlatten: !elementTransition["type"].truthy() && !elementTransition["ease"].truthy()
        }
      );
      JsValue duration = valueOptions["duration"];
      if (duration.truthy()) {
        valueOptions["duration"] = secondsToMilliseconds(asNumber(duration));
      }
      JsValue valueDelay = valueOptions["delay"];
      if (valueDelay.truthy()) {
        valueOptions["delay"] = secondsToMilliseconds(asNumber(valueDelay));
      }
      JsValue pseudoElement = valueOptions["pseudoElement"];
      Map<string, JsValue> map = getAnimationMap(element);
      string key = animationMapKey(
        valueName,
        asString(if (pseudoElement.truthy()) { pseudoElement } else { "" })
      );
      JsValue? currentAnimation = map.get(key);
      if (currentAnimation != null) {
        asStoppable(currentAnimation).stop();
      }
      animationDefinitions.push(AnimationDefinition{
        map,
        key,
        keyframesAsList(keyframes[valueName]),
        valueOptions,
        element,
        valueName,
        pseudoElement
      });
    }
  }

  for (int i = 0; i < animationDefinitions.length; i++) {
    AnimationDefinition definition = animationDefinitions[i];
    JsValue[] unresolvedKeyframes = definition.unresolvedKeyframes;
    bool readInitial = !definition.pseudoElement.truthy();
    if (readInitial && JS.strictEqual(unresolvedKeyframes[0], null)) {
      unresolvedKeyframes[0] = getComputedStyle(definition.element, definition.name);
    }
    fillWildcards(unresolvedKeyframes);
    applyPxDefaults(unresolvedKeyframes, definition.name);
    // In place, as upstream: the caller's keyframe array gains the read value.
    if (readInitial && unresolvedKeyframes.length < 2) {
      JS.invoke(unresolvedKeyframes, "unshift", getComputedStyle(definition.element, definition.name));
    }
    definition.options["keyframes"] = unresolvedKeyframes;
  }

  for (int i = 0; i < animationDefinitions.length; i++) {
    AnimationDefinition definition = animationDefinitions[i];
    NativeAnimation animation = new NativeAnimation(definition.options);
    definition.map.set(definition.key, animation);
    JS.invoke(animation.finished(), "finally", () => {
      definition.map.delete(definition.key);
    });
    animations.push(animation);
  }
  return animations;
}
