import { isSVGElement } from "../../../motion-dom/utils/is-svg-element";
import { isSVGSVGElement } from "../../../motion-dom/utils/is-svg-svg-element";
import { VisualElement } from "../../../motion-dom/render/VisualElement";
import { HTMLVisualElement } from "../../../motion-dom/render/html/HTMLVisualElement";
import { SVGVisualElement } from "../../../motion-dom/render/svg/SVGVisualElement";
import { ObjectVisualElement } from "../../../motion-dom/render/object/ObjectVisualElement";
import { visualElementStore } from "../../../motion-dom/render/store";
import { isCurrentRealmDOMElement } from "../../../motion-dom/dom-host";
import extern { weakMapSet } from "../../../motion-dom/weak-host.ts";

extern void weakMapSet(JsValue map, JsValue key, JsValue value);

VisualElement newVisualElement(JsValue subject) {
  if (!isCurrentRealmDOMElement(subject)) {
    return new ObjectVisualElement(object{
      presenceContext: null,
      props: object{},
      visualState: object{ renderState: object{ output: object{} }, latestValues: object{} }
    });
  }
  JsValue options = object{
    presenceContext: null,
    props: object{},
    visualState: object{
      renderState: object{
        transform: object{},
        transformOrigin: object{},
        style: object{},
        vars: object{},
        attrs: object{}
      },
      latestValues: object{}
    }
  };
  if (isSVGElement(subject) && !isSVGSVGElement(subject)) {
    return new SVGVisualElement(options);
  }
  return new HTMLVisualElement(options);
}

export void createVisualElement(JsValue subject) {
  VisualElement node = newVisualElement(subject);
  node.mount(subject);
  weakMapSet(visualElementStore, subject, node);
}
