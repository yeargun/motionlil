import { wrap } from "./motion-utils/wrap";
import { mixNumber as mix } from "./motion-dom/utils/mix/index";
import { stagger, StaggerOptions } from "./motion-dom/utils/stagger";
import { SpringGenerator, spring, SpringInput } from "./motion-dom/animation/generators/spring";

func(int, int)->float delay = stagger(0.125, new StaggerOptions(0.25));
float position = 0.0;
float phase = 0.0;
float schedule = 0.0;
float springDigest = 0.0;

for (int index = 0; index < 160000; index++) {
  int lane = index % 8;
  float mixed = JS.assume(mix(-120.0, 360.0, lane / 8.0));
  position = position + mixed;
  phase = phase + wrap(0.0, 360.0, index * 47.0);
  schedule = schedule + delay(lane, 8) * 8.0;
}

SpringInput springOptions = new SpringInput([0.0, 100.0]);
springOptions.stiffness = 170.0;
springOptions.damping = 26.0;
springOptions.mass = 1.0;
SpringGenerator springGen = spring(springOptions, JS.undefined());
for (int time = 0; time <= 1024; time = time + 16) {
  float sample = JS.assume(springGen.next(time).value);
  springDigest = springDigest + (sample * 1000.0).round();
}

print(`motion:${position}:${phase}:${schedule}:${springDigest}`);
