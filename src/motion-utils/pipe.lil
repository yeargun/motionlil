// pipe(...transformers): compose left to right, as upstream's transformers.reduce.
export JsValue pipe = JS.staticRest((JsValue transformers) =>
  JS.call(JS.get(JS.array(), "reduce"), transformers, (JsValue a, JsValue b) =>
    (JsValue v) => JS.call(b, JS.undefined(), JS.call(a, JS.undefined(), v))));
