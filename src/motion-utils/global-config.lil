// Upstream's `{}`: every flag is absent until the application sets it.
export extern class MotionGlobalConfigState {
  bool? skipAnimations;
  bool? instantAnimations;
  bool? useManualTiming;
  JsValue? WillChange;
  JsValue? mix;
}

export MotionGlobalConfigState MotionGlobalConfig = JS.assume(JS.object());
