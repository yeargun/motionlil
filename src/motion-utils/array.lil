export void addUniqueItem<T>(T[] arr, T item) {
  if (arr.indexOf(item) == -1) {
    arr.push(item);
  }
}

export void removeItem<T>(T[] arr, T item) {
  int index = arr.indexOf(item);
  if (index > -1) {
    arr.splice(index, 1);
  }
}

export T[] moveItem<T>(T[] input, int fromIndex, int toIndex) {
  T[] arr = [...input];
  int length = arr.length;
  int startIndex = if (fromIndex < 0) { length + fromIndex } else { fromIndex };
  if (startIndex >= 0 && startIndex < length) {
    JS.splice(arr, if (toIndex < 0) { length + toIndex } else { toIndex }, 0.0, arr.splice(fromIndex, 1)[0]);
  }
  return arr;
}
