import { clamp } from "../clamp";

export func(float)->float steps(int numSteps, string direction = "end") {
  return (float progress) => {
    bool end = direction == "end";
    float expanded = if (end) { progress.min(0.999) } else { progress.max(0.001) } * numSteps;
    return clamp(0.0, 1.0, if (end) { expanded.floor() } else { expanded.ceil() } / numSteps);
  };
}
