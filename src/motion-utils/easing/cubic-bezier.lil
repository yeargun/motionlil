import { noop } from "../noop";

float calcBezier(float t, float a1, float a2) {
  return (((1.0 - 3.0 * a2 + 3.0 * a1) * t + (3.0 * a2 - 6.0 * a1)) * t + 3.0 * a1) * t;
}

export func(float, float, float, float)->func(float)->float cubicBezier = (float mX1, float mY1, float mX2, float mY2) => {
  if (mX1 == mY1 && mX2 == mY2) {
    return noop;
  }
  return (float t) => {
    if (t == 0.0 || t == 1.0) {
      return t;
    }
    float lowerBound = 0.0;
    float upperBound = 1.0;
    float currentT = 0.0;
    float i = 0.0;
    while (true) {
      currentT = lowerBound + (upperBound - lowerBound) / 2.0;
      float currentX = calcBezier(currentT, mX1, mX2) - t;
      if (currentX > 0.0) {
        upperBound = currentT;
      } else {
        lowerBound = currentT;
      }
      i = i + 1.0;
      if (currentX.abs() <= 0.0000001 || i >= 12.0) {
        break;
      }
    }
    return calcBezier(currentT, mY1, mY2);
  };
};
