import { addUniqueItem, removeItem } from "./array";

export class SubscriptionManager {
  (func(JsValue?, JsValue?, JsValue?)->void)[] subscriptions;

  init() {
    this.subscriptions = [];
  }

  func()->void add(func(JsValue?, JsValue?, JsValue?)->void handler) {
    addUniqueItem(this.subscriptions, handler);
    return () => {
      removeItem(this.subscriptions, handler);
    };
  }

  void notify(JsValue? a, JsValue? b, JsValue? c) {
    int numSubscriptions = this.subscriptions.length;
    if (numSubscriptions == 0) {
      return;
    }
    if (numSubscriptions == 1) {
      this.subscriptions[0](a, b, c);
    } else {
      for (int i = 0; i < numSubscriptions; i++) {
        if (i < this.subscriptions.length) {
          this.subscriptions[i](a, b, c);
        }
      }
    }
  }

  int getSize() {
    return this.subscriptions.length;
  }

  void clear() {
    JsValue subscriptions = this.subscriptions;
    subscriptions["length"] = 0;
  }
}
